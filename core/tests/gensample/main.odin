	return gk.div(.Size_Full)->text("gensample")
}

main :: proc() {
	app: App
	gk.run_headless(&app, "frame\nframe\n", proc(a: ^App, cx: ^gk.Cx) {
		a.root = gk.view(a, nil, root_view)
		gk.open_window(cx, "gensample", {640, 480}, a.root)
	})
	fmt.printf("gensample: done runs=%d\n", app.runs)
}
