// input: the protocol tests of the input family (docs/PROTOCOLS.md section 9.6): the three
// instantiations of upstream's InputBaseState<M> (Input_State, Editor_State, Textarea_State,
// generated by the `[instantiate] states` rule), Otp_State, their events, reads, buffered
// writes and calls that return a value, and every handler shape the family's elements take.
// Each mode runs offscreen (the diag library) under a gk-meter script and prints lines that
// core/tests/run-input.sh checks, with the exit code.
//
//   GK_PROTO=input | calls | number | otp | paste | released-editor | call-in-view | providers |
//            links
package input_test

import "core:fmt"
import "core:os"
import "core:strconv"
import gk "gpuikit:gk"

App :: struct {
	mode:    string,
	root:    gk.View,
	input:   gk.Input_State,
	text:    gk.Textarea_State,
	editor:  gk.Editor_State,
	number:  gk.Input_State,
	otp:     gk.Otp_State,
	focus:   gk.Focus_Handle,
	subs:    [4]gk.Subscription,
	frame:   int,
	last:    gk.Range,
	events:  int,
	steps:   int,
	pastes:  int,
	gone:    bool, // the editor was released (released-editor)
	asks:    gk.Row_Source, // the editor's providers (providers)
	asked:   int,
}

// --- events -------------------------------------------------------------------------------------

input_event :: proc(a: ^App, cx: ^gk.Cx, e: gk.Input_Event) {
	a.events += 1
	switch v in e {
	case gk.Input_Event_Change:
		fmt.printf("input change value=%q cursor=%d\n", a.input->value(cx), a.input->cursor(cx))
	case gk.Input_Event_Press_Enter:
		fmt.printf("input enter secondary=%v shift=%v value=%q\n", v.secondary, v.shift, a.input->value(cx))
	case gk.Input_Event_Focus:
		fmt.println("input focus")
	case gk.Input_Event_Blur:
		fmt.println("input blur")
	}
}

text_event :: proc(a: ^App, cx: ^gk.Cx, e: gk.Input_Event) {
	if _, ok := e.(gk.Input_Event_Change); ok {
		fmt.printf("textarea change value=%q multi=%v\n", a.text->value(cx), a.text->is_multi_line(cx))
	}
}

editor_event :: proc(a: ^App, cx: ^gk.Cx, e: gk.Input_Event) {
	if _, ok := e.(gk.Input_Event_Change); ok {
		fmt.printf("editor change value=%q code=%v\n", a.editor->value(cx), a.editor->is_code_editor(cx))
	}
}

number_event :: proc(a: ^App, cx: ^gk.Cx, e: gk.Input_Event) {
	if _, ok := e.(gk.Input_Event_Change); ok {
		fmt.printf("number change value=%q\n", a.number->value(cx))
	}
}

otp_event :: proc(a: ^App, cx: ^gk.Cx, e: gk.Otp_Event) {
	fmt.printf("otp event=%v value=%q\n", e, a.otp->value(cx))
}

// The handler shape (StepAction) -> () of base::NumberInput::on_step.
stepped :: proc(a: ^App, cx: ^gk.Cx, e: gk.Step_Action) {
	a.steps += 1
	fmt.printf("number step action=%v n=%d\n", e, a.steps)
	v, _ := strconv.parse_int(string(a.number->value(cx)))
	a.number->set_value(cx, fmt.tprintf("%d", v + (2 if e == .Increment else -2)))
	fmt.printf("number value=%q\n", a.number->value(cx)) // a read sends the write first
}

// The handler shape (ClipboardItem) -> bool of Input::on_paste: false lets the input paste.
pasted :: proc(a: ^App, cx: ^gk.Cx, item: gk.Clipboard_Item) -> bool {
	a.pastes += 1
	text := ""
	for e in item.entries {
		if s, ok := e.(gk.Clipboard_Entry_String); ok {
			text = string(s.v0.text)
		}
	}
	fmt.printf("input paste n=%d entries=%d text=%q\n", a.pastes, len(item.entries), text)
	return false
}

// The editor's providers: every question arrives here, after the editor's own update, and is
// answered at once (it could be later: the menu waits for the answer).
provider :: proc(a: ^App, cx: ^gk.Cx, e: gk.Provider_Event) {
	a.asked += 1
	#partial switch q in e.request { // the other providers are core/tests/lists2's (mode providers)
	case gk.Provider_Completions:
		trigger, _ := q.trigger.?
		fmt.printf("provider completions id=%d offset=%d kind=%d trigger=%q text=%q\n", e.id, q.offset, q.trigger_kind, trigger, q.text)
		items := []gk.Completion_Item{{label = "first", kind = 3, detail = "fn first()"}, {label = "second", kind = 6}}
		gk.answer(cx, a.asks, e.id, gk.Completion_Response{items = items})
	case gk.Provider_Hover:
		fmt.printf("provider hover id=%d offset=%d\n", e.id, q.offset)
		gk.answer(cx, a.asks, e.id, gk.Hover_Response{markdown = "**hover** text"})
	}
}

// The handler shape (&str, &ClickEvent) of TextView::on_link_click (its payload type is named by
// the generator after its shape number), and the click of an InputGroupButton.
link_clicked :: proc(a: ^App, cx: ^gk.Cx, e: gk.Event_83) {
	a.events += 1
	fmt.printf("link clicked url=%q button=%v\n", e.a0, e.a1.button)
}

group_clicked :: proc(a: ^App, cx: ^gk.Cx, e: gk.Click_Event) {
	a.events += 1
	fmt.printf("group button clicked count=%d\n", e.click_count)
}

links_view :: proc(a: ^App, cx: ^gk.Cx) -> gk.Element {
	return gk.v_flex(.Size_Full, .P_4, .Gap_2)->bg(gk.theme(.Background))->text_color(gk.theme(.Foreground))->
		child(gk.div()->w(gk.px(300))->child(gk.text_view_markdown("md", "see [the link](https://example.com/x) here")->on_link_click(gk.on(link_clicked))))->
		child(gk.div()->w(gk.px(300))->child(gk.input_group("g")->input(gk.input(a.input))->
			addon(gk.input_group_addon("a")->child(gk.input_group_button("go")->label("Go")->on_click(gk.on(group_clicked))))))
}

focus_away :: proc(a: ^App, cx: ^gk.Cx, e: gk.Mouse_Event) {
	gk.focus(cx, a.focus)
}

// The selection is not an event upstream: a frame handler reports it when it changes.
watch :: proc(a: ^App, cx: ^gk.Cx) {
	a.frame += 1
	r := a.input->selected_range(cx)
	if r != a.last {
		a.last = r
		fmt.printf("input selection lo=%d hi=%d text=%q reversed=%v\n", r.lo, r.hi, a.input->selected_value(cx), a.input->is_selection_reversed(cx))
	}
}

// --- calls: reads, buffered writes, updates that return a value -----------------------------------

calls :: proc(a: ^App, cx: ^gk.Cx) {
	a.frame += 1
	if a.frame == 3 {
		fmt.printf("calls lease later value=%q\n", a.input->value(cx))
	}
	if a.frame != 2 {
		return
	}
	// Input_State: a write is buffered; a read sends it first, so it sees it.
	a.input->set_value(cx, "abc def")
	a.input->set_selected_range(cx, {0, 3})
	r := a.input->selected_range(cx)
	fmt.printf("calls input value=%q selected=%d..%d text=%q single=%v multi=%v\n",
		a.input->value(cx), r.lo, r.hi, a.input->selected_value(cx), a.input->is_single_line(cx), a.input->is_multi_line(cx))
	a.input->insert(cx, "X") // at the cursor, the end of the selection
	fmt.printf("calls input insert value=%q cursor=%d\n", a.input->value(cx), a.input->cursor(cx))
	a.input->set_selected_range(cx, {0, 3})
	a.input->replace(cx, "Y") // the selection
	fmt.printf("calls input replace value=%q cursor=%d\n", a.input->value(cx), a.input->cursor(cx))
	a.input->select_all(cx)
	r = a.input->selected_range(cx)
	fmt.printf("calls input select_all %d..%d\n", r.lo, r.hi)
	a.input->set_disabled(cx, true)
	fmt.printf("calls input editable=%v\n", a.input->is_editable(cx))
	a.input->set_disabled(cx, false)

	// Textarea_State: multi-line, searchable; search calls return a value at once.
	a.text->set_value(cx, "one two\none three")
	fmt.printf("calls textarea multi=%v single=%v value=%q\n", a.text->is_multi_line(cx), a.text->is_single_line(cx), a.text->value(cx))
	a.text->set_search_query(cx, "one", false)
	m := a.text->next_search_match(cx)
	if mr, ok := m.?; ok {
		fmt.printf("calls textarea next_match %d..%d\n", mr.lo, mr.hi)
	} else {
		fmt.println("calls textarea next_match none")
	}
	n := a.text->replace_all_search_matches(cx, "1")
	fmt.printf("calls textarea replaced=%d value=%q\n", n, a.text->value(cx))

	// Editor_State: the code editor mode, without grammars.
	a.editor->set_line_number(cx, true)
	a.editor->set_value(cx, "fn main() {\n    let x = 1;\n}\n")
	fmt.printf("calls editor code=%v multi=%v language=%q value=%q\n",
		a.editor->is_code_editor(cx), a.editor->is_multi_line(cx), a.editor->language_name(cx), a.editor->value(cx))

	// A read of a state on lease reports busy through try_; a write from there lands later.
	inside := gk.handler(proc(a: ^App, cx: ^gk.Cx) -> bool {
		_, ok := a.input->try_value(cx)
		fmt.printf("calls lease busy=%v\n", !ok)
		a.input->set_value(cx, "after the lease")
		return true
	})
	ret := gk.test_fire_in_update(cx, a.input, inside)
	fmt.printf("calls lease ret=%d value=%q\n", ret, a.input->value(cx))
	fmt.println("calls done")
}

// --- the view -----------------------------------------------------------------------------------

init :: proc(a: ^App, cx: ^gk.Cx) {
	a.input = gk.input_state(cx)->placeholder("Name")->build()
	a.text = gk.textarea_state(cx)->auto_grow(2, 4)->searchable(true)->build()
	a.editor = gk.editor_state(cx)->language("rust")->build()
	a.number = gk.input_state(cx)->min(0)->max(10)->step(f64(2))->default_value("4")->build()
	a.otp = gk.otp_state(cx, 4)->build()
	a.focus = gk.focus_handle(cx)
	a.subs[0] = a.input->on_input_event(cx, gk.on(input_event))
	a.subs[1] = a.text->on_input_event(cx, gk.on(text_event))
	a.subs[2] = a.editor->on_input_event(cx, gk.on(editor_event))
	a.subs[3] = a.number->on_input_event(cx, gk.on(number_event))
	a.otp->on_otp_event(cx, gk.on(otp_event))
	switch a.mode {
	case "input", "paste":
		gk.on_frame(cx, watch)
	case "calls":
		gk.on_frame(cx, calls)
	case "providers":
		a.asks = gk.editor_providers(cx, a.editor, a, provider, triggers = ".")
	case "released-editor":
		gk.on_frame(cx, proc(a: ^App, cx: ^gk.Cx) {
			a.frame += 1
			if a.frame == 2 {
				gk.release(cx, a.editor) // the view below still shows it
				fmt.println("input released-editor released")
			}
		})
	}
}

root_view :: proc(a: ^App, cx: ^gk.Cx) -> gk.Element {
	if a.mode == "call-in-view" {
		a.text->replace_all_search_matches(cx, "x") // a view may not update kit state
	}
	input := gk.input(a.input)
	if a.mode == "paste" {
		input->on_paste(gk.on(pasted))
	}
	// The styled editor (with the providers' menus) in mode providers, the generated base::Editor
	// otherwise.
	editor: gk.Element
	if a.mode == "providers" {
		editor = gk.code_editor(a.editor, height = 90)
	} else {
		editor = gk.editor(a.editor)
	}
	// base::NumberInput: its buttons call on_step, which replaces upstream's own stepping, so
	// the handler steps the value itself.
	number := gk.base_number_input(a.number)->input(gk.base_input(a.number))->on_step(gk.on(stepped))
	return gk.v_flex(.Size_Full, .P_4, .Gap_2)->bg(gk.theme(.Background))->text_color(gk.theme(.Foreground))->
		child(gk.div()->w(gk.px(240))->child(input))->
		child(gk.div()->w(gk.px(240))->child(gk.textarea(a.text)))->
		child(gk.div()->w(gk.px(400))->h(gk.px(90))->child(editor))->
		child(gk.div()->w(gk.px(200))->child(number))->
		child(gk.otp_input(a.otp))->
		child(gk.div()->w(gk.px(120))->h(gk.px(24))->bg(gk.hsla(0.6, 0.5, 0.4, 1))->track_focus(a.focus)->
			on_mouse_down(gk.Mouse_Button_Left{}, gk.on(focus_away)))
}

start :: proc(a: ^App, cx: ^gk.Cx) {
	a.root = gk.view(a, init, links_view if a.mode == "links" else root_view)
	gk.open_window(cx, "input", {640, 480}, a.root)
}

// Positions in the 640 x 480 window, from a shot of the first frame (GK_SHOT=1 writes it):
// the input at y 16..48, the textarea 56..114, the editor 122..212, the number input 220..252
// (base::NumberInput: its buttons have no content without the decorate closures, which are not
// bound, so up and down step it), the OTP boxes 260..292 from x 242, the block 300..324.
INPUT :: "click 60 32\n"
AWAY :: "click 60 312\n"
NUMBER :: "click 20 232\n" // the base number input's text: up and down step it
OTP :: "click 258 276\n"
EDITOR :: "click 200 150\n"
LINK :: "click 70 26\n" // mode links: the link's text, then the input group's button
GROUP_BUTTON :: "click 41 66\n"

main :: proc() {
	app: App
	app.mode, _ = os.lookup_env("GK_PROTO", context.allocator)
	script := "size 640 480\nframe\n"
	if _, shot := os.lookup_env("GK_SHOT", context.allocator); shot {
		script = fmt.aprint(script, "shot input-", app.mode, ".png\n", sep = "")
	}
	switch app.mode {
	case "input":
		// focus, typing, select all, copy, move to the end, paste, undo, redo, enter, blur
		script = fmt.aprint(script, INPUT, "type hello\n", "key ctrl-a\n", "key ctrl-c\n", "key end\n", "key ctrl-v\n",
			"key ctrl-z\n", "key ctrl-y\n", "key shift-left\n", "key shift-left\n", "key enter\n", AWAY, "frame\nstat\n", sep = "")
	case "paste":
		script = fmt.aprint(script, INPUT, "type ab\n", "key ctrl-a\n", "key ctrl-c\n", "key end\n", "key ctrl-v\n", "frame\nstat\n", sep = "")
	case "calls", "released-editor", "call-in-view":
		script = fmt.aprint(script, "frame\nframe\nframe\nstat\n", sep = "")
	case "number", "step-shape":
		script = fmt.aprint(script, NUMBER, "key up\n", "key up\n", "key down\n", "frame\nstat\n", sep = "")
	case "providers":
		// a completion asked by the trigger character, answered, the first item taken by
		// enter; then the pointer rests on the text for the hover
		_, want_shot := os.lookup_env("GK_SHOT", context.allocator)
		shot := "shot input-providers.png\n" if want_shot else ""
		script = fmt.aprint(script, EDITOR, "type a.\n", "frame\n", shot, "key enter\n", "move 40 135\n", "sleep 800\nframe\nsleep 300\nframe\n", "frame\nstat\n", sep = "")
	case "links":
		script = fmt.aprint(script, LINK, GROUP_BUTTON, "frame\nstat\n", sep = "")
	case "otp":
		script = fmt.aprint(script, OTP, "type 1234\n", AWAY, "frame\nstat\n", sep = "")
	}
	gk.run_headless(&app, script, start)
	fmt.printf("input done mode=%s events=%d steps=%d pastes=%d frame=%d asked=%d\n", app.mode, app.events, app.steps, app.pastes, app.frame, app.asked)
}
