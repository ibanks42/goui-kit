noop :: proc(a: ^App, cx: ^gk.Cx) {}
// fits every shape: a handler without a payload parameter
any_event :: proc(a: ^App, cx: ^gk.Cx) {a.events += 1}

got :: proc(a: ^App, b: []u8) {
	a.got = bytes.clone(b)
	a.fired = true
}

hex :: proc(b: []u8) -> string {
	return fmt.tprintf("%x", b)
}

try_shape :: proc(a: ^App, cx: ^gk.Cx, num: u16, name: string, h: gk.Handler, payload: []u8, want_typed: bool, want_ret: []u8) {
	a.got, a.fired = nil, false
	typed, ret := gk.test_fire_shape(cx, h, num, payload)
	ok := a.fired && bytes.equal(a.got, payload) && bytes.equal(ret, want_ret) && typed == want_typed
	fmt.printf("shape %d %s %s %s\n", num, "typed" if typed else "raw", "ok" if ok else "FAIL", name)
	if ok {
		a.ok += 1
	} else {
		a.failed += 1
		fmt.printf("  fired=%v sent=%s got=%s ret=%s want_ret=%s typed=%v want_typed=%v\n", a.fired, hex(payload), hex(a.got), hex(ret), hex(want_ret), typed, want_typed)
	}
	if typed {
		a.typed += 1
	}
}

