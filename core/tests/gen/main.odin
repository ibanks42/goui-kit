	gk.release(cx, a.st_panel_registry)
	_ = gk.path_cache_is_warm(a.st_path_cache, cx)
	gk.release(cx, a.st_path_cache)
	gk.release(cx, a.st_path_caches)
	_ = gk.pie_arcs(a.st_pie, cx, gk.data(SAMPLE_ROWS[:]))
	gk.release(cx, a.st_pie)
	_ = gk.plot_appear_is_appearing(a.st_plot_appear, cx)
	gk.release(cx, a.st_plot_appear)
	_ = gk.popover_state_is_open(a.st_popover_state, cx)
	gk.release(cx, a.st_popover_state)
	_ = gk.questionnaire_answers_get(a.st_questionnaire_answers, cx, "s")
	gk.release(cx, a.st_questionnaire_answers)
	_ = gk.questionnaire_navigation_state_is_confirmable(a.st_questionnaire_navigation_state, cx)
	gk.release(cx, a.st_questionnaire_navigation_state)
	_ = gk.questionnaire_submission_answer(a.st_questionnaire_submission, cx, "s")
	gk.release(cx, a.st_questionnaire_submission)
	_ = gk.range_highlight_background(a.st_range_highlight, cx)
	gk.release(cx, a.st_range_highlight)
	_ = gk.resizable_state_container_size(a.st_resizable_state, cx)
	gk.release(cx, a.st_resizable_state)
	_ = gk.sankey_graph_layer_count(a.st_sankey_graph, cx)
	gk.release(cx, a.st_sankey_graph)
	_ = gk.scale_band_band_width(a.st_scale_band, cx)
	gk.release(cx, a.st_scale_band)
	_ = gk.scale_linear_nearest_index(a.st_scale_linear, cx, 1.5)
	gk.release(cx, a.st_scale_linear)
	_ = gk.scale_ordinal_map(a.st_scale_ordinal, cx, "s")
	gk.release(cx, a.st_scale_ordinal)
	_ = gk.scale_point_nearest_index(a.st_scale_point, cx, 1.5)
	gk.release(cx, a.st_scale_point)
	_ = gk.scroll_handle_content_size(a.st_scroll_handle, cx)
	gk.release(cx, a.st_scroll_handle)
	_ = gk.search_matcher_current(a.st_search_matcher, cx)
	gk.release(cx, a.st_search_matcher)
	_ = gk.search_session_is_active(a.st_search_session, cx)
	gk.release(cx, a.st_search_session)
	_ = gk.sequence_from(a.st_sequence, cx)
	gk.release(cx, a.st_sequence)
	_ = gk.shape_key_finish(a.st_shape_key, cx)
	gk.release(cx, a.st_shape_key)
	_ = gk.slider_state_accessibility_step(a.st_slider_state, cx)
	gk.release(cx, a.st_slider_state)
	_ = gk.speech_state_has_recognizer(a.st_speech_state, cx)
	gk.release(cx, a.st_speech_state)
	_ = gk.stack_series(a.st_stack, cx)
	gk.release(cx, a.st_stack)
	_ = gk.stagger_delay(a.st_stagger, cx, 3, 3)
	gk.release(cx, a.st_stagger)
	_ = gk.status_colors_created(a.st_status_colors, cx)
	gk.release(cx, a.st_status_colors)
	_ = gk.syntax_colors_style(a.st_syntax_colors, cx, "s")
	gk.release(cx, a.st_syntax_colors)
	_ = gk.syntax_highlighter_language(a.st_syntax_highlighter, cx)
	gk.release(cx, a.st_syntax_highlighter)
	_ = gk.table_visible_range_cols(a.st_table_visible_range, cx)
	gk.release(cx, a.st_table_visible_range)
	_ = gk.text_selection_handle_has_local_selection(a.st_text_selection_handle, cx)
	gk.release(cx, a.st_text_selection_handle)
	gk.release(cx, a.st_text_selection_projection)
	_ = gk.text_view_defaults_has_code_block_highlighter(a.st_text_view_defaults, cx)
	gk.release(cx, a.st_text_view_defaults)
	_ = gk.text_view_state_is_clamped(a.st_text_view_state, cx)
	gk.release(cx, a.st_text_view_state)
	_ = gk.textarea_state_content(a.st_textarea_state, cx)
	gk.release(cx, a.st_textarea_state)
	_ = gk.time_field_state_selected_segment(a.st_time_field_state, cx)
	gk.release(cx, a.st_time_field_state)
	_ = gk.toast_manager_get(a.st_toast_manager, cx, 3)
	gk.release(cx, a.st_toast_manager)
	_ = gk.toast_stack_state_is_expanded(a.st_toast_stack_state, cx)
	gk.release(cx, a.st_toast_stack_state)
	_ = gk.tooltip_defaults_grace_period(a.st_tooltip_defaults, cx)
	gk.release(cx, a.st_tooltip_defaults)
	gk.release(cx, a.st_tooltip_overlay)
	gk.release(cx, a.st_transition_state)
	_ = gk.tree_state_entry(a.st_tree_state, cx, 3)
	gk.release(cx, a.st_tree_state)
	_ = gk.undo_history_can_redo(a.st_undo_history, cx)
	gk.release(cx, a.st_undo_history)
	_ = gk.virtual_list_scroll_handle_base_handle(a.st_virtual_list_scroll_handle, cx)
	gk.release(cx, a.st_virtual_list_scroll_handle)
	for sub in a.subs {
		gk.release(cx, sub)
	}
	fmt.printf("states released n=76 subscriptions=%d\n", len(a.subs))
}

clicked :: proc(a: ^App, cx: ^gk.Cx) {
	a.clicks += 1
	switch a.mode {
	case "shapes":
		if a.clicks == 1 {
			run_shapes(a, cx)
		}
	case "states":
		switch a.clicks {
		case 1:
			make_states(a, cx)
		case 2:
			release_states(a, cx)
		}
	}
}

root_view :: proc(a: ^App, cx: ^gk.Cx) -> gk.Element {
	return gk.div(.Size_Full)->id("all")->on_click(gk.on(clicked))->text("gen")
}

main :: proc() {
	app: App
	app.mode, _ = os.lookup_env("GK_PROTO", context.allocator)
	script := "size 320 200\nframe\nclick 100 100\nframe\nframe\nclick 100 100\nframe\nframe\nstat\n"
	gk.run_headless(&app, script, proc(a: ^App, cx: ^gk.Cx) {
		a.root = gk.view(a, nil, root_view)
		gk.open_window(cx, "gen", {320, 200}, a.root)
	})
	fmt.printf("gen done mode=%s clicks=%d ok=%d failed=%d events=%d\n", app.mode, app.clicks, app.ok, app.failed, app.events)
}
