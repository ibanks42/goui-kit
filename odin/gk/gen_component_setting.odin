}

// Create a new settings with the given ID.
settings :: proc(id: Id, loc := #caller_location) -> Settings {
	use_component_setting()
	e := Settings{new_node(748, loc), &settings_vt}
	o := node_args()
	put_id(o, id)
	return e
}

@(private)
settings_vt := Settings_VT {
	t_sizable = cast(^Sizable_Trait(Settings))&sizable_any,
	default_selected_index = proc(e: Settings, index: Select_Index) -> Settings {
		o := op(e.el, 256)
		put_Select_Index(o, index)
		return e
	},
	header_style = proc(e: Settings, style: Style_Refinement) -> Settings {
		o := op(e.el, 257)
		put_u32(o, take_value(style.nd))
		return e
	},
	page = proc(e: Settings, page: Setting_Page) -> Settings {
		o := op(e.el, 258)
		put_u32(o, take_value(page.nd))
		return e
	},
	pages = proc(e: Settings, pages: []Setting_Page) -> Settings {
		o := op(e.el, 259)
		put_u32(o, u32(len(pages)))
		for x0 in pages {
			put_u32(o, take_value(x0.nd))
		}
		return e
	},
	sidebar_size_range = proc(e: Settings, range: [2]f32) -> Settings {
		o := op(e.el, 263)
		put_f32(o, range[0])
		put_f32(o, range[1])
		return e
	},
	sidebar_style = proc(e: Settings, style: Style_Refinement) -> Settings {
		o := op(e.el, 260)
		put_u32(o, take_value(style.nd))
		return e
	},
	sidebar_width = proc(e: Settings, width: f32) -> Settings {
		o := op(e.el, 261)
		put_f32(o, width)
		return e
	},
	with_group_variant = proc(e: Settings, variant: Group_Box_Variant) -> Settings {
		o := op(e.el, 262)
		put_u16(o, u16(variant))
		return e
	},
}

