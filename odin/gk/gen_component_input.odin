	text_bg = transmute(proc(e: Textarea, bg: Color) -> Textarea)styled_text_bg,
	text_color = transmute(proc(e: Textarea, color: Color) -> Textarea)styled_text_color,
	text_decoration_color = transmute(proc(e: Textarea, color: Color) -> Textarea)styled_text_decoration_color,
	text_overflow = transmute(proc(e: Textarea, overflow: Text_Overflow) -> Textarea)styled_text_overflow,
	text_size = transmute(proc(e: Textarea, size: Length) -> Textarea)styled_text_size,
	top = transmute(proc(e: Textarea, length: Length) -> Textarea)styled_top,
	w = transmute(proc(e: Textarea, length: Length) -> Textarea)styled_w,
	style = transmute(proc(e: Textarea, flags: ..Style_Flag) -> Textarea)rt_style,
	accessibility_id = proc(e: Textarea, id: string) -> Textarea {
		o := op(e.el, 256)
		put_str(o, id)
		return e
	},
	appearance = proc(e: Textarea, appearance: bool) -> Textarea {
		o := op(e.el, 257)
		put_u8(o, u8(appearance))
		return e
	},
	aria_label = proc(e: Textarea, label: string) -> Textarea {
		o := op(e.el, 258)
		put_str(o, label)
		return e
	},
	bordered = proc(e: Textarea, bordered: bool) -> Textarea {
		o := op(e.el, 259)
		put_u8(o, u8(bordered))
		return e
	},
	context_menu = proc(e: Textarea, f: Native_Menu) -> Textarea {
		o := op(e.el, 260)
		put_u32(o, take_value(f.nd))
		return e
	},
	disabled = proc(e: Textarea, disabled: bool) -> Textarea {
		o := op(e.el, 261)
		put_u8(o, u8(disabled))
		return e
	},
	h = proc(e: Textarea, height: Length) -> Textarea {
		o := op(e.el, 262)
		put_definite_length(o, height)
		return e
	},
	on_paste = proc(e: Textarea, handler: Handler) -> Textarea {
		o := op(e.el, 263)
		put_u32(o, register(handler, 76))
		return e
	},
	on_token_click = proc(e: Textarea, listener: Handler) -> Textarea {
		o := op(e.el, 267)
		put_u32(o, register(listener, 106))
		return e
	},
	on_token_hover = proc(e: Textarea, listener: Handler) -> Textarea {
		o := op(e.el, 268)
		put_u32(o, register(listener, 107))
		return e
	},
	readonly = proc(e: Textarea, readonly: bool) -> Textarea {
		o := op(e.el, 264)
		put_u8(o, u8(readonly))
		return e
	},
	role = proc(e: Textarea, role: Role_Override) -> Textarea {
		o := op(e.el, 265)
		put_Role_Override(o, role)
		return e
	},
	tab_index = proc(e: Textarea, index: int) -> Textarea {
		o := op(e.el, 266)
		put_u64(o, u64(index))
		return e
	},
	token = proc(e: Textarea, render: Row_Source) -> Textarea {
		o := op(e.el, 269)
		put_u64(o, items_check(render, 3))
		return e
	},
}

