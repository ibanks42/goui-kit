		return e
	},
	suffix = proc(e: Number_Input, suffix: Element) -> Number_Input {
		o := op(e.el, 260)
		put_u32(o, take(suffix))
		return e
	},
}

// A One Time Password (OTP) input element.
//
// This can accept a fixed length number and can be masked.
//
// Use case example:
// - SMS OTP
// - Authenticator OTP
//
// Otp_Input is gpui_kit::component::input::OtpInput.
Otp_Input :: struct {
	using el: Element,
	using vt: ^Otp_Input_VT,
}

Otp_Input_VT :: struct {
	using t_disableable: ^Disableable_Trait(Otp_Input),
	using t_focusable_ext: ^Focusable_Ext_Trait(Otp_Input),
	using t_sizable: ^Sizable_Trait(Otp_Input),
	// Set number of groups in the OTP Input.
	groups: proc(e: Otp_Input, n_: int) -> Otp_Input,
}

// Create a new `Otp_Input` element bind to the `OtpState`.
otp_input :: proc(state: Otp_State, loc := #caller_location) -> Otp_Input {
	use_component_input()
	e := Otp_Input{new_node(682, loc), &otp_input_vt}
	o := node_args()
	put_u64(o, state.h)
	return e
}

@(private)
otp_input_vt := Otp_Input_VT {
	t_disableable = cast(^Disableable_Trait(Otp_Input))&disableable_any,
	t_focusable_ext = cast(^Focusable_Ext_Trait(Otp_Input))&focusable_ext_any,
	t_sizable = cast(^Sizable_Trait(Otp_Input))&sizable_any,
	groups = proc(e: Otp_Input, n_: int) -> Otp_Input {
		o := op(e.el, 256)
		put_usize(o, n_)
		return e
	},
}

// A styled ordinary multi-line text field.
//
// Textarea is gpui_kit::component::input::Textarea.
Textarea :: struct {
	using el: Element,
	using vt: ^Textarea_VT,
}

Textarea_VT :: struct {
	using t_theme_styled: ^Theme_Styled_Trait(Textarea),
	using t_styled_ext: ^Styled_Ext_Trait(Textarea),
	using t_sizable: ^Sizable_Trait(Textarea),
	aspect_ratio: proc(e: Textarea, ratio: f32) -> Textarea,
	bg: proc(e: Textarea, fill: Fill) -> Textarea,
	border: proc(e: Textarea, length: Length) -> Textarea,
	border_b: proc(e: Textarea, length: Length) -> Textarea,
	border_color: proc(e: Textarea, border_color: Color) -> Textarea,
	border_l: proc(e: Textarea, length: Length) -> Textarea,
	border_r: proc(e: Textarea, length: Length) -> Textarea,
	border_t: proc(e: Textarea, length: Length) -> Textarea,
	border_x: proc(e: Textarea, length: Length) -> Textarea,
	border_y: proc(e: Textarea, length: Length) -> Textarea,
	bottom: proc(e: Textarea, length: Length) -> Textarea,
	col_end: proc(e: Textarea, end: i16) -> Textarea,
	col_span: proc(e: Textarea, span: u16) -> Textarea,
	col_start: proc(e: Textarea, start: i16) -> Textarea,
	cursor: proc(e: Textarea, cursor: Cursor_Style) -> Textarea,
	flex_basis: proc(e: Textarea, basis: Length) -> Textarea,
	flex_grow: proc(e: Textarea, grow: f32) -> Textarea,
	flex_shrink: proc(e: Textarea, shrink: f32) -> Textarea,
	font: proc(e: Textarea, font: Font) -> Textarea,
	font_family: proc(e: Textarea, family_name: string) -> Textarea,
	font_features: proc(e: Textarea, features: Font_Features) -> Textarea,
	font_weight: proc(e: Textarea, weight: Font_Weight) -> Textarea,
	gap: proc(e: Textarea, length: Length) -> Textarea,
	gap_x: proc(e: Textarea, length: Length) -> Textarea,
	gap_y: proc(e: Textarea, length: Length) -> Textarea,
	grid_cols: proc(e: Textarea, cols: u16) -> Textarea,
	grid_cols_max_content: proc(e: Textarea, cols: u16) -> Textarea,
	grid_cols_min_content: proc(e: Textarea, cols: u16) -> Textarea,
	grid_rows: proc(e: Textarea, rows: u16) -> Textarea,
	grid_rows_max_content: proc(e: Textarea, rows: u16) -> Textarea,
	grid_rows_min_content: proc(e: Textarea, rows: u16) -> Textarea,
	inset: proc(e: Textarea, length: Length) -> Textarea,
	left: proc(e: Textarea, length: Length) -> Textarea,
	line_clamp: proc(e: Textarea, lines: int) -> Textarea,
	line_height: proc(e: Textarea, line_height: Length) -> Textarea,
	m: proc(e: Textarea, length: Length) -> Textarea,
	max_h: proc(e: Textarea, length: Length) -> Textarea,
	max_size: proc(e: Textarea, length: Length) -> Textarea,
	max_w: proc(e: Textarea, length: Length) -> Textarea,
	mb: proc(e: Textarea, length: Length) -> Textarea,
	min_h: proc(e: Textarea, length: Length) -> Textarea,
	min_size: proc(e: Textarea, length: Length) -> Textarea,
	min_w: proc(e: Textarea, length: Length) -> Textarea,
	ml: proc(e: Textarea, length: Length) -> Textarea,
	mr: proc(e: Textarea, length: Length) -> Textarea,
	mt: proc(e: Textarea, length: Length) -> Textarea,
	mx: proc(e: Textarea, length: Length) -> Textarea,
	my: proc(e: Textarea, length: Length) -> Textarea,
	opacity: proc(e: Textarea, opacity: f32) -> Textarea,
	p: proc(e: Textarea, length: Length) -> Textarea,
	pb: proc(e: Textarea, length: Length) -> Textarea,
	pl: proc(e: Textarea, length: Length) -> Textarea,
	pr: proc(e: Textarea, length: Length) -> Textarea,
	pt: proc(e: Textarea, length: Length) -> Textarea,
	px: proc(e: Textarea, length: Length) -> Textarea,
	py: proc(e: Textarea, length: Length) -> Textarea,
	right: proc(e: Textarea, length: Length) -> Textarea,
	rounded: proc(e: Textarea, length: Length) -> Textarea,
	rounded_b: proc(e: Textarea, length: Length) -> Textarea,
	rounded_bl: proc(e: Textarea, length: Length) -> Textarea,
	rounded_br: proc(e: Textarea, length: Length) -> Textarea,
	rounded_l: proc(e: Textarea, length: Length) -> Textarea,
	rounded_r: proc(e: Textarea, length: Length) -> Textarea,
	rounded_t: proc(e: Textarea, length: Length) -> Textarea,
	rounded_tl: proc(e: Textarea, length: Length) -> Textarea,
	rounded_tr: proc(e: Textarea, length: Length) -> Textarea,
	row_end: proc(e: Textarea, end: i16) -> Textarea,
	row_span: proc(e: Textarea, span: u16) -> Textarea,
	row_start: proc(e: Textarea, start: i16) -> Textarea,
	scrollbar_width: proc(e: Textarea, width: Length) -> Textarea,
	shadow: proc(e: Textarea, shadows: []Box_Shadow) -> Textarea,
	size: proc(e: Textarea, length: Length) -> Textarea,
	text_align: proc(e: Textarea, align: Text_Align) -> Textarea,
	text_bg: proc(e: Textarea, bg: Color) -> Textarea,
	text_color: proc(e: Textarea, color: Color) -> Textarea,
	text_decoration_color: proc(e: Textarea, color: Color) -> Textarea,
	text_overflow: proc(e: Textarea, overflow: Text_Overflow) -> Textarea,
	text_size: proc(e: Textarea, size: Length) -> Textarea,
	top: proc(e: Textarea, length: Length) -> Textarea,
	w: proc(e: Textarea, length: Length) -> Textarea,
	style: proc(e: Textarea, flags: ..Style_Flag) -> Textarea,
	// Set the developer-assigned accessibility identifier.
	accessibility_id: proc(e: Textarea, id: string) -> Textarea,
	appearance: proc(e: Textarea, appearance: bool) -> Textarea,
	aria_label: proc(e: Textarea, label: string) -> Textarea,
	bordered: proc(e: Textarea, bordered: bool) -> Textarea,
	// Replace the built-in context menu shown on right-click.
	//
	// The closure receives an empty menu and returns the one to show, so it decides entirely what
	// appears — the default items are not added. It shows only while the state's context menu is
	// enabled, which is the default.
	context_menu: proc(e: Textarea, f: Native_Menu) -> Textarea,
	disabled: proc(e: Textarea, disabled: bool) -> Textarea,
	h: proc(e: Textarea, height: Length) -> Textarea,
	// Intercept paste payloads (images, files) before the default text insertion.
	//
	// `true` consumes the paste so nothing is inserted, `false` falls through to `clipboard.text()`.
	// Copied files arrive as `ExternalPaths` through the same hook. On web the clipboard reads `None`;
	// image paste needs async clipboard access and is out of scope.
	on_paste: proc(e: Textarea, handler: Handler) -> Textarea,
	// Open a reference after a completed, unconsumed token click.
	on_token_click: proc(e: Textarea, listener: Handler) -> Textarea,
	// Report pointer presence over a token so the application can show a tooltip or run custom logic.
	// Hover never selects or edits.
	on_token_hover: proc(e: Textarea, listener: Handler) -> Textarea,
	// Set the textarea to read-only, default is `false`.
	//
	// Unlike `->disabled`, a read-only textarea keeps the normal appearance and still can be focused,
	// selected and copied, it only rejects the changes made by the user.
	readonly: proc(e: Textarea, readonly: bool) -> Textarea,
	role: proc(e: Textarea, role: Role_Override) -> Textarea,
	tab_index: proc(e: Textarea, index: int) -> Textarea,
	// The element each atomic inline token renders as, in place of the default `Input_Token`; editing
	// and history stay with the input.
	token: proc(e: Textarea, render: Row_Source) -> Textarea, // gk.items(cx, state, proc(s: ^S, cx: ^Cx, inline_token_context: Inline_Token_Context) -> Element)
}

textarea :: proc(state: Textarea_State, flags: ..Style_Flag, loc := #caller_location) -> Textarea {
	use_component_input()
	e := Textarea{new_node(683, loc), &textarea_vt}
	o := node_args()
	put_u64(o, state.h)
	tokens(e.el, flags)
	return e
}

@(private)
textarea_vt := Textarea_VT {
	t_theme_styled = cast(^Theme_Styled_Trait(Textarea))&theme_styled_any,
	t_styled_ext = cast(^Styled_Ext_Trait(Textarea))&styled_ext_any,
	t_sizable = cast(^Sizable_Trait(Textarea))&sizable_any,
	aspect_ratio = transmute(proc(e: Textarea, ratio: f32) -> Textarea)styled_aspect_ratio,
	bg = transmute(proc(e: Textarea, fill: Fill) -> Textarea)styled_bg,
	border = transmute(proc(e: Textarea, length: Length) -> Textarea)styled_border,
