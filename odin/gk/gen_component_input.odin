	flex_grow = transmute(proc(e: Textarea, grow: f32) -> Textarea)styled_flex_grow,
	flex_shrink = transmute(proc(e: Textarea, shrink: f32) -> Textarea)styled_flex_shrink,
	font = transmute(proc(e: Textarea, font: Font) -> Textarea)styled_font,
	font_family = transmute(proc(e: Textarea, family_name: string) -> Textarea)styled_font_family,
	font_features = transmute(proc(e: Textarea, features: Font_Features) -> Textarea)styled_font_features,
	font_weight = transmute(proc(e: Textarea, weight: Font_Weight) -> Textarea)styled_font_weight,
	gap = transmute(proc(e: Textarea, length: Length) -> Textarea)styled_gap,
	gap_x = transmute(proc(e: Textarea, length: Length) -> Textarea)styled_gap_x,
	gap_y = transmute(proc(e: Textarea, length: Length) -> Textarea)styled_gap_y,
	grid_cols = transmute(proc(e: Textarea, cols: u16) -> Textarea)styled_grid_cols,
	grid_cols_max_content = transmute(proc(e: Textarea, cols: u16) -> Textarea)styled_grid_cols_max_content,
	grid_cols_min_content = transmute(proc(e: Textarea, cols: u16) -> Textarea)styled_grid_cols_min_content,
