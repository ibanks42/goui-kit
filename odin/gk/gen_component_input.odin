	m = transmute(proc(e: Textarea, length: Length) -> Textarea)styled_m,
	max_h = transmute(proc(e: Textarea, length: Length) -> Textarea)styled_max_h,
	max_size = transmute(proc(e: Textarea, length: Length) -> Textarea)styled_max_size,
	max_w = transmute(proc(e: Textarea, length: Length) -> Textarea)styled_max_w,
	mb = transmute(proc(e: Textarea, length: Length) -> Textarea)styled_mb,
	min_h = transmute(proc(e: Textarea, length: Length) -> Textarea)styled_min_h,
	min_size = transmute(proc(e: Textarea, length: Length) -> Textarea)styled_min_size,
	min_w = transmute(proc(e: Textarea, length: Length) -> Textarea)styled_min_w,
	ml = transmute(proc(e: Textarea, length: Length) -> Textarea)styled_ml,
