	grid_rows_max_content = transmute(proc(e: Textarea, rows: u16) -> Textarea)styled_grid_rows_max_content,
	grid_rows_min_content = transmute(proc(e: Textarea, rows: u16) -> Textarea)styled_grid_rows_min_content,
	inset = transmute(proc(e: Textarea, length: Length) -> Textarea)styled_inset,
	left = transmute(proc(e: Textarea, length: Length) -> Textarea)styled_left,
