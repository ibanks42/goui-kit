	on_key_down: proc(e: Base_Button, listener: Handler) -> Base_Button,
	on_key_up: proc(e: Base_Button, listener: Handler) -> Base_Button,
	on_modifiers_changed: proc(e: Base_Button, listener: Handler) -> Base_Button,
	on_mouse_down: proc(e: Base_Button, button: Mouse_Button, listener: Handler) -> Base_Button,
	on_mouse_down_out: proc(e: Base_Button, listener: Handler) -> Base_Button,
	on_mouse_exit: proc(e: Base_Button, listener: Handler) -> Base_Button,
	on_mouse_move: proc(e: Base_Button, listener: Handler) -> Base_Button,
	on_mouse_pressure: proc(e: Base_Button, listener: Handler) -> Base_Button,
	on_mouse_up: proc(e: Base_Button, button: Mouse_Button, listener: Handler) -> Base_Button,
	on_mouse_up_out: proc(e: Base_Button, button: Mouse_Button, listener: Handler) -> Base_Button,
	on_pinch: proc(e: Base_Button, listener: Handler) -> Base_Button,
