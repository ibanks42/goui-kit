}

tree_item :: proc(id: string, label: string, loc := #caller_location) -> Tree_Item {
	e := Tree_Item{new_value(428, loc), &tree_item_vt}
	o := node_args()
	put_str(o, id)
	put_str(o, label)
	return e
}

@(private)
tree_item_vt := Tree_Item_VT {
	child = proc(e: Tree_Item, child: Tree_Item) -> Tree_Item {
		o := op(vel(e.nd), 256)
		put_u32(o, take_value(child.nd))
		return e
	},
	children = proc(e: Tree_Item, children: []Tree_Item) -> Tree_Item {
		o := op(vel(e.nd), 257)
		put_u32(o, u32(len(children)))
		for x0 in children {
			put_u32(o, take_value(x0.nd))
		}
		return e
	},
	disabled = proc(e: Tree_Item, disabled: bool) -> Tree_Item {
		o := op(vel(e.nd), 258)
		put_u8(o, u8(disabled))
		return e
	},
	expanded = proc(e: Tree_Item, expanded: bool) -> Tree_Item {
		o := op(vel(e.nd), 259)
		put_u8(o, u8(expanded))
		return e
	},
}

