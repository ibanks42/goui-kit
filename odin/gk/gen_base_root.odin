// An unstyled link that owns focus, activation, and accessibility semantics.
//
// `href` is target data, not an instruction to launch a browser. Applications inject navigation
// through `->open_with`, allowing internal routes, embedded web views, and external browsers to
// share the same behavior module. `href` is also not rendered as text; applications provide
// visible content through the element's child slot.
//
// Base_Link is gpui_kit::base::Link.
Base_Link :: struct {
	using el: Element,
	using vt: ^Base_Link_VT,
}

Base_Link_VT :: struct {
	using t_element_ext: ^Element_Ext_Trait(Base_Link),
	using t_logical_styled_ext: ^Logical_Styled_Ext_Trait(Base_Link),
	using t_styled_ext: ^Styled_Ext_Trait(Base_Link),
	using t_styled: ^Styled_Trait(Base_Link),
	using t_parent_element: ^Parent_Element_Trait(Base_Link),
	block_mouse_except_scroll: proc(e: Base_Link) -> Base_Link,
	can_drop: proc(e: Base_Link, predicate: Drop_Accept) -> Base_Link,
	capture_action: proc(e: Base_Link, listener: Action_Handler) -> Base_Link,
	capture_any_mouse_down: proc(e: Base_Link, listener: Handler) -> Base_Link,
	capture_any_mouse_up: proc(e: Base_Link, listener: Handler) -> Base_Link,
	capture_key_down: proc(e: Base_Link, listener: Handler) -> Base_Link,
	capture_key_up: proc(e: Base_Link, listener: Handler) -> Base_Link,
	capture_mouse_pressure: proc(e: Base_Link, listener: Handler) -> Base_Link,
	capture_pinch: proc(e: Base_Link, listener: Handler) -> Base_Link,
	drag_over: proc(e: Base_Link, f: Style_Refinement) -> Base_Link,
	focus: proc(e: Base_Link, f: Style_Refinement) -> Base_Link,
	focus_visible: proc(e: Base_Link, f: Style_Refinement) -> Base_Link,
	group: proc(e: Base_Link, group: string) -> Base_Link,
	group_drag_over: proc(e: Base_Link, group_name: string, f: Style_Refinement) -> Base_Link,
	group_hover: proc(e: Base_Link, group_name: string, f: Style_Refinement) -> Base_Link,
	hover: proc(e: Base_Link, f: Style_Refinement) -> Base_Link,
	in_focus: proc(e: Base_Link, f: Style_Refinement) -> Base_Link,
	key_context: proc(e: Base_Link, key_context: string) -> Base_Link,
	occlude: proc(e: Base_Link) -> Base_Link,
	on_action: proc(e: Base_Link, listener: Action_Handler) -> Base_Link,
	on_any_mouse_down: proc(e: Base_Link, listener: Handler) -> Base_Link,
	on_back_gesture: proc(e: Base_Link, listener: Handler) -> Base_Link,
	on_boxed_action: proc(e: Base_Link, action: Action, listener: Handler) -> Base_Link,
	on_drag_move: proc(e: Base_Link, listener: Handler) -> Base_Link,
	on_drop: proc(e: Base_Link, listener: Handler) -> Base_Link,
	on_file_drop_exit: proc(e: Base_Link, listener: Handler) -> Base_Link,
	on_key_down: proc(e: Base_Link, listener: Handler) -> Base_Link,
	on_key_up: proc(e: Base_Link, listener: Handler) -> Base_Link,
	on_modifiers_changed: proc(e: Base_Link, listener: Handler) -> Base_Link,
	on_mouse_down: proc(e: Base_Link, button: Mouse_Button, listener: Handler) -> Base_Link,
	on_mouse_down_out: proc(e: Base_Link, listener: Handler) -> Base_Link,
	on_mouse_exit: proc(e: Base_Link, listener: Handler) -> Base_Link,
	on_mouse_move: proc(e: Base_Link, listener: Handler) -> Base_Link,
	on_mouse_pressure: proc(e: Base_Link, listener: Handler) -> Base_Link,
	on_mouse_up: proc(e: Base_Link, button: Mouse_Button, listener: Handler) -> Base_Link,
	on_mouse_up_out: proc(e: Base_Link, button: Mouse_Button, listener: Handler) -> Base_Link,
	on_pinch: proc(e: Base_Link, listener: Handler) -> Base_Link,
	on_scroll: proc(e: Base_Link, listener: Handler) -> Base_Link,
	tab_group: proc(e: Base_Link) -> Base_Link,
	track_focus: proc(e: Base_Link, focus_handle: Focus_Handle) -> Base_Link,
	window_control_area: proc(e: Base_Link, area: Window_Control_Area) -> Base_Link,
	using t_stateful_interactive_element: ^Stateful_Interactive_Element_Trait(Base_Link),
	// Sets the name exposed to accessibility clients.
	accessibility_label: proc(e: Base_Link, label: string) -> Base_Link,
	// Sets whether pointer and keyboard activation are ignored.
	disabled: proc(e: Base_Link, disabled: bool) -> Base_Link,
	// Sets the application-defined navigation target.
	href: proc(e: Base_Link, href: string) -> Base_Link,
	// Observes pointer or keyboard activation after the open strategy runs.
	on_activate: proc(e: Base_Link, handler: Handler) -> Base_Link,
	// Injects the strategy used to open `href` on activation.
	//
	// Base never calls `open_url` on its own.
	open_with: proc(e: Base_Link, open: Handler) -> Base_Link,
	// Configures application-owned styles for the link's semantic states.
	styles: proc(e: Base_Link, build: Link_Styles) -> Base_Link,
	// Sets the focus traversal index. Use this within a GPUI tab group.
	tab_index: proc(e: Base_Link, tab_index: int) -> Base_Link,
	// Sets whether the link participates in keyboard focus traversal.
	tab_stop: proc(e: Base_Link, tab_stop: bool) -> Base_Link,
}

base_link :: proc(id: Id, flags: ..Style_Flag, loc := #caller_location) -> Base_Link {
	use_base_link()
	e := Base_Link{new_node(333, loc), &base_link_vt}
	o := node_args()
	put_id(o, id)
	tokens(e.el, flags)
	return e
}

@(private)
base_link_vt := Base_Link_VT {
	t_element_ext = cast(^Element_Ext_Trait(Base_Link))&element_ext_any,
	t_logical_styled_ext = cast(^Logical_Styled_Ext_Trait(Base_Link))&logical_styled_ext_any,
	t_styled_ext = cast(^Styled_Ext_Trait(Base_Link))&styled_ext_any,
	t_styled = cast(^Styled_Trait(Base_Link))&styled_any,
	t_parent_element = cast(^Parent_Element_Trait(Base_Link))&parent_element_any,
	block_mouse_except_scroll = transmute(proc(e: Base_Link) -> Base_Link)interactive_element_block_mouse_except_scroll,
	can_drop = transmute(proc(e: Base_Link, predicate: Drop_Accept) -> Base_Link)interactive_element_can_drop,
	capture_action = transmute(proc(e: Base_Link, listener: Action_Handler) -> Base_Link)interactive_element_capture_action,
	capture_any_mouse_down = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_capture_any_mouse_down,
	capture_any_mouse_up = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_capture_any_mouse_up,
	capture_key_down = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_capture_key_down,
	capture_key_up = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_capture_key_up,
	capture_mouse_pressure = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_capture_mouse_pressure,
	capture_pinch = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_capture_pinch,
	drag_over = transmute(proc(e: Base_Link, f: Style_Refinement) -> Base_Link)interactive_element_drag_over,
	focus = transmute(proc(e: Base_Link, f: Style_Refinement) -> Base_Link)interactive_element_focus,
	focus_visible = transmute(proc(e: Base_Link, f: Style_Refinement) -> Base_Link)interactive_element_focus_visible,
	group = transmute(proc(e: Base_Link, group: string) -> Base_Link)interactive_element_group,
	group_drag_over = transmute(proc(e: Base_Link, group_name: string, f: Style_Refinement) -> Base_Link)interactive_element_group_drag_over,
	group_hover = transmute(proc(e: Base_Link, group_name: string, f: Style_Refinement) -> Base_Link)interactive_element_group_hover,
	hover = transmute(proc(e: Base_Link, f: Style_Refinement) -> Base_Link)interactive_element_hover,
	in_focus = transmute(proc(e: Base_Link, f: Style_Refinement) -> Base_Link)interactive_element_in_focus,
	key_context = transmute(proc(e: Base_Link, key_context: string) -> Base_Link)interactive_element_key_context,
	occlude = transmute(proc(e: Base_Link) -> Base_Link)interactive_element_occlude,
	on_action = transmute(proc(e: Base_Link, listener: Action_Handler) -> Base_Link)interactive_element_on_action,
	on_any_mouse_down = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_on_any_mouse_down,
	on_back_gesture = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_on_back_gesture,
	on_boxed_action = transmute(proc(e: Base_Link, action: Action, listener: Handler) -> Base_Link)interactive_element_on_boxed_action,
	on_drag_move = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_on_drag_move,
	on_drop = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_on_drop,
	on_file_drop_exit = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_on_file_drop_exit,
	on_key_down = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_on_key_down,
	on_key_up = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_on_key_up,
	on_modifiers_changed = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_on_modifiers_changed,
	on_mouse_down = transmute(proc(e: Base_Link, button: Mouse_Button, listener: Handler) -> Base_Link)interactive_element_on_mouse_down,
	on_mouse_down_out = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_on_mouse_down_out,
	on_mouse_exit = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_on_mouse_exit,
	on_mouse_move = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_on_mouse_move,
	on_mouse_pressure = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_on_mouse_pressure,
	on_mouse_up = transmute(proc(e: Base_Link, button: Mouse_Button, listener: Handler) -> Base_Link)interactive_element_on_mouse_up,
	on_mouse_up_out = transmute(proc(e: Base_Link, button: Mouse_Button, listener: Handler) -> Base_Link)interactive_element_on_mouse_up_out,
	on_pinch = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_on_pinch,
	on_scroll = transmute(proc(e: Base_Link, listener: Handler) -> Base_Link)interactive_element_on_scroll,
	tab_group = transmute(proc(e: Base_Link) -> Base_Link)interactive_element_tab_group,
	track_focus = transmute(proc(e: Base_Link, focus_handle: Focus_Handle) -> Base_Link)interactive_element_track_focus,
	window_control_area = transmute(proc(e: Base_Link, area: Window_Control_Area) -> Base_Link)interactive_element_window_control_area,
	t_stateful_interactive_element = cast(^Stateful_Interactive_Element_Trait(Base_Link))&stateful_interactive_element_any,
	accessibility_label = proc(e: Base_Link, label: string) -> Base_Link {
		o := op(e.el, 256)
		put_str(o, label)
		return e
	},
	disabled = proc(e: Base_Link, disabled: bool) -> Base_Link {
		o := op(e.el, 257)
		put_u8(o, u8(disabled))
		return e
	},
	href = proc(e: Base_Link, href: string) -> Base_Link {
		o := op(e.el, 258)
		put_str(o, href)
		return e
	},
	on_activate = proc(e: Base_Link, handler: Handler) -> Base_Link {
		o := op(e.el, 259)
		put_u32(o, register(handler, 1))
		return e
	},
	open_with = proc(e: Base_Link, open: Handler) -> Base_Link {
		o := op(e.el, 260)
		put_u32(o, register(open, 83))
		return e
	},
	styles = proc(e: Base_Link, build: Link_Styles) -> Base_Link {
		o := op(e.el, 261)
		put_u32(o, take_value(build.nd))
		return e
	},
	tab_index = proc(e: Base_Link, tab_index: int) -> Base_Link {
		o := op(e.el, 262)
		put_u64(o, u64(tab_index))
		return e
	},
	tab_stop = proc(e: Base_Link, tab_stop: bool) -> Base_Link {
		o := op(e.el, 263)
		put_u8(o, u8(tab_stop))
		return e
	},
}

// Semantic root styles supported by `Base_Link`.
