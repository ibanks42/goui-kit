	tab_group: proc(e: Base_Button) -> Base_Button,
	window_control_area: proc(e: Base_Button, area: Window_Control_Area) -> Base_Button,
	a11y_synthetic_children: proc(e: Base_Button, f: []A11y_Child) -> Base_Button,
	accessibility_id: proc(e: Base_Button, id: string) -> Base_Button,
	active: proc(e: Base_Button, f: Style_Refinement) -> Base_Button,
	anchor_scroll: proc(e: Base_Button, scroll_anchor: Maybe(Scroll_Anchor)) -> Base_Button,
	aria_active_descendant: proc(e: Base_Button) -> Base_Button,
	aria_column_count: proc(e: Base_Button, count: int) -> Base_Button,
	aria_column_index: proc(e: Base_Button, index: int) -> Base_Button,
	aria_description: proc(e: Base_Button, description: string) -> Base_Button,
	aria_expanded: proc(e: Base_Button, expanded: bool) -> Base_Button,
	aria_keyshortcuts: proc(e: Base_Button, keyshortcuts: string) -> Base_Button,
	aria_label: proc(e: Base_Button, label: string) -> Base_Button,
	aria_level: proc(e: Base_Button, level: int) -> Base_Button,
	aria_max_numeric_value: proc(e: Base_Button, value: f64) -> Base_Button,
	aria_min_numeric_value: proc(e: Base_Button, value: f64) -> Base_Button,
	aria_numeric_value: proc(e: Base_Button, value: f64) -> Base_Button,
	aria_numeric_value_step: proc(e: Base_Button, step: f64) -> Base_Button,
	aria_placeholder: proc(e: Base_Button, placeholder: string) -> Base_Button,
	aria_position_in_set: proc(e: Base_Button, position: int) -> Base_Button,
	aria_row_count: proc(e: Base_Button, count: int) -> Base_Button,
	aria_row_index: proc(e: Base_Button, index: int) -> Base_Button,
	aria_selected: proc(e: Base_Button, selected: bool) -> Base_Button,
	aria_size_of_set: proc(e: Base_Button, size: int) -> Base_Button,
	aria_value: proc(e: Base_Button, value: string) -> Base_Button,
	external_drag_payload: proc(e: Base_Button, resolver: External_Drag_Payload) -> Base_Button,
	group_active: proc(e: Base_Button, group_name: string, f: Style_Refinement) -> Base_Button,
	hover_listener_mode: proc(e: Base_Button, mode: Hover_Listener_Mode) -> Base_Button,
	hoverable_tooltip: proc(e: Base_Button, build_tooltip: View_Or_Tooltip) -> Base_Button,
	on_aux_click: proc(e: Base_Button, listener: Handler) -> Base_Button,
	on_drag: proc(e: Base_Button, value: Drag_Value, constructor: View) -> Base_Button,
	on_hover: proc(e: Base_Button, listener: Handler) -> Base_Button,
	overflow_scroll: proc(e: Base_Button) -> Base_Button,
	overflow_x_scroll: proc(e: Base_Button) -> Base_Button,
	overflow_y_scroll: proc(e: Base_Button) -> Base_Button,
	restrict_scroll_to_axis: proc(e: Base_Button) -> Base_Button,
	tooltip: proc(e: Base_Button, build_tooltip: View_Or_Tooltip) -> Base_Button,
	tooltip_show_delay: proc(e: Base_Button, delay: time.Duration) -> Base_Button,
	track_scroll: proc(e: Base_Button, scroll_handle: Scroll_Handle) -> Base_Button,
	// Sets the label exposed to accessibility clients.
	accessibility_label: proc(e: Base_Button, label: string) -> Base_Button,
	// Sets whether the button ignores pointer and keyboard activation.
	//
	// Disabled buttons are skipped during Tab traversal. If this button already owns focus when it
	// becomes disabled, it retains the focus binding until focus moves away, so keyboard traversal can
	// continue in either direction.
	//
	// While disabled, the `hover`, `active`, `group_hover` and `group_active` styles are not applied;
	// use `->disabled` for its look.
	disabled: proc(e: Base_Button, disabled: bool) -> Base_Button,
	// Sets whether pressing the button moves focus onto it. The default is `true`.
	//
	// A non-focusable button leaves focus wherever it already is, which keeps a composed control from
	// flickering its focus ring on every press. It also gives up Enter and Space activation, so only
	// use it for a button that a focused sibling already exposes to the keyboard, such as a number
	// input's step buttons.
	focusable: proc(e: Base_Button, focusable: bool) -> Base_Button,
	// Sets the activation handler for pointer, Enter, and Space input.
	on_click: proc(e: Base_Button, handler: Handler) -> Base_Button,
	// Overrides the accessibility role. The default is `Button`.
	role: proc(e: Base_Button, role: Role_Override) -> Base_Button,
	// Sets the application-controlled selected presentation state.
	//
	// This supports persistent trigger presentation while an associated menu or popover is open. It is
	// distinct from momentary `active`, Toggle's `pressed` state, and accessibility toggle metadata;
	// selecting a Button does not automatically set `aria_toggled`.
	selected: proc(e: Base_Button, selected: bool) -> Base_Button,
	// Defines application-owned styles for the button's semantic states.
	styles: proc(e: Base_Button, build: Button_Styles) -> Base_Button,
	// Sets the focus traversal index. The default is `0`.
	tab_index: proc(e: Base_Button, tab_index: int) -> Base_Button,
	// Sets whether the button participates in keyboard focus traversal.
	tab_stop: proc(e: Base_Button, tab_stop: bool) -> Base_Button,
	// Uses a caller-owned focus handle instead of creating keyed state.
	track_focus: proc(e: Base_Button, focus_handle: Focus_Handle) -> Base_Button,
}

base_button :: proc(id: Id, flags: ..Style_Flag, loc := #caller_location) -> Base_Button {
	use_base_button()
	e := Base_Button{new_node(289, loc), &base_button_vt}
	o := node_args()
	put_id(o, id)
	tokens(e.el, flags)
	return e
}

