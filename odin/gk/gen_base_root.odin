	on_mouse_up_out: proc(e: Color_Swatch, button: Mouse_Button, listener: Handler) -> Color_Swatch,
	on_pinch: proc(e: Color_Swatch, listener: Handler) -> Color_Swatch,
	on_scroll: proc(e: Color_Swatch, listener: Handler) -> Color_Swatch,
	tab_group: proc(e: Color_Swatch) -> Color_Swatch,
	track_focus: proc(e: Color_Swatch, focus_handle: Focus_Handle) -> Color_Swatch,
	window_control_area: proc(e: Color_Swatch, area: Window_Control_Area) -> Color_Swatch,
