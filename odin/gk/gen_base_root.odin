		o := op(e.el, 263)
		put_u8(o, u8(tab_stop))
		return e
	},
}

// An unstyled controlled combobox root.
//
// Applications own the trigger, popup, searchable collection, selection, and appearance. This root
// owns combobox semantics and keyboard focus transfer.
//
// Base_Combobox is gpui_kit::base::Combobox.
Base_Combobox :: struct {
	using el: Element,
	using vt: ^Base_Combobox_VT,
}

Base_Combobox_VT :: struct {
	using t_element_ext: ^Element_Ext_Trait(Base_Combobox),
	using t_logical_styled_ext: ^Logical_Styled_Ext_Trait(Base_Combobox),
	using t_styled_ext: ^Styled_Ext_Trait(Base_Combobox),
	using t_styled: ^Styled_Trait(Base_Combobox),
	using t_parent_element: ^Parent_Element_Trait(Base_Combobox),
	content_focus_handle: proc(e: Base_Combobox, focus_handle: Focus_Handle) -> Base_Combobox,
	disabled: proc(e: Base_Combobox, disabled: bool) -> Base_Combobox,
	focus_handle: proc(e: Base_Combobox, focus_handle: Focus_Handle) -> Base_Combobox,
	// Handles the Confirm action while the combobox is open.
	on_confirm: proc(e: Base_Combobox, handler: Handler) -> Base_Combobox,
	// Handles a dismissal requested through the Cancel action.
	//
	// This runs before the controlled open state is asked to close, so a combobox that commits its
	// pending value on dismissal can still read that value here.
	on_dismiss: proc(e: Base_Combobox, handler: Handler) -> Base_Combobox,
	on_open_change: proc(e: Base_Combobox, handler: Handler) -> Base_Combobox,
	open: proc(e: Base_Combobox, open: bool) -> Base_Combobox,
}

base_combobox :: proc(id: Id, flags: ..Style_Flag, loc := #caller_location) -> Base_Combobox {
	use_base_combobox()
	e := Base_Combobox{new_node(305, loc), &base_combobox_vt}
	o := node_args()
	put_id(o, id)
	tokens(e.el, flags)
	return e
}

@(private)
base_combobox_vt := Base_Combobox_VT {
	t_element_ext = cast(^Element_Ext_Trait(Base_Combobox))&element_ext_any,
	t_logical_styled_ext = cast(^Logical_Styled_Ext_Trait(Base_Combobox))&logical_styled_ext_any,
	t_styled_ext = cast(^Styled_Ext_Trait(Base_Combobox))&styled_ext_any,
	t_styled = cast(^Styled_Trait(Base_Combobox))&styled_any,
	t_parent_element = cast(^Parent_Element_Trait(Base_Combobox))&parent_element_any,
	content_focus_handle = proc(e: Base_Combobox, focus_handle: Focus_Handle) -> Base_Combobox {
		o := op(e.el, 256)
		put_u64(o, focus_handle.h)
		return e
	},
	disabled = proc(e: Base_Combobox, disabled: bool) -> Base_Combobox {
		o := op(e.el, 257)
		put_u8(o, u8(disabled))
		return e
	},
	focus_handle = proc(e: Base_Combobox, focus_handle: Focus_Handle) -> Base_Combobox {
		o := op(e.el, 258)
		put_u64(o, focus_handle.h)
		return e
	},
	on_confirm = proc(e: Base_Combobox, handler: Handler) -> Base_Combobox {
		o := op(e.el, 259)
		put_u32(o, register(handler, 3))
		return e
	},
	on_dismiss = proc(e: Base_Combobox, handler: Handler) -> Base_Combobox {
		o := op(e.el, 260)
		put_u32(o, register(handler, 3))
		return e
	},
	on_open_change = proc(e: Base_Combobox, handler: Handler) -> Base_Combobox {
		o := op(e.el, 261)
		put_u32(o, register(handler, 4))
		return e
	},
	open = proc(e: Base_Combobox, open: bool) -> Base_Combobox {
		o := op(e.el, 262)
		put_u8(o, u8(open))
		return e
	},
}

// Unstyled controlled date-picker root. Applications own its trigger, calendar, positioning, and
// visual presentation; Base owns focus and open/dismiss keyboard behavior.
//
// Base_Date_Picker is gpui_kit::base::DatePicker.
Base_Date_Picker :: struct {
	using el: Element,
	using vt: ^Base_Date_Picker_VT,
}

Base_Date_Picker_VT :: struct {
	using t_element_ext: ^Element_Ext_Trait(Base_Date_Picker),
