	o := node_args()
	put_id(o, id)
	return e
}

v_resizable :: proc(id: Id, loc := #caller_location) -> Resizable_Panel_Group {
	use_base_resizable()
	e := Resizable_Panel_Group{new_node(866, loc), &resizable_panel_group_vt}
	o := node_args()
	put_id(o, id)
	return e
}

@(private)
resizable_panel_group_vt := Resizable_Panel_Group_VT {
	axis = proc(e: Resizable_Panel_Group, axis: Axis) -> Resizable_Panel_Group {
		o := op(e.el, 256)
		put_u16(o, u16(axis))
		return e
	},
	child = proc(e: Resizable_Panel_Group, panel: Resizable_Panel_Into) -> Resizable_Panel_Group {
		o := op(e.el, 257)
		put_Resizable_Panel_Into(o, panel)
		return e
	},
	children = proc(e: Resizable_Panel_Group, panels: []Resizable_Panel) -> Resizable_Panel_Group {
		o := op(e.el, 258)
		put_u32(o, u32(len(panels)))
		for x0 in panels {
			put_u32(o, take(x0.el))
		}
		return e
	},
	on_resize = proc(e: Resizable_Panel_Group, on_resize: Handler) -> Resizable_Panel_Group {
		o := op(e.el, 259)
		put_u32(o, register(on_resize, 115))
		return e
	},
	size = proc(e: Resizable_Panel_Group, size: f32) -> Resizable_Panel_Group {
		o := op(e.el, 260)
		put_f32(o, size)
		return e
	},
	with_handle_appearance = proc(e: Resizable_Panel_Group, appearance: Resize_Handle_Renderer) -> Resizable_Panel_Group {
		o := op(e.el, 262)
		{
			switch x in appearance {
			case Row_Source:
				put_u8(o, 0)
				put_u64(o, x.h)
			case Resize_Handle_Renderer_Kit:
				put_u8(o, 1)
				put_u16(o, u16(x))
			case:
				stop({}, "a zero gk.Resize_Handle_Renderer was given to a builder: it was never made (make it with its constructor before giving it)")
			}
		}
		return e
	},
	with_state = proc(e: Resizable_Panel_Group, state: Resizable_State) -> Resizable_Panel_Group {
		o := op(e.el, 261)
		put_u64(o, state.h)
		return e
	},
}

