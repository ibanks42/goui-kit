	anchor_scroll: proc(e: Input_Base, scroll_anchor: Maybe(Scroll_Anchor)) -> Input_Base,
	aria_active_descendant: proc(e: Input_Base) -> Input_Base,
	aria_column_count: proc(e: Input_Base, count: int) -> Input_Base,
	aria_column_index: proc(e: Input_Base, index: int) -> Input_Base,
	aria_description: proc(e: Input_Base, description: string) -> Input_Base,
	aria_expanded: proc(e: Input_Base, expanded: bool) -> Input_Base,
	aria_keyshortcuts: proc(e: Input_Base, keyshortcuts: string) -> Input_Base,
	aria_label: proc(e: Input_Base, label: string) -> Input_Base,
	aria_level: proc(e: Input_Base, level: int) -> Input_Base,
	aria_max_numeric_value: proc(e: Input_Base, value: f64) -> Input_Base,
	aria_min_numeric_value: proc(e: Input_Base, value: f64) -> Input_Base,
	aria_numeric_value: proc(e: Input_Base, value: f64) -> Input_Base,
	aria_numeric_value_step: proc(e: Input_Base, step: f64) -> Input_Base,
	aria_placeholder: proc(e: Input_Base, placeholder: string) -> Input_Base,
	aria_position_in_set: proc(e: Input_Base, position: int) -> Input_Base,
	aria_row_count: proc(e: Input_Base, count: int) -> Input_Base,
	aria_row_index: proc(e: Input_Base, index: int) -> Input_Base,
	aria_selected: proc(e: Input_Base, selected: bool) -> Input_Base,
	aria_size_of_set: proc(e: Input_Base, size: int) -> Input_Base,
	aria_value: proc(e: Input_Base, value: string) -> Input_Base,
	external_drag_payload: proc(e: Input_Base, resolver: External_Drag_Payload) -> Input_Base,
	focusable: proc(e: Input_Base) -> Input_Base,
	group_active: proc(e: Input_Base, group_name: string, f: Style_Refinement) -> Input_Base,
	hover_listener_mode: proc(e: Input_Base, mode: Hover_Listener_Mode) -> Input_Base,
	hoverable_tooltip: proc(e: Input_Base, build_tooltip: View_Or_Tooltip) -> Input_Base,
	on_aux_click: proc(e: Input_Base, listener: Handler) -> Input_Base,
	on_click: proc(e: Input_Base, listener: Handler) -> Input_Base,
	on_drag: proc(e: Input_Base, value: Drag_Value, constructor: View) -> Input_Base,
	on_hover: proc(e: Input_Base, listener: Handler) -> Input_Base,
	overflow_scroll: proc(e: Input_Base) -> Input_Base,
	overflow_x_scroll: proc(e: Input_Base) -> Input_Base,
	overflow_y_scroll: proc(e: Input_Base) -> Input_Base,
	restrict_scroll_to_axis: proc(e: Input_Base) -> Input_Base,
	tooltip: proc(e: Input_Base, build_tooltip: View_Or_Tooltip) -> Input_Base,
	tooltip_show_delay: proc(e: Input_Base, delay: time.Duration) -> Input_Base,
	track_scroll: proc(e: Input_Base, scroll_handle: Scroll_Handle) -> Input_Base,
	accessibility_label: proc(e: Input_Base, label: string) -> Input_Base,
	disabled: proc(e: Input_Base, disabled: bool) -> Input_Base,
	focused: proc(e: Input_Base, focused: bool) -> Input_Base,
	role: proc(e: Input_Base, role: Role_Override) -> Input_Base,
	// Exposes an editor's native semantics through this frame's component ID.
	//
	// `editor` must identify the input, textarea or editor state rendered below this frame, without
	// intervening element IDs. Anonymous layout wrappers are allowed. ID queries retain the frame's
	// path, bounds and visibility. Role, label, value, checked/indeterminate, selected, expanded,
	// disabled and focus facts come from the editor's existing native node and observed focus scope,
	// not independently focusable addon controls. Native snapshot enumeration is unchanged, so
	// role/label queries do not duplicate editors.
	//
	// This only declares an observation relationship with `test-support`; it never adds a native
	// accessibility node or registers a focus handle.
	semantic_owner: proc(e: Input_Base, editor: Entity_Id) -> Input_Base,
	styles: proc(e: Input_Base, build: Input_Styles) -> Input_Base,
}

input_base :: proc(id: Id, flags: ..Style_Flag, loc := #caller_location) -> Input_Base {
	use_base_input()
	e := Input_Base{new_node(331, loc), &input_base_vt}
	o := node_args()
	put_id(o, id)
	tokens(e.el, flags)
	return e
}

