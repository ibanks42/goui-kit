base_collapsible_default :: proc(flags: ..Style_Flag, loc := #caller_location) -> Base_Collapsible {
	use_base_collapsible()
	e := Base_Collapsible{new_node(298, loc), &base_collapsible_vt}
	tokens(e.el, flags)
	return e
}

