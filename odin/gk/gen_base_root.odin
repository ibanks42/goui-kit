color_swatch :: proc(id: Id, color: Color, flags: ..Style_Flag, loc := #caller_location) -> Color_Swatch {
	use_base_color_picker()
	e := Color_Swatch{new_node(301, loc), &color_swatch_vt}
	o := node_args()
	put_id(o, id)
	put_color(o, color)
	tokens(e.el, flags)
	return e
}

