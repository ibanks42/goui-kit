	on_boxed_action: proc(e: Base_Checkbox, action: Action, listener: Handler) -> Base_Checkbox,
	on_drag_move: proc(e: Base_Checkbox, listener: Handler) -> Base_Checkbox,
	on_drop: proc(e: Base_Checkbox, listener: Handler) -> Base_Checkbox,
	on_file_drop_exit: proc(e: Base_Checkbox, listener: Handler) -> Base_Checkbox,
	on_key_down: proc(e: Base_Checkbox, listener: Handler) -> Base_Checkbox,
	on_key_up: proc(e: Base_Checkbox, listener: Handler) -> Base_Checkbox,
	on_modifiers_changed: proc(e: Base_Checkbox, listener: Handler) -> Base_Checkbox,
	on_mouse_down: proc(e: Base_Checkbox, button: Mouse_Button, listener: Handler) -> Base_Checkbox,
	on_mouse_down_out: proc(e: Base_Checkbox, listener: Handler) -> Base_Checkbox,
	on_mouse_exit: proc(e: Base_Checkbox, listener: Handler) -> Base_Checkbox,
	on_mouse_move: proc(e: Base_Checkbox, listener: Handler) -> Base_Checkbox,
	on_mouse_pressure: proc(e: Base_Checkbox, listener: Handler) -> Base_Checkbox,
	on_mouse_up: proc(e: Base_Checkbox, button: Mouse_Button, listener: Handler) -> Base_Checkbox,
	on_mouse_up_out: proc(e: Base_Checkbox, button: Mouse_Button, listener: Handler) -> Base_Checkbox,
	on_pinch: proc(e: Base_Checkbox, listener: Handler) -> Base_Checkbox,
	on_scroll: proc(e: Base_Checkbox, listener: Handler) -> Base_Checkbox,
	tab_group: proc(e: Base_Checkbox) -> Base_Checkbox,
	window_control_area: proc(e: Base_Checkbox, area: Window_Control_Area) -> Base_Checkbox,
	a11y_synthetic_children: proc(e: Base_Checkbox, f: []A11y_Child) -> Base_Checkbox,
	accessibility_id: proc(e: Base_Checkbox, id: string) -> Base_Checkbox,
	active: proc(e: Base_Checkbox, f: Style_Refinement) -> Base_Checkbox,
	anchor_scroll: proc(e: Base_Checkbox, scroll_anchor: Maybe(Scroll_Anchor)) -> Base_Checkbox,
	aria_active_descendant: proc(e: Base_Checkbox) -> Base_Checkbox,
	aria_column_count: proc(e: Base_Checkbox, count: int) -> Base_Checkbox,
	aria_column_index: proc(e: Base_Checkbox, index: int) -> Base_Checkbox,
