	put_id(o, id)
	tokens(e.el, flags)
	return e
}

@(private)
base_hover_card_vt := Base_Hover_Card_VT {
	t_logical_styled_ext = cast(^Logical_Styled_Ext_Trait(Base_Hover_Card))&logical_styled_ext_any,
	t_styled_ext = cast(^Styled_Ext_Trait(Base_Hover_Card))&styled_ext_any,
	t_styled = cast(^Styled_Trait(Base_Hover_Card))&styled_any,
	anchor = proc(e: Base_Hover_Card, anchor: Anchor) -> Base_Hover_Card {
		o := op(e.el, 256)
		put_u16(o, u16(anchor))
		return e
	},
	close_delay = proc(e: Base_Hover_Card, duration: time.Duration) -> Base_Hover_Card {
		o := op(e.el, 257)
		put_ms(o, i64(duration))
		return e
	},
	content = proc(e: Base_Hover_Card, content: Row_Source) -> Base_Hover_Card {
		o := op(e.el, 261)
		put_u64(o, items_check(content, 2))
		return e
	},
	on_open_change = proc(e: Base_Hover_Card, callback: Handler) -> Base_Hover_Card {
		o := op(e.el, 258)
		put_u32(o, register(callback, 4))
		return e
	},
	open_delay = proc(e: Base_Hover_Card, duration: time.Duration) -> Base_Hover_Card {
		o := op(e.el, 259)
		put_ms(o, i64(duration))
		return e
	},
	trigger = proc(e: Base_Hover_Card, trigger: Element) -> Base_Hover_Card {
		o := op(e.el, 260)
		put_u32(o, take(trigger))
		return e
	},
}

