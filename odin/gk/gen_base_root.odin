	set_position: proc(e: Base_Tab, position: int, size: int) -> Base_Tab,
	styles: proc(e: Base_Tab, build: Tab_Styles) -> Base_Tab,
}

base_tab :: proc(id: Id, flags: ..Style_Flag, loc := #caller_location) -> Base_Tab {
	use_base_tabs()
	e := Base_Tab{new_node(391, loc), &base_tab_vt}
	o := node_args()
	put_id(o, id)
	tokens(e.el, flags)
	return e
}

