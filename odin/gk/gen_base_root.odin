	overflow_x_scroll = transmute(proc(e: Base_Tab) -> Base_Tab)stateful_interactive_element_overflow_x_scroll,
	overflow_y_scroll = transmute(proc(e: Base_Tab) -> Base_Tab)stateful_interactive_element_overflow_y_scroll,
	restrict_scroll_to_axis = transmute(proc(e: Base_Tab) -> Base_Tab)stateful_interactive_element_restrict_scroll_to_axis,
	role = transmute(proc(e: Base_Tab, role: Role) -> Base_Tab)stateful_interactive_element_role,
	tooltip = transmute(proc(e: Base_Tab, build_tooltip: View_Or_Tooltip) -> Base_Tab)stateful_interactive_element_tooltip,
	tooltip_show_delay = transmute(proc(e: Base_Tab, delay: time.Duration) -> Base_Tab)stateful_interactive_element_tooltip_show_delay,
	track_scroll = transmute(proc(e: Base_Tab, scroll_handle: Scroll_Handle) -> Base_Tab)stateful_interactive_element_track_scroll,
	accessibility_label = proc(e: Base_Tab, label: string) -> Base_Tab {
		o := op(e.el, 256)
		put_str(o, label)
		return e
	},
	disabled = proc(e: Base_Tab, disabled: bool) -> Base_Tab {
		o := op(e.el, 257)
		put_u8(o, u8(disabled))
		return e
	},
	id = proc(e: Base_Tab, id: Id) -> Base_Tab {
		o := op(e.el, 258)
		put_id(o, id)
		return e
	},
	on_click = proc(e: Base_Tab, handler: Handler) -> Base_Tab {
		o := op(e.el, 259)
		put_u32(o, register(handler, 1))
		return e
	},
	selected = proc(e: Base_Tab, selected: bool) -> Base_Tab {
		o := op(e.el, 260)
		put_u8(o, u8(selected))
		return e
	},
	set_position = proc(e: Base_Tab, position: int, size: int) -> Base_Tab {
		o := op(e.el, 261)
		put_usize(o, position)
		put_usize(o, size)
		return e
	},
	styles = proc(e: Base_Tab, build: Tab_Styles) -> Base_Tab {
		o := op(e.el, 262)
		put_u32(o, take_value(build.nd))
		return e
	},
}

