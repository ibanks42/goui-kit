// A deep toast-stack element that owns measurement, overlap, and expansion motion.
//
// Toast_Stack is gpui_kit::base::ToastStack.
Toast_Stack :: struct {
	using el: Element,
	using vt: ^Toast_Stack_VT,
}

Toast_Stack_VT :: struct {
	using t_element_ext: ^Element_Ext_Trait(Toast_Stack),
	using t_logical_styled_ext: ^Logical_Styled_Ext_Trait(Toast_Stack),
	using t_styled_ext: ^Styled_Ext_Trait(Toast_Stack),
	using t_styled: ^Styled_Trait(Toast_Stack),
	using t_parent_element: ^Parent_Element_Trait(Toast_Stack),
	using t_interactive_element: ^Interactive_Element_Trait(Toast_Stack),
	using t_stateful_interactive_element: ^Stateful_Interactive_Element_Trait(Toast_Stack),
	// Set the focus scope that expands the stack and pauses auto-hide timers.
	focus_handle: proc(e: Toast_Stack, focus_handle: Focus_Handle) -> Toast_Stack,
	// Add a stably keyed toast item to the stack.
	item: proc(e: Toast_Stack, id: Id, child: Element) -> Toast_Stack,
	// Set the stack motion tokens.
	motion: proc(e: Toast_Stack, motion: Toast_Motion) -> Toast_Stack,
	// Set the viewport edge used to anchor stack geometry.
	placement: proc(e: Toast_Stack, placement: Anchor) -> Toast_Stack,
}

// Create a toast stack with Base UI-compatible motion.
toast_stack :: proc(id: Id, state: Toast_Stack_State, flags: ..Style_Flag, loc := #caller_location) -> Toast_Stack {
	use_base_toast()
	e := Toast_Stack{new_node(825, loc), &toast_stack_vt}
	o := node_args()
	put_id(o, id)
	put_obj(o, state.h)
	tokens(e.el, flags)
	return e
}

@(private)
toast_stack_vt := Toast_Stack_VT {
	t_element_ext = cast(^Element_Ext_Trait(Toast_Stack))&element_ext_any,
	t_logical_styled_ext = cast(^Logical_Styled_Ext_Trait(Toast_Stack))&logical_styled_ext_any,
	t_styled_ext = cast(^Styled_Ext_Trait(Toast_Stack))&styled_ext_any,
	t_styled = cast(^Styled_Trait(Toast_Stack))&styled_any,
	t_parent_element = cast(^Parent_Element_Trait(Toast_Stack))&parent_element_any,
	t_interactive_element = cast(^Interactive_Element_Trait(Toast_Stack))&interactive_element_any,
	t_stateful_interactive_element = cast(^Stateful_Interactive_Element_Trait(Toast_Stack))&stateful_interactive_element_any,
	focus_handle = proc(e: Toast_Stack, focus_handle: Focus_Handle) -> Toast_Stack {
		o := op(e.el, 256)
		put_u64(o, focus_handle.h)
		return e
	},
	item = proc(e: Toast_Stack, id: Id, child: Element) -> Toast_Stack {
		o := op(e.el, 257)
		put_id(o, id)
		put_u32(o, take(child))
		return e
	},
	motion = proc(e: Toast_Stack, motion: Toast_Motion) -> Toast_Stack {
		o := op(e.el, 258)
		put_Toast_Motion(o, motion)
		return e
	},
	placement = proc(e: Toast_Stack, placement: Anchor) -> Toast_Stack {
		o := op(e.el, 259)
		put_u16(o, u16(placement))
		return e
	},
}

