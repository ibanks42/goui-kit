	e := Base_Table_Header{new_node(398, loc), &base_table_header_vt}
	o := node_args()
	put_id(o, id)
	tokens(e.el, flags)
	return e
}

@(private)
base_table_header_vt := Base_Table_Header_VT {
	t_element_ext = cast(^Element_Ext_Trait(Base_Table_Header))&element_ext_any,
	t_logical_styled_ext = cast(^Logical_Styled_Ext_Trait(Base_Table_Header))&logical_styled_ext_any,
	t_styled_ext = cast(^Styled_Ext_Trait(Base_Table_Header))&styled_ext_any,
	t_styled = cast(^Styled_Trait(Base_Table_Header))&styled_any,
	t_parent_element = cast(^Parent_Element_Trait(Base_Table_Header))&parent_element_any,
	t_interactive_element = cast(^Interactive_Element_Trait(Base_Table_Header))&interactive_element_any,
	t_stateful_interactive_element = cast(^Stateful_Interactive_Element_Trait(Base_Table_Header))&stateful_interactive_element_any,
}

// An unstyled semantic table row.
//
// Base_Table_Row is gpui_kit::base::TableRow.
Base_Table_Row :: struct {
	using el: Element,
	using vt: ^Base_Table_Row_VT,
}

Base_Table_Row_VT :: struct {
	using t_element_ext: ^Element_Ext_Trait(Base_Table_Row),
	using t_logical_styled_ext: ^Logical_Styled_Ext_Trait(Base_Table_Row),
	using t_styled_ext: ^Styled_Ext_Trait(Base_Table_Row),
	using t_styled: ^Styled_Trait(Base_Table_Row),
	using t_parent_element: ^Parent_Element_Trait(Base_Table_Row),
	using t_interactive_element: ^Interactive_Element_Trait(Base_Table_Row),
	using t_stateful_interactive_element: ^Stateful_Interactive_Element_Trait(Base_Table_Row),
}

// Create an unstyled semantic table row with a one-based accessibility index.
base_table_row :: proc(id: Id, row_index: int, flags: ..Style_Flag, loc := #caller_location) -> Base_Table_Row {
	use_base_table()
	e := Base_Table_Row{new_node(399, loc), &base_table_row_vt}
	o := node_args()
	put_id(o, id)
	put_usize(o, row_index)
	tokens(e.el, flags)
	return e
}

@(private)
base_table_row_vt := Base_Table_Row_VT {
	t_element_ext = cast(^Element_Ext_Trait(Base_Table_Row))&element_ext_any,
	t_logical_styled_ext = cast(^Logical_Styled_Ext_Trait(Base_Table_Row))&logical_styled_ext_any,
	t_styled_ext = cast(^Styled_Ext_Trait(Base_Table_Row))&styled_ext_any,
	t_styled = cast(^Styled_Trait(Base_Table_Row))&styled_any,
	t_parent_element = cast(^Parent_Element_Trait(Base_Table_Row))&parent_element_any,
	t_interactive_element = cast(^Interactive_Element_Trait(Base_Table_Row))&interactive_element_any,
	t_stateful_interactive_element = cast(^Stateful_Interactive_Element_Trait(Base_Table_Row))&stateful_interactive_element_any,
}

// An unstyled collection root for `Base_Tab` elements.
//
// Controlled selection and activation stay with the child tabs: the application decides which tab
// is selected and what activating one does. The root supplies the tab-list semantics and the
// keyboard contract of the ARIA tabs pattern (manual activation):
// - The list is one tab stop. `Tab` enters it on the selected tab (the first enabled tab when
//   none is selected) and leaves it with the next `Tab`.
// - Left and Right move focus to the previous or next enabled tab, wrapping at either end; in a
//   right-to-left layout the next tab sits to the left. A vertical list (`->axis`) uses Up and
//   Down instead.
// - Home and End move focus to the first and last enabled tab.
// - Enter and Space activate the focused tab, running its click handler.
// - Disabled tabs are skipped and never take focus from the keyboard.
//
// Moving focus does not select: selection follows activation, so a controlled list never changes
// behind the application's back.
//
// Tabs is gpui_kit::base::Tabs.
Tabs :: struct {
	using el: Element,
	using vt: ^Tabs_VT,
}

Tabs_VT :: struct {
	using t_element_ext: ^Element_Ext_Trait(Tabs),
	using t_logical_styled_ext: ^Logical_Styled_Ext_Trait(Tabs),
	using t_styled_ext: ^Styled_Ext_Trait(Tabs),
	using t_styled: ^Styled_Trait(Tabs),
	using t_parent_element: ^Parent_Element_Trait(Tabs),
	using t_interactive_element: ^Interactive_Element_Trait(Tabs),
	using t_stateful_interactive_element: ^Stateful_Interactive_Element_Trait(Tabs),
	// The direction the tabs run: horizontal (Left/Right, the default) or vertical (Up/Down).
	// Assistive technology hears the same orientation.
	axis: proc(e: Tabs, axis: Axis) -> Tabs,
}

tabs :: proc(id: Id, flags: ..Style_Flag, loc := #caller_location) -> Tabs {
	use_base_tabs()
	e := Tabs{new_node(400, loc), &tabs_vt}
	o := node_args()
	put_id(o, id)
	tokens(e.el, flags)
	return e
}

@(private)
tabs_vt := Tabs_VT {
	t_element_ext = cast(^Element_Ext_Trait(Tabs))&element_ext_any,
	t_logical_styled_ext = cast(^Logical_Styled_Ext_Trait(Tabs))&logical_styled_ext_any,
	t_styled_ext = cast(^Styled_Ext_Trait(Tabs))&styled_ext_any,
	t_styled = cast(^Styled_Trait(Tabs))&styled_any,
	t_parent_element = cast(^Parent_Element_Trait(Tabs))&parent_element_any,
	t_interactive_element = cast(^Interactive_Element_Trait(Tabs))&interactive_element_any,
	t_stateful_interactive_element = cast(^Stateful_Interactive_Element_Trait(Tabs))&stateful_interactive_element_any,
	axis = proc(e: Tabs, axis: Axis) -> Tabs {
		o := op(e.el, 256)
		put_u16(o, u16(axis))
		return e
	},
}

// A text view that can render Markdown or HTML.
//
// Goals:
// - Provide a rich text rendering component for such as Markdown or HTML, used to display rich
//   text in GPUI application (e.g., Help messages, Release notes)
// - Support Markdown GFM and HTML (Simple HTML like Safari Reader Mode) for showing most common
//   used markups.
// - Support Heading, Paragraph, Bold, Italic, StrikeThrough, Code, Link, Image, Blockquote,
//   List, Table, HorizontalRule, CodeBlock ...
//
// Not Goals:
// - Customization of the complex style (some simple styles will be supported)
// - As a Markdown editor or viewer (If you want to like this, you must fork your version).
// - As a HTML viewer, we not support CSS, we only support basic HTML tags for used to as a
//   content reader.
//
// See also `MarkdownElement`, `HtmlElement`
//
// Base_Text_View is gpui_kit::base::TextView.
Base_Text_View :: struct {
	using el: Element,
	using vt: ^Base_Text_View_VT,
}

Base_Text_View_VT :: struct {
	using t_logical_styled_ext: ^Logical_Styled_Ext_Trait(Base_Text_View),
	using t_styled_ext: ^Styled_Ext_Trait(Base_Text_View),
	aspect_ratio: proc(e: Base_Text_View, ratio: f32) -> Base_Text_View,
	bg: proc(e: Base_Text_View, fill: Fill) -> Base_Text_View,
	border: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	border_b: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	border_color: proc(e: Base_Text_View, border_color: Color) -> Base_Text_View,
	border_l: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	border_r: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	border_t: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	border_x: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	border_y: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	bottom: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	col_end: proc(e: Base_Text_View, end: i16) -> Base_Text_View,
	col_span: proc(e: Base_Text_View, span: u16) -> Base_Text_View,
	col_start: proc(e: Base_Text_View, start: i16) -> Base_Text_View,
	cursor: proc(e: Base_Text_View, cursor: Cursor_Style) -> Base_Text_View,
	flex_basis: proc(e: Base_Text_View, basis: Length) -> Base_Text_View,
	flex_grow: proc(e: Base_Text_View, grow: f32) -> Base_Text_View,
	flex_shrink: proc(e: Base_Text_View, shrink: f32) -> Base_Text_View,
	font: proc(e: Base_Text_View, font: Font) -> Base_Text_View,
	font_family: proc(e: Base_Text_View, family_name: string) -> Base_Text_View,
	font_features: proc(e: Base_Text_View, features: Font_Features) -> Base_Text_View,
	font_weight: proc(e: Base_Text_View, weight: Font_Weight) -> Base_Text_View,
	gap: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	gap_x: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	gap_y: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	grid_cols: proc(e: Base_Text_View, cols: u16) -> Base_Text_View,
	grid_cols_max_content: proc(e: Base_Text_View, cols: u16) -> Base_Text_View,
	grid_cols_min_content: proc(e: Base_Text_View, cols: u16) -> Base_Text_View,
	grid_rows: proc(e: Base_Text_View, rows: u16) -> Base_Text_View,
	grid_rows_max_content: proc(e: Base_Text_View, rows: u16) -> Base_Text_View,
	grid_rows_min_content: proc(e: Base_Text_View, rows: u16) -> Base_Text_View,
	h: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	inset: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	left: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	line_clamp: proc(e: Base_Text_View, lines: int) -> Base_Text_View,
	line_height: proc(e: Base_Text_View, line_height: Length) -> Base_Text_View,
	m: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	max_h: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	max_size: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	max_w: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	mb: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	min_h: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	min_size: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	min_w: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	ml: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	mr: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	mt: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	mx: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	my: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	opacity: proc(e: Base_Text_View, opacity: f32) -> Base_Text_View,
	p: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	pb: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	pl: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	pr: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	pt: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	px: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	py: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	right: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	rounded: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	rounded_b: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	rounded_bl: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	rounded_br: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	rounded_l: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	rounded_r: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	rounded_t: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	rounded_tl: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	rounded_tr: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	row_end: proc(e: Base_Text_View, end: i16) -> Base_Text_View,
	row_span: proc(e: Base_Text_View, span: u16) -> Base_Text_View,
	row_start: proc(e: Base_Text_View, start: i16) -> Base_Text_View,
	scrollbar_width: proc(e: Base_Text_View, width: Length) -> Base_Text_View,
	shadow: proc(e: Base_Text_View, shadows: []Box_Shadow) -> Base_Text_View,
	size: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	text_align: proc(e: Base_Text_View, align: Text_Align) -> Base_Text_View,
	text_bg: proc(e: Base_Text_View, bg: Color) -> Base_Text_View,
	text_color: proc(e: Base_Text_View, color: Color) -> Base_Text_View,
	text_decoration_color: proc(e: Base_Text_View, color: Color) -> Base_Text_View,
	text_overflow: proc(e: Base_Text_View, overflow: Text_Overflow) -> Base_Text_View,
	text_size: proc(e: Base_Text_View, size: Length) -> Base_Text_View,
	top: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	w: proc(e: Base_Text_View, length: Length) -> Base_Text_View,
	// Refines blockquotes over the resolved style. See `->with_blockquote_style` for where it applies.
	// Unspecified properties are inherited.
	blockquote_style: proc(e: Base_Text_View, style: Style_Refinement) -> Base_Text_View,
	// Set custom block actions for code blocks.
	//
	// The closure receives the `Base_Code_Block`, and returns an element to display.
	code_block_actions: proc(e: Base_Text_View, f: Row_Source) -> Base_Text_View, // gk.items(cx, state, proc(s: ^S, cx: ^Cx, code_block: Code_Block) -> Element)
	// Adds opt-in syntax highlighting for fenced code blocks.
	//
	// Returned byte ranges are relative to `code`. Invalid ranges are discarded. Without this
	// callback, code is unhighlighted.
	code_block_highlighter: proc(e: Base_Text_View, highlighter: Ask(Code_Block, []Tuple_Range_Highlight_Style)) -> Base_Text_View,
	// Overrides the source of every document image, including embedded data URLs.
	//
	// Used for both rendering and intrinsic-size measurement. The returned source is authoritative:
	// pending or failed loads never fall back to the document URL. Without this override, images use
	// Base's default URI and data URL handling.
	image_source: proc(e: Base_Text_View, resolver: Ask(Temp_String, string)) -> Base_Text_View,
	// Refines inline code typography, background, border, radius, and padding over the resolved style.
	// See `->with_inline_code_style` for the supported properties. Unspecified properties are
	// inherited.
	inline_code_style: proc(e: Base_Text_View, style: Style_Refinement) -> Base_Text_View,
	// Show a tooltip that follows the pointer while it is over a link.
	//
	// The builder receives the link's URL. The view caches the tooltip until a different destination
	// is shown.
	link_tooltip: proc(e: Base_Text_View, builder: Row_Source) -> Base_Text_View,
	// Refines list markers over the resolved style. See `->with_list_style` for where it applies.
	// Unspecified properties are inherited.
	list_style: proc(e: Base_Text_View, style: Style_Refinement) -> Base_Text_View,
	// Register a renderer for a custom block-level Markdown node name.
	markdown_block_renderer: proc(e: Base_Text_View, name: string, renderer: Row_Source) -> Base_Text_View, // gk.items(cx, state, proc(s: ^S, cx: ^Cx, markdown_node_read: Markdown_Node_Read) -> Element)
	// Replace the Markdown extension registry.
	markdown_extensions: proc(e: Base_Text_View, extensions: Markdown_Extensions) -> Base_Text_View,
	// Enable MDX JSX/expression parsing.
	//
	// This disables raw HTML parsing because `markdown-rs` gives HTML priority over MDX when both are
	// enabled.
	markdown_mdx: proc(e: Base_Text_View) -> Base_Text_View,
	// Set whether raw HTML in Markdown renders as HTML (the default) or shows as the text it is
	// written as. See `->raw_html`.
	markdown_raw_html: proc(e: Base_Text_View, enabled: bool) -> Base_Text_View,
	// Clamp the rendered content to at most `n` lines of body text.
	//
	// The view's height is capped at `n` × the base line height, and a line of glyphs is never cut in
	// half: a line that would straddle the bottom of the box is left out whole, across paragraphs,
	// lists, headings, code blocks and tables. Nothing is shown with less than a line of itself to
	// show, so the border and padding a table row leads with never strands at the bottom; whatever has
	// more than that is cut on the box edge and keeps the part that fits, rather than disappearing and
	// leaving blank space behind.
	//
	// Check `gk.text_view_state_is_clamped` (which answers for the frame that was last painted) to
	// decide whether to show an "expand" affordance.
	//
	// `n` counts lines of body text, so paragraph spacing and taller lines mean fewer of them fit
	// inside the capped height. A line taller than the whole budget keeps the part that fits rather
	// than emptying the box. Ignored when `->scrollable` is set.
	max_lines: proc(e: Base_Text_View, max_lines: int) -> Base_Text_View,
	// Set the motion policy; see `Text_View_Motion`. Without one, the state's own policy applies,
	// which plays no motion by default.
	motion: proc(e: Base_Text_View, motion: Text_View_Motion) -> Base_Text_View,
	// Handle pointer events on rendered links.
	//
	// The handler receives the resolved URL and the original GPUI click event. Without a handler,
	// links open through App::open_url.
	on_link_click: proc(e: Base_Text_View, handler: Handler) -> Base_Text_View,
	// Scroll a container that does not follow scroll requests to the line of
	// `gk.text_view_state_reveal_range`.
	//
	// A `gpui::list` scrolls to that line by itself; a `div` with `overflow_y_scroll`, for one, does
	// not. After a frame in which the line was laid out but not visible, the handler receives its
	// bounds in window coordinates, to scroll the container, e.g. through its `ScrollHandle`, until
	// the line is visible.
	on_reveal: proc(e: Base_Text_View, handler: Handler) -> Base_Text_View,
	// Make the checkboxes of Markdown task list items (`-  `, `- `x``) clickable.
	//
	// The handler receives a `Task_Toggle_Event` with the checked state the item should now have and
	// where the item and its ` ` / ``x`` marker are in the source text. The view does not change its
	// text: the caller owns the source, replaces the marker and sets the new text. Without a handler,
	// the checkboxes are not interactive.
	on_task_toggle: proc(e: Base_Text_View, handler: Handler) -> Base_Text_View,
	// Apply a reusable text view plugin.
	plugin: proc(e: Base_Text_View, plugin: Markdown_Plugin_Any) -> Base_Text_View,
	// Set the text view to be scrollable, default is false.
	//
	// If true for `scrollable`:
	// The `scrollable` mode used for large content, will show scrollbar, but requires the parent to
	// have a fixed height, and use `list` to render the content in a virtualized way.
	//
	// If false to fit content:
	// The TextView will expand to fit all content, no scrollbar. This mode is suitable for small
	// content, such as a few lines of text, a label, etc.
	scrollable: proc(e: Base_Text_View, scrollable: bool) -> Base_Text_View,
	// Set whether the text view is selectable, default is true.
	//
	// Hovering selectable text shows the I-beam cursor. A cursor set on the text view itself, such as
	// `.cursor_default()`, replaces it: use that for text on a surface that opens on click. Links keep
	// the pointing hand, and the I-beam still shows while a drag selection is in progress.
	selectable: proc(e: Base_Text_View, selectable: bool) -> Base_Text_View,
	// Set the `SelectionFormat`, default is `Plain`.
	//
	// With `Source`, selecting inside `**bold**` yields `**bold**` (the Markdown source) rather than
	// `bold`.
	selection_format: proc(e: Base_Text_View, selection_format: Selection_Format) -> Base_Text_View,
	// Set `Base_Text_View_Style`.
	style: proc(e: Base_Text_View, style: Base_Text_View_Style) -> Base_Text_View,
	// Set custom actions to be rendered below each Markdown table.
	//
	// The closure receives the `TableData`, and returns an element to display.
	table_actions: proc(e: Base_Text_View, f: Row_Source) -> Base_Text_View, // gk.items(cx, state, proc(s: ^S, cx: ^Cx, table_data: Table_Data) -> Element)
}

// Create a new html text view with code location as id.
base_html :: proc(source: string, flags: ..Style_Flag, loc := #caller_location) -> Base_Text_View {
	use_base_text()
	e := Base_Text_View{new_node(408, loc), &base_text_view_vt}
	o := node_args()
	put_str(o, source)
	tokens(e.el, flags)
	return e
}

// Create a new markdown text view with code location as id.
base_markdown :: proc(source: string, flags: ..Style_Flag, loc := #caller_location) -> Base_Text_View {
	use_base_text()
	e := Base_Text_View{new_node(409, loc), &base_text_view_vt}
	o := node_args()
	put_str(o, source)
	tokens(e.el, flags)
	return e
}

// Create new TextView with managed state.
base_text_view :: proc(state: Text_View_State, flags: ..Style_Flag, loc := #caller_location) -> Base_Text_View {
	use_base_text()
	e := Base_Text_View{new_node(407, loc), &base_text_view_vt}
	o := node_args()
	put_u64(o, state.h)
	tokens(e.el, flags)
	return e
}

// Create a new html text view.
base_text_view_html :: proc(id: Id, html: string, flags: ..Style_Flag, loc := #caller_location) -> Base_Text_View {
	use_base_text()
	e := Base_Text_View{new_node(405, loc), &base_text_view_vt}
	o := node_args()
	put_id(o, id)
	put_str(o, html)
	tokens(e.el, flags)
	return e
}

// Create a new markdown text view.
base_text_view_markdown :: proc(id: Id, markdown: string, flags: ..Style_Flag, loc := #caller_location) -> Base_Text_View {
	use_base_text()
	e := Base_Text_View{new_node(406, loc), &base_text_view_vt}
	o := node_args()
	put_id(o, id)
	put_str(o, markdown)
	tokens(e.el, flags)
	return e
}

@(private)
base_text_view_vt := Base_Text_View_VT {
	t_logical_styled_ext = cast(^Logical_Styled_Ext_Trait(Base_Text_View))&logical_styled_ext_any,
	t_styled_ext = cast(^Styled_Ext_Trait(Base_Text_View))&styled_ext_any,
	aspect_ratio = transmute(proc(e: Base_Text_View, ratio: f32) -> Base_Text_View)styled_aspect_ratio,
	bg = transmute(proc(e: Base_Text_View, fill: Fill) -> Base_Text_View)styled_bg,
	border = transmute(proc(e: Base_Text_View, length: Length) -> Base_Text_View)styled_border,
	border_b = transmute(proc(e: Base_Text_View, length: Length) -> Base_Text_View)styled_border_b,
	border_color = transmute(proc(e: Base_Text_View, border_color: Color) -> Base_Text_View)styled_border_color,
	border_l = transmute(proc(e: Base_Text_View, length: Length) -> Base_Text_View)styled_border_l,
	border_r = transmute(proc(e: Base_Text_View, length: Length) -> Base_Text_View)styled_border_r,
	border_t = transmute(proc(e: Base_Text_View, length: Length) -> Base_Text_View)styled_border_t,
	border_x = transmute(proc(e: Base_Text_View, length: Length) -> Base_Text_View)styled_border_x,
	border_y = transmute(proc(e: Base_Text_View, length: Length) -> Base_Text_View)styled_border_y,
	bottom = transmute(proc(e: Base_Text_View, length: Length) -> Base_Text_View)styled_bottom,
