	return e
}

@(private)
link_styles_vt := Link_Styles_VT {
	disabled = proc(e: Link_Styles, build: State_Style) -> Link_Styles {
		o := op(vel(e.nd), 256)
		put_u32(o, take_value(build.nd))
		return e
