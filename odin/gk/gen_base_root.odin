		o := op(vel(e.nd), 256)
		put_u32(o, take_value(build.nd))
		return e
	},
	disabled = proc(e: Radio_Styles, build: State_Style) -> Radio_Styles {
		o := op(vel(e.nd), 257)
		put_u32(o, take_value(build.nd))
		return e
	},
}

// A resizable panel inside a `Resizable_Panel_Group`.
//
// Implements `Styled`, so call sites can override the panel's rendered styles. User overrides are
// applied **between** the panel's flex defaults and its size management — the caller can override
// the internal `flex_grow: 1` (e.g. via `.flex_none()`) and add their own padding / colors /
// borders, while the panel's runtime size constraints (`min_w`/`max_w`/`flex_basis` driven by
// `ResizableState`) always win.
//
// A common override is `.flex_none()`: the panel sets `flex_grow: 1` internally, so a sized panel
// that should hold its width when a sibling collapses needs to opt out of growth via
// `.flex_none()`.
//
// To keep a panel's size when the group's container resizes, use `->fixed`.
//
// **Reserved styles**: do not call these from outside — they fight the panel's own layout
// management: - `.flex_basis(...)` — driven by `ResizableState`, not by the caller. -
// `.absolute()` — would remove the panel from the resizable's flex flow. - `.overflow_hidden()` —
// may clip the resize handle, which is positioned absolute at `left: -4px` of each panel after the
// first.
//
// Resizable_Panel is gpui_kit::base::ResizablePanel.
Resizable_Panel :: struct {
	using el: Element,
	using vt: ^Resizable_Panel_VT,
}

Resizable_Panel_VT :: struct {
	using t_element_ext: ^Element_Ext_Trait(Resizable_Panel),
	using t_logical_styled_ext: ^Logical_Styled_Ext_Trait(Resizable_Panel),
	using t_styled_ext: ^Styled_Ext_Trait(Resizable_Panel),
	aspect_ratio: proc(e: Resizable_Panel, ratio: f32) -> Resizable_Panel,
	bg: proc(e: Resizable_Panel, fill: Fill) -> Resizable_Panel,
	border: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	border_b: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	border_color: proc(e: Resizable_Panel, border_color: Color) -> Resizable_Panel,
	border_l: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	border_r: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	border_t: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	border_x: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	border_y: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	bottom: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	col_end: proc(e: Resizable_Panel, end: i16) -> Resizable_Panel,
	col_span: proc(e: Resizable_Panel, span: u16) -> Resizable_Panel,
	col_start: proc(e: Resizable_Panel, start: i16) -> Resizable_Panel,
	cursor: proc(e: Resizable_Panel, cursor: Cursor_Style) -> Resizable_Panel,
	flex_basis: proc(e: Resizable_Panel, basis: Length) -> Resizable_Panel,
	flex_grow: proc(e: Resizable_Panel, grow: f32) -> Resizable_Panel,
	flex_shrink: proc(e: Resizable_Panel, shrink: f32) -> Resizable_Panel,
	font: proc(e: Resizable_Panel, font: Font) -> Resizable_Panel,
	font_family: proc(e: Resizable_Panel, family_name: string) -> Resizable_Panel,
	font_features: proc(e: Resizable_Panel, features: Font_Features) -> Resizable_Panel,
	font_weight: proc(e: Resizable_Panel, weight: Font_Weight) -> Resizable_Panel,
	gap: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	gap_x: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	gap_y: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	grid_cols: proc(e: Resizable_Panel, cols: u16) -> Resizable_Panel,
	grid_cols_max_content: proc(e: Resizable_Panel, cols: u16) -> Resizable_Panel,
	grid_cols_min_content: proc(e: Resizable_Panel, cols: u16) -> Resizable_Panel,
	grid_rows: proc(e: Resizable_Panel, rows: u16) -> Resizable_Panel,
	grid_rows_max_content: proc(e: Resizable_Panel, rows: u16) -> Resizable_Panel,
	grid_rows_min_content: proc(e: Resizable_Panel, rows: u16) -> Resizable_Panel,
	h: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	inset: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	left: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	line_clamp: proc(e: Resizable_Panel, lines: int) -> Resizable_Panel,
	line_height: proc(e: Resizable_Panel, line_height: Length) -> Resizable_Panel,
	m: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	max_h: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	max_size: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	max_w: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	mb: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	min_h: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	min_size: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	min_w: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	ml: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	mr: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	mt: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	mx: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	my: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	opacity: proc(e: Resizable_Panel, opacity: f32) -> Resizable_Panel,
	p: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	pb: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	pl: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	pr: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	pt: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	px: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	py: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	right: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	rounded: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	rounded_b: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	rounded_bl: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	rounded_br: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	rounded_l: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	rounded_r: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	rounded_t: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	rounded_tl: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	rounded_tr: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	row_end: proc(e: Resizable_Panel, end: i16) -> Resizable_Panel,
	row_span: proc(e: Resizable_Panel, span: u16) -> Resizable_Panel,
	row_start: proc(e: Resizable_Panel, start: i16) -> Resizable_Panel,
	scrollbar_width: proc(e: Resizable_Panel, width: Length) -> Resizable_Panel,
	shadow: proc(e: Resizable_Panel, shadows: []Box_Shadow) -> Resizable_Panel,
	text_align: proc(e: Resizable_Panel, align: Text_Align) -> Resizable_Panel,
	text_bg: proc(e: Resizable_Panel, bg: Color) -> Resizable_Panel,
	text_color: proc(e: Resizable_Panel, color: Color) -> Resizable_Panel,
	text_decoration_color: proc(e: Resizable_Panel, color: Color) -> Resizable_Panel,
	text_overflow: proc(e: Resizable_Panel, overflow: Text_Overflow) -> Resizable_Panel,
	text_size: proc(e: Resizable_Panel, size: Length) -> Resizable_Panel,
	top: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	w: proc(e: Resizable_Panel, length: Length) -> Resizable_Panel,
	style: proc(e: Resizable_Panel, flags: ..Style_Flag) -> Resizable_Panel,
	using t_parent_element: ^Parent_Element_Trait(Resizable_Panel),
	// Keep this panel's size when the group's container resizes.
	//
	// When the container grows or shrinks, the other panels share the difference in proportion to
	// their sizes, so a sidebar or an inspector keeps the width the user gave it. Dragging its own
	// handle still resizes it. It needs a `->size`, and at least one panel in the group should not be
	// fixed.
	fixed: proc(e: Resizable_Panel) -> Resizable_Panel,
	// Set the initial size of the panel.
	size: proc(e: Resizable_Panel, size: f32) -> Resizable_Panel,
	// Set the size range to limit panel resize.
	//
	// Default is `PANEL_MIN_SIZE` to `MAX`.
	size_range: proc(e: Resizable_Panel, range: [2]f32) -> Resizable_Panel,
	// Set the visibility of the panel, default is true.
	visible: proc(e: Resizable_Panel, visible: bool) -> Resizable_Panel,
}

// Create a `Resizable_Panel`.
resizable_panel :: proc(flags: ..Style_Flag, loc := #caller_location) -> Resizable_Panel {
	use_base_resizable()
	e := Resizable_Panel{new_node(361, loc), &resizable_panel_vt}
	tokens(e.el, flags)
	return e
}

