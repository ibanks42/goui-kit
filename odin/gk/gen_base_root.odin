// A physical spring policy for `->spring`.
//
// A spring is the counterpart to `Transition` for values that can be retargeted while they are
// still moving. A duration-based transition restarts its easing from the value sampled at that
// instant, which is continuous in position but not in velocity. A spring carries velocity across
// the retarget, so a value reversed mid-flight decelerates and turns around instead of snapping to
// a new curve's initial speed.
//
// Spring is gpui_kit::base::Spring.
Spring :: struct {
	using nd: Value,
	using vt: ^Spring_VT,
}

Spring_VT :: struct {
	// Sets the damping ratio, which is `1.0` — no overshoot — by default.
	//
	// Below `1.0` the spring passes its target and comes back; above `1.0` it approaches slowly.
	// Overshoot suits a value with room to pass its target and nothing to collide with. A height, an
	// opacity, or anything bounded by the geometry around it should stay at the default.
	//
	// This is $\zeta$, not GPUI's `SpringConfig::damping`, which is the coefficient $c = 2 \zeta
	// \omega_0$.
	//
	// Panics:
	// Panics when `ratio` is negative or non-finite. Use `try_with_damping` when the value is not a
	// trusted constant.
	with_damping: proc(e: Spring, ratio: f32) -> Spring,
	// Sets the settling tolerance, expressed in the target's own units.
	//
	// The default suits targets that move within a normalized `0..1` range. A spring over pixels
	// settles perceptibly sooner with a coarser tolerance, which also ends the animation frames that
	// the remaining sub-pixel motion would otherwise request.
	//
	// Panics:
	// Panics when `epsilon` is zero, negative, or non-finite. Use `try_with_epsilon` when the value is
	// not a trusted constant.
	with_epsilon: proc(e: Spring, epsilon: f32) -> Spring,
	// Sets whether the spring travels to its target or adopts it on the spot.
	//
	// A value the pointer is already moving — a panel being dragged by its resize handle — must not
	// lag behind the pointer, so the spring stops travelling for as long as the drag lasts. Retained
	// state stays pinned to the target meanwhile, so travel resumes from the value the drag released
	// rather than from wherever the spring was when it began.
	//
	// This says at the call that the motion is suspended, and it says it without disturbing the
	// response, damping or tolerance the spring is configured with — which a policy swapped out for
	// the length of the drag would have to restate or discard.
	with_travel: proc(e: Spring, travel: bool) -> Spring,
}

// The spring a hover pointer — the crosshair, highlight band or hover dot — follows the hovered
// datum with: the active `Plot_Motion`'s pointer, which snaps unless a styled layer projects one.
pointer_spring :: proc(loc := #caller_location) -> Spring {
	e := Spring{new_value(383, loc), &spring_vt}
	return e
}

// Builds a spring that reaches its target in about `response` without overshooting it.
//
// `response` is not a duration in the sense `gk.transition` means one. A spring has no end to
// schedule: this is the period one full oscillation would take without damping, which is the scale
// the motion is felt at rather than the moment it stops. The remaining fraction of a percent keeps
// settling past it, until it is within the tolerance `->with_epsilon` sets.
//
// A zero response adopts the target on the spot, as a zero duration does for a transition. Say
// that with `->with_travel` where it is what you mean; a zero here is the degenerate case, defined
// so an infinitely stiff spring resolves rather than dividing by its own period.
spring :: proc(response: time.Duration, loc := #caller_location) -> Spring {
	e := Spring{new_value(382, loc), &spring_vt}
	o := node_args()
	put_ms(o, i64(response))
	return e
}

@(private)
spring_vt := Spring_VT {
	with_damping = proc(e: Spring, ratio: f32) -> Spring {
		o := op(vel(e.nd), 256)
		put_f32(o, ratio)
		return e
	},
	with_epsilon = proc(e: Spring, epsilon: f32) -> Spring {
		o := op(vel(e.nd), 257)
		put_f32(o, epsilon)
		return e
	},
	with_travel = proc(e: Spring, travel: bool) -> Spring {
		o := op(vel(e.nd), 258)
		put_u8(o, u8(travel))
		return e
	},
}

// A semantic-state style builder.
//
// Visual modifiers come from GPUI's `Styled` trait. Unlike a bare `StyleRefinement`, this wrapper
// also supports `FluentBuilder` helpers such as `when`, `when_some`, and `when_none`.
//
// State_Style is gpui_kit::base::StateStyle.
State_Style :: struct {
	using nd: Value,
	using vt: ^State_Style_VT,
}

State_Style_VT :: struct {
	using t_logical_styled_ext: ^Logical_Styled_Ext_Trait(State_Style),
	using t_styled_ext: ^Styled_Ext_Trait(State_Style),
	using t_styled: ^Styled_Trait(State_Style),
}

state_style_default :: proc(flags: ..Style_Flag, loc := #caller_location) -> State_Style {
	e := State_Style{new_value(384, loc), &state_style_vt}
	tokens(vel(e.nd), flags)
	return e
}

@(private)
state_style_vt := State_Style_VT {
	t_logical_styled_ext = cast(^Logical_Styled_Ext_Trait(State_Style))&logical_styled_ext_any,
	t_styled_ext = cast(^Styled_Ext_Trait(State_Style))&styled_ext_any,
	t_styled = cast(^Styled_Trait(State_Style))&styled_any,
}

// An unstyled binary control that owns switch interaction and semantics.
//
// The checked value is controlled by the application. Activation reports the next value through
// `->on_change`; the application must render that value back through `->checked`. Children and all
// visual states remain application-owned.
//
// Base_Switch is gpui_kit::base::Switch.
Base_Switch :: struct {
	using el: Element,
	using vt: ^Base_Switch_VT,
}

Base_Switch_VT :: struct {
	using t_element_ext: ^Element_Ext_Trait(Base_Switch),
	using t_logical_styled_ext: ^Logical_Styled_Ext_Trait(Base_Switch),
	using t_styled_ext: ^Styled_Ext_Trait(Base_Switch),
	using t_styled: ^Styled_Trait(Base_Switch),
	using t_parent_element: ^Parent_Element_Trait(Base_Switch),
	block_mouse_except_scroll: proc(e: Base_Switch) -> Base_Switch,
	can_drop: proc(e: Base_Switch, predicate: Drop_Accept) -> Base_Switch,
	capture_action: proc(e: Base_Switch, listener: Action_Handler) -> Base_Switch,
	capture_any_mouse_down: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	capture_any_mouse_up: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	capture_key_down: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	capture_key_up: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	capture_mouse_pressure: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	capture_pinch: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	drag_over: proc(e: Base_Switch, f: Style_Refinement) -> Base_Switch,
	focus: proc(e: Base_Switch, f: Style_Refinement) -> Base_Switch,
	focus_visible: proc(e: Base_Switch, f: Style_Refinement) -> Base_Switch,
	group: proc(e: Base_Switch, group: string) -> Base_Switch,
	group_drag_over: proc(e: Base_Switch, group_name: string, f: Style_Refinement) -> Base_Switch,
	group_hover: proc(e: Base_Switch, group_name: string, f: Style_Refinement) -> Base_Switch,
	hover: proc(e: Base_Switch, f: Style_Refinement) -> Base_Switch,
	in_focus: proc(e: Base_Switch, f: Style_Refinement) -> Base_Switch,
	key_context: proc(e: Base_Switch, key_context: string) -> Base_Switch,
	occlude: proc(e: Base_Switch) -> Base_Switch,
	on_action: proc(e: Base_Switch, listener: Action_Handler) -> Base_Switch,
	on_any_mouse_down: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	on_back_gesture: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	on_boxed_action: proc(e: Base_Switch, action: Action, listener: Handler) -> Base_Switch,
	on_drag_move: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	on_drop: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	on_file_drop_exit: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	on_key_down: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	on_key_up: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	on_modifiers_changed: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	on_mouse_down: proc(e: Base_Switch, button: Mouse_Button, listener: Handler) -> Base_Switch,
	on_mouse_down_out: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	on_mouse_exit: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	on_mouse_move: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	on_mouse_pressure: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	on_mouse_up: proc(e: Base_Switch, button: Mouse_Button, listener: Handler) -> Base_Switch,
	on_mouse_up_out: proc(e: Base_Switch, button: Mouse_Button, listener: Handler) -> Base_Switch,
	on_pinch: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	on_scroll: proc(e: Base_Switch, listener: Handler) -> Base_Switch,
	tab_group: proc(e: Base_Switch) -> Base_Switch,
	window_control_area: proc(e: Base_Switch, area: Window_Control_Area) -> Base_Switch,
	using t_stateful_interactive_element: ^Stateful_Interactive_Element_Trait(Base_Switch),
	// Sets the name exposed to accessibility clients.
	//
	// A switch without text children has no accessible name, so set this whenever it is drawn without
	// visible text.
	accessibility_label: proc(e: Base_Switch, label: string) -> Base_Switch,
	// Sets the application-controlled checked value.
	checked: proc(e: Base_Switch, checked: bool) -> Base_Switch,
	// Sets whether pointer and keyboard activation are ignored.
	disabled: proc(e: Base_Switch, disabled: bool) -> Base_Switch,
	// Handles activation with the next checked value and its input event.
	on_change: proc(e: Base_Switch, handler: Handler) -> Base_Switch,
	// Configures application-owned styles for the switch's semantic states.
	styles: proc(e: Base_Switch, build: Switch_Styles) -> Base_Switch,
	// Sets the focus traversal index. Use this within a GPUI tab group.
	tab_index: proc(e: Base_Switch, tab_index: int) -> Base_Switch,
	// Sets whether the switch participates in keyboard focus traversal.
	tab_stop: proc(e: Base_Switch, tab_stop: bool) -> Base_Switch,
	// Uses a caller-owned focus handle instead of creating keyed state.
	track_focus: proc(e: Base_Switch, focus_handle: Focus_Handle) -> Base_Switch,
}

base_switch :: proc(id: Id, flags: ..Style_Flag, loc := #caller_location) -> Base_Switch {
	use_base_switch()
	e := Base_Switch{new_node(385, loc), &base_switch_vt}
	o := node_args()
	put_id(o, id)
	tokens(e.el, flags)
	return e
}

@(private)
base_switch_vt := Base_Switch_VT {
	t_element_ext = cast(^Element_Ext_Trait(Base_Switch))&element_ext_any,
	t_logical_styled_ext = cast(^Logical_Styled_Ext_Trait(Base_Switch))&logical_styled_ext_any,
	t_styled_ext = cast(^Styled_Ext_Trait(Base_Switch))&styled_ext_any,
	t_styled = cast(^Styled_Trait(Base_Switch))&styled_any,
	t_parent_element = cast(^Parent_Element_Trait(Base_Switch))&parent_element_any,
	block_mouse_except_scroll = transmute(proc(e: Base_Switch) -> Base_Switch)interactive_element_block_mouse_except_scroll,
	can_drop = transmute(proc(e: Base_Switch, predicate: Drop_Accept) -> Base_Switch)interactive_element_can_drop,
	capture_action = transmute(proc(e: Base_Switch, listener: Action_Handler) -> Base_Switch)interactive_element_capture_action,
	capture_any_mouse_down = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_capture_any_mouse_down,
	capture_any_mouse_up = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_capture_any_mouse_up,
	capture_key_down = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_capture_key_down,
	capture_key_up = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_capture_key_up,
	capture_mouse_pressure = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_capture_mouse_pressure,
	capture_pinch = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_capture_pinch,
	drag_over = transmute(proc(e: Base_Switch, f: Style_Refinement) -> Base_Switch)interactive_element_drag_over,
	focus = transmute(proc(e: Base_Switch, f: Style_Refinement) -> Base_Switch)interactive_element_focus,
	focus_visible = transmute(proc(e: Base_Switch, f: Style_Refinement) -> Base_Switch)interactive_element_focus_visible,
	group = transmute(proc(e: Base_Switch, group: string) -> Base_Switch)interactive_element_group,
	group_drag_over = transmute(proc(e: Base_Switch, group_name: string, f: Style_Refinement) -> Base_Switch)interactive_element_group_drag_over,
	group_hover = transmute(proc(e: Base_Switch, group_name: string, f: Style_Refinement) -> Base_Switch)interactive_element_group_hover,
	hover = transmute(proc(e: Base_Switch, f: Style_Refinement) -> Base_Switch)interactive_element_hover,
	in_focus = transmute(proc(e: Base_Switch, f: Style_Refinement) -> Base_Switch)interactive_element_in_focus,
	key_context = transmute(proc(e: Base_Switch, key_context: string) -> Base_Switch)interactive_element_key_context,
	occlude = transmute(proc(e: Base_Switch) -> Base_Switch)interactive_element_occlude,
	on_action = transmute(proc(e: Base_Switch, listener: Action_Handler) -> Base_Switch)interactive_element_on_action,
	on_any_mouse_down = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_on_any_mouse_down,
	on_back_gesture = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_on_back_gesture,
	on_boxed_action = transmute(proc(e: Base_Switch, action: Action, listener: Handler) -> Base_Switch)interactive_element_on_boxed_action,
	on_drag_move = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_on_drag_move,
	on_drop = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_on_drop,
	on_file_drop_exit = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_on_file_drop_exit,
	on_key_down = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_on_key_down,
	on_key_up = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_on_key_up,
	on_modifiers_changed = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_on_modifiers_changed,
	on_mouse_down = transmute(proc(e: Base_Switch, button: Mouse_Button, listener: Handler) -> Base_Switch)interactive_element_on_mouse_down,
	on_mouse_down_out = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_on_mouse_down_out,
	on_mouse_exit = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_on_mouse_exit,
	on_mouse_move = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_on_mouse_move,
	on_mouse_pressure = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_on_mouse_pressure,
	on_mouse_up = transmute(proc(e: Base_Switch, button: Mouse_Button, listener: Handler) -> Base_Switch)interactive_element_on_mouse_up,
	on_mouse_up_out = transmute(proc(e: Base_Switch, button: Mouse_Button, listener: Handler) -> Base_Switch)interactive_element_on_mouse_up_out,
	on_pinch = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_on_pinch,
	on_scroll = transmute(proc(e: Base_Switch, listener: Handler) -> Base_Switch)interactive_element_on_scroll,
	tab_group = transmute(proc(e: Base_Switch) -> Base_Switch)interactive_element_tab_group,
	window_control_area = transmute(proc(e: Base_Switch, area: Window_Control_Area) -> Base_Switch)interactive_element_window_control_area,
	t_stateful_interactive_element = cast(^Stateful_Interactive_Element_Trait(Base_Switch))&stateful_interactive_element_any,
	accessibility_label = proc(e: Base_Switch, label: string) -> Base_Switch {
		o := op(e.el, 256)
		put_str(o, label)
		return e
	},
	checked = proc(e: Base_Switch, checked: bool) -> Base_Switch {
		o := op(e.el, 257)
		put_u8(o, u8(checked))
		return e
	},
	disabled = proc(e: Base_Switch, disabled: bool) -> Base_Switch {
		o := op(e.el, 258)
		put_u8(o, u8(disabled))
		return e
	},
	on_change = proc(e: Base_Switch, handler: Handler) -> Base_Switch {
		o := op(e.el, 259)
		put_u32(o, register(handler, 65))
		return e
	},
	styles = proc(e: Base_Switch, build: Switch_Styles) -> Base_Switch {
		o := op(e.el, 260)
		put_u32(o, take_value(build.nd))
		return e
	},
	tab_index = proc(e: Base_Switch, tab_index: int) -> Base_Switch {
		o := op(e.el, 261)
		put_u64(o, u64(tab_index))
		return e
	},
	tab_stop = proc(e: Base_Switch, tab_stop: bool) -> Base_Switch {
		o := op(e.el, 262)
		put_u8(o, u8(tab_stop))
		return e
	},
	track_focus = proc(e: Base_Switch, focus_handle: Focus_Handle) -> Base_Switch {
		o := op(e.el, 263)
		put_u64(o, focus_handle.h)
		return e
	},
}

