	capture_any_mouse_up: proc(e: Base_Checkbox, listener: Handler) -> Base_Checkbox,
	capture_key_down: proc(e: Base_Checkbox, listener: Handler) -> Base_Checkbox,
	capture_key_up: proc(e: Base_Checkbox, listener: Handler) -> Base_Checkbox,
	capture_mouse_pressure: proc(e: Base_Checkbox, listener: Handler) -> Base_Checkbox,
	capture_pinch: proc(e: Base_Checkbox, listener: Handler) -> Base_Checkbox,
	drag_over: proc(e: Base_Checkbox, f: Style_Refinement) -> Base_Checkbox,
	focus: proc(e: Base_Checkbox, f: Style_Refinement) -> Base_Checkbox,
	focus_visible: proc(e: Base_Checkbox, f: Style_Refinement) -> Base_Checkbox,
	group: proc(e: Base_Checkbox, group: string) -> Base_Checkbox,
	group_drag_over: proc(e: Base_Checkbox, group_name: string, f: Style_Refinement) -> Base_Checkbox,
	group_hover: proc(e: Base_Checkbox, group_name: string, f: Style_Refinement) -> Base_Checkbox,
	hover: proc(e: Base_Checkbox, f: Style_Refinement) -> Base_Checkbox,
	in_focus: proc(e: Base_Checkbox, f: Style_Refinement) -> Base_Checkbox,
	key_context: proc(e: Base_Checkbox, key_context: string) -> Base_Checkbox,
