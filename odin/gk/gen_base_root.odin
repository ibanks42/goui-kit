	track_scroll = transmute(proc(e: Base_Button, scroll_handle: Scroll_Handle) -> Base_Button)stateful_interactive_element_track_scroll,
	accessibility_label = proc(e: Base_Button, label: string) -> Base_Button {
		o := op(e.el, 256)
		put_str(o, label)
		return e
	},
	disabled = proc(e: Base_Button, disabled: bool) -> Base_Button {
		o := op(e.el, 257)
		put_u8(o, u8(disabled))
		return e
	},
	focusable = proc(e: Base_Button, focusable: bool) -> Base_Button {
		o := op(e.el, 258)
		put_u8(o, u8(focusable))
		return e
	},
	on_click = proc(e: Base_Button, handler: Handler) -> Base_Button {
		o := op(e.el, 259)
		put_u32(o, register(handler, 1))
		return e
	},
	role = proc(e: Base_Button, role: Role_Override) -> Base_Button {
		o := op(e.el, 260)
		put_Role_Override(o, role)
		return e
	},
	selected = proc(e: Base_Button, selected: bool) -> Base_Button {
		o := op(e.el, 261)
		put_u8(o, u8(selected))
		return e
	},
	styles = proc(e: Base_Button, build: Button_Styles) -> Base_Button {
		o := op(e.el, 262)
		put_u32(o, take_value(build.nd))
		return e
	},
	tab_index = proc(e: Base_Button, tab_index: int) -> Base_Button {
		o := op(e.el, 263)
		put_u64(o, u64(tab_index))
		return e
	},
	tab_stop = proc(e: Base_Button, tab_stop: bool) -> Base_Button {
		o := op(e.el, 264)
		put_u8(o, u8(tab_stop))
		return e
	},
	track_focus = proc(e: Base_Button, focus_handle: Focus_Handle) -> Base_Button {
		o := op(e.el, 265)
		put_u64(o, focus_handle.h)
		return e
	},
}

// Semantic styles supported by `Base_Button`.
//
// Button_Styles is gpui_kit::base::ButtonStyles.
Button_Styles :: struct {
	using nd: Value,
	using vt: ^Button_Styles_VT,
}

Button_Styles_VT :: struct {
	// Refines the root style when the button is disabled.
	disabled: proc(e: Button_Styles, build: State_Style) -> Button_Styles,
	// Refines the root style when the button is selected.
	selected: proc(e: Button_Styles, build: State_Style) -> Button_Styles,
}

button_styles_default :: proc(loc := #caller_location) -> Button_Styles {
	e := Button_Styles{new_value(290, loc), &button_styles_vt}
	return e
}

@(private)
button_styles_vt := Button_Styles_VT {
	disabled = proc(e: Button_Styles, build: State_Style) -> Button_Styles {
		o := op(vel(e.nd), 256)
		put_u32(o, take_value(build.nd))
		return e
	},
	selected = proc(e: Button_Styles, build: State_Style) -> Button_Styles {
		o := op(vel(e.nd), 257)
		put_u32(o, take_value(build.nd))
		return e
	},
}

// Complete unstyled calendar structure and behavior.
//
// Base owns navigation, view switching, grids, disabled/selection state and click handling.
//
// Base_Calendar is gpui_kit::base::Calendar.
Base_Calendar :: struct {
	using el: Element,
	using vt: ^Base_Calendar_VT,
}

Base_Calendar_VT :: struct {
	using t_logical_styled_ext: ^Logical_Styled_Ext_Trait(Base_Calendar),
	using t_styled_ext: ^Styled_Ext_Trait(Base_Calendar),
	using t_styled: ^Styled_Trait(Base_Calendar),
	first_day_of_week: proc(e: Base_Calendar, day: Weekday) -> Base_Calendar,
	item: proc(e: Base_Calendar, render: Row_Source) -> Base_Calendar, // gk.items(cx, state, proc(s: ^S, cx: ^Cx, calendar_item: Calendar_Item, base_calendar_item_state: Base_Calendar_Item_State) -> Element)
	label: proc(e: Base_Calendar, label: Ask(Tuple_Calendar_Item_Kind_I32, string)) -> Base_Calendar,
	number_of_months: proc(e: Base_Calendar, count: int) -> Base_Calendar,
}

base_calendar :: proc(id: Id, state: Calendar_State, flags: ..Style_Flag, loc := #caller_location) -> Base_Calendar {
	use_base_calendar()
	e := Base_Calendar{new_node(291, loc), &base_calendar_vt}
	o := node_args()
	put_id(o, id)
	put_u64(o, state.h)
	tokens(e.el, flags)
	return e
}

@(private)
base_calendar_vt := Base_Calendar_VT {
	t_logical_styled_ext = cast(^Logical_Styled_Ext_Trait(Base_Calendar))&logical_styled_ext_any,
	t_styled_ext = cast(^Styled_Ext_Trait(Base_Calendar))&styled_ext_any,
	t_styled = cast(^Styled_Trait(Base_Calendar))&styled_any,
	first_day_of_week = proc(e: Base_Calendar, day: Weekday) -> Base_Calendar {
		o := op(e.el, 257)
		put_weekday(o, day)
		return e
	},
	item = proc(e: Base_Calendar, render: Row_Source) -> Base_Calendar {
		o := op(e.el, 259)
		put_u64(o, items_check(render, 1))
		return e
	},
	label = proc(e: Base_Calendar, label: Ask(Tuple_Calendar_Item_Kind_I32, string)) -> Base_Calendar {
		o := op(e.el, 258)
		put_u64(o, label.src.h)
		return e
	},
	number_of_months = proc(e: Base_Calendar, count: int) -> Base_Calendar {
		o := op(e.el, 256)
		put_usize(o, count)
		return e
	},
}

// An unstyled, pre-wired calendar item passed to the item slot.
//
// Calendar_Item is gpui_kit::base::CalendarItem.
Calendar_Item :: struct {
	using el: Element,
	using vt: ^Calendar_Item_VT,
}

Calendar_Item_VT :: struct {
	using t_element_ext: ^Element_Ext_Trait(Calendar_Item),
	using t_logical_styled_ext: ^Logical_Styled_Ext_Trait(Calendar_Item),
	using t_styled_ext: ^Styled_Ext_Trait(Calendar_Item),
	using t_parent_element: ^Parent_Element_Trait(Calendar_Item),
	using t_styled: ^Styled_Trait(Calendar_Item),
	using t_interactive_element: ^Interactive_Element_Trait(Calendar_Item),
	using t_stateful_interactive_element: ^Stateful_Interactive_Element_Trait(Calendar_Item),
	// Remove the default label so a styled facade can provide custom content.
	clear_children: proc(e: Calendar_Item) -> Calendar_Item,
}

@(private)
calendar_item_handed :: proc(index: u8, flags: ..Style_Flag, loc := #caller_location) -> Calendar_Item {
	use_base_calendar()
	e := Calendar_Item{new_node(882, loc), &calendar_item_vt}
	o := node_args()
	put_u8(o, u8(index))
	tokens(e.el, flags)
	return e
}

@(private)
calendar_item_vt := Calendar_Item_VT {
	t_element_ext = cast(^Element_Ext_Trait(Calendar_Item))&element_ext_any,
	t_logical_styled_ext = cast(^Logical_Styled_Ext_Trait(Calendar_Item))&logical_styled_ext_any,
	t_styled_ext = cast(^Styled_Ext_Trait(Calendar_Item))&styled_ext_any,
	t_parent_element = cast(^Parent_Element_Trait(Calendar_Item))&parent_element_any,
	t_styled = cast(^Styled_Trait(Calendar_Item))&styled_any,
	t_interactive_element = cast(^Interactive_Element_Trait(Calendar_Item))&interactive_element_any,
	t_stateful_interactive_element = cast(^Stateful_Interactive_Element_Trait(Calendar_Item))&stateful_interactive_element_any,
	clear_children = proc(e: Calendar_Item) -> Calendar_Item {
		op(e.el, 256)
		return e
	},
}

// An unstyled checkbox that owns toggle, focus, keyboard, and accessibility behavior.
//
// The application owns all layout and visual state rendering. Child elements can present the check
// mark, indeterminate mark, label, or any other design-system UI.
//
// Base_Checkbox is gpui_kit::base::Checkbox.
