	aria_max_numeric_value: proc(e: Color_Swatch, value: f64) -> Color_Swatch,
	aria_min_numeric_value: proc(e: Color_Swatch, value: f64) -> Color_Swatch,
	aria_numeric_value: proc(e: Color_Swatch, value: f64) -> Color_Swatch,
	aria_numeric_value_step: proc(e: Color_Swatch, step: f64) -> Color_Swatch,
	aria_placeholder: proc(e: Color_Swatch, placeholder: string) -> Color_Swatch,
	aria_position_in_set: proc(e: Color_Swatch, position: int) -> Color_Swatch,
	aria_row_count: proc(e: Color_Swatch, count: int) -> Color_Swatch,
	aria_row_index: proc(e: Color_Swatch, index: int) -> Color_Swatch,
	aria_selected: proc(e: Color_Swatch, selected: bool) -> Color_Swatch,
	aria_size_of_set: proc(e: Color_Swatch, size: int) -> Color_Swatch,
	aria_value: proc(e: Color_Swatch, value: string) -> Color_Swatch,
	external_drag_payload: proc(e: Color_Swatch, resolver: External_Drag_Payload) -> Color_Swatch,
	focusable: proc(e: Color_Swatch) -> Color_Swatch,
	group_active: proc(e: Color_Swatch, group_name: string, f: Style_Refinement) -> Color_Swatch,
	hover_listener_mode: proc(e: Color_Swatch, mode: Hover_Listener_Mode) -> Color_Swatch,
	hoverable_tooltip: proc(e: Color_Swatch, build_tooltip: View_Or_Tooltip) -> Color_Swatch,
	on_aux_click: proc(e: Color_Swatch, listener: Handler) -> Color_Swatch,
	on_drag: proc(e: Color_Swatch, value: Drag_Value, constructor: View) -> Color_Swatch,
	overflow_scroll: proc(e: Color_Swatch) -> Color_Swatch,
	overflow_x_scroll: proc(e: Color_Swatch) -> Color_Swatch,
	overflow_y_scroll: proc(e: Color_Swatch) -> Color_Swatch,
	restrict_scroll_to_axis: proc(e: Color_Swatch) -> Color_Swatch,
	tooltip: proc(e: Color_Swatch, build_tooltip: View_Or_Tooltip) -> Color_Swatch,
	tooltip_show_delay: proc(e: Color_Swatch, delay: time.Duration) -> Color_Swatch,
	track_scroll: proc(e: Color_Swatch, scroll_handle: Scroll_Handle) -> Color_Swatch,
	// Overrides the accessible name. The default is the color's hex value.
	accessibility_label: proc(e: Color_Swatch, label: string) -> Color_Swatch,
	// Sets whether pointer and keyboard activation are ignored.
	disabled: proc(e: Color_Swatch, disabled: bool) -> Color_Swatch,
	// Handles activation with the swatch's color.
	on_click: proc(e: Color_Swatch, handler: Handler) -> Color_Swatch,
	// Handles hover enter and exit with the swatch's color.
	on_hover: proc(e: Color_Swatch, handler: Handler) -> Color_Swatch,
	// Overrides the accessibility role. The default is `RadioButton`.
	role: proc(e: Color_Swatch, role: Role_Override) -> Color_Swatch,
	// Marks this swatch as the picker's current color.
	selected: proc(e: Color_Swatch, selected: bool) -> Color_Swatch,
	// Sets the focus traversal index. The default is `0`.
	tab_index: proc(e: Color_Swatch, tab_index: int) -> Color_Swatch,
	// Sets whether this swatch participates in keyboard focus traversal.
	tab_stop: proc(e: Color_Swatch, tab_stop: bool) -> Color_Swatch,
}

color_swatch :: proc(id: Id, color: Color, flags: ..Style_Flag, loc := #caller_location) -> Color_Swatch {
	use_base_color_picker()
	e := Color_Swatch{new_node(301, loc), &color_swatch_vt}
	o := node_args()
	put_id(o, id)
	put_color(o, color)
	tokens(e.el, flags)
	return e
}

