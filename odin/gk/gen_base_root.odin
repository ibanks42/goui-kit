	// Supplies the focus handle for the picker trigger.
	track_focus: proc(e: Base_Color_Picker, focus_handle: Focus_Handle) -> Base_Color_Picker,
}

base_color_picker :: proc(id: Id, flags: ..Style_Flag, loc := #caller_location) -> Base_Color_Picker {
	use_base_color_picker()
	e := Base_Color_Picker{new_node(300, loc), &base_color_picker_vt}
	o := node_args()
	put_id(o, id)
	tokens(e.el, flags)
	return e
}

