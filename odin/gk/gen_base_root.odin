	t_stateful_interactive_element = cast(^Stateful_Interactive_Element_Trait(Base_Table))&stateful_interactive_element_any,
	accessibility_label = proc(e: Base_Table, label: string) -> Base_Table {
		o := op(e.el, 256)
		put_str(o, label)
		return e
	},
	column_count = proc(e: Base_Table, count: int) -> Base_Table {
		o := op(e.el, 257)
		put_usize(o, count)
		return e
	},
	row_count = proc(e: Base_Table, count: int) -> Base_Table {
		o := op(e.el, 258)
		put_usize(o, count)
		return e
	},
}

