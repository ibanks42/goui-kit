@(private)
base_popover_vt := Base_Popover_VT {
	t_styled_ext = cast(^Styled_Ext_Trait(Base_Popover))&styled_ext_any,
	t_styled = cast(^Styled_Trait(Base_Popover))&styled_any,
	anchor = proc(e: Base_Popover, anchor: Anchor) -> Base_Popover {
		o := op(e.el, 256)
		put_u16(o, u16(anchor))
		return e
	},
	content = proc(e: Base_Popover, content: Row_Source) -> Base_Popover {
		o := op(e.el, 266)
		put_u64(o, items_check(content, 6))
		return e
	},
	default_open = proc(e: Base_Popover, open: bool) -> Base_Popover {
		o := op(e.el, 257)
		put_u8(o, u8(open))
		return e
	},
	mouse_button = proc(e: Base_Popover, mouse_button: Mouse_Button) -> Base_Popover {
		o := op(e.el, 258)
		put_Mouse_Button(o, mouse_button)
		return e
	},
	offset = proc(e: Base_Popover, offset: f32) -> Base_Popover {
		o := op(e.el, 259)
		put_f32(o, offset)
		return e
	},
	on_open_change = proc(e: Base_Popover, callback: Handler) -> Base_Popover {
		o := op(e.el, 260)
		put_u32(o, register(callback, 4))
		return e
	},
	on_position = proc(e: Base_Popover, callback: Handler) -> Base_Popover {
		o := op(e.el, 265)
		put_u32(o, register(callback, 117))
		return e
	},
	open = proc(e: Base_Popover, open: bool) -> Base_Popover {
		o := op(e.el, 261)
		put_u8(o, u8(open))
		return e
	},
	overlay_closable = proc(e: Base_Popover, closable: bool) -> Base_Popover {
		o := op(e.el, 262)
		put_u8(o, u8(closable))
		return e
	},
	track_focus = proc(e: Base_Popover, handle: Focus_Handle) -> Base_Popover {
		o := op(e.el, 263)
		put_u64(o, handle.h)
		return e
	},
	trigger = proc(e: Base_Popover, trigger: Selectable_Element) -> Base_Popover {
		o := op(e.el, 264)
		{
			oe: Element
			switch x in trigger {
			case Base_Button:
				oe = x.el
			case Button:
				oe = x.el
			case Dropdown_Button:
				oe = x.el
			case Checkbox:
				oe = x.el
			case Input:
				oe = x.el
			case Input_Group_Button:
				oe = x.el
			case List_Item:
				oe = x.el
			case Searchable_List_Item_Element:
				oe = x.el
			case Sidebar_Footer:
				oe = x.el
			case Sidebar_Header:
				oe = x.el
			case Tab:
				oe = x.el
			}
			put_u32(o, take(oe))
		}
		return e
	},
}

