	accessibility_id: proc(e: Color_Swatch, id: string) -> Color_Swatch,
	active: proc(e: Color_Swatch, f: Style_Refinement) -> Color_Swatch,
	anchor_scroll: proc(e: Color_Swatch, scroll_anchor: Maybe(Scroll_Anchor)) -> Color_Swatch,
