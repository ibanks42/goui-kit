		o := op(e.el, 257)
		put_f32(o, offset)
		return e
	},
	placement = proc(e: Tooltip_Positioner, placement: Placement) -> Tooltip_Positioner {
		o := op(e.el, 256)
		put_u16(o, u16(placement))
		return e
	},
}

// Content requested by a tooltip trigger.
//
// Tooltip_Request is gpui_kit::base::TooltipRequest.
Tooltip_Request :: struct {
	using nd: Value,
	using vt: ^Tooltip_Request_VT,
}

Tooltip_Request_VT :: struct {
	// Sets the gap between the trigger and tooltip. Defaults to zero.
	with_offset: proc(e: Tooltip_Request, offset: f32) -> Tooltip_Request,
	// Prefers a side for the tooltip, falling back when it does not fit.
	with_placement: proc(e: Tooltip_Request, placement: Placement) -> Tooltip_Request,
	// Overrides `gk.tooltip_defaults_show_delay` for this trigger.
	with_show_delay: proc(e: Tooltip_Request, delay: time.Duration) -> Tooltip_Request,
}

tooltip_request :: proc(trigger_bounds: Bounds, build: View_Or_Tooltip, loc := #caller_location) -> Tooltip_Request {
	e := Tooltip_Request{new_value(845, loc), &tooltip_request_vt}
	o := node_args()
	put_Bounds(o, trigger_bounds)
	{
		switch x in build {
		case View:
			put_u8(o, 0)
			put_view_arg(o, x)
		case Kit_Tooltip:
			put_u8(o, 1)
			put_u32(o, take_value(x.nd))
		case:
			put_u8(o, 0)
			put_u64(o, 0)
		}
	}
	return e
}

@(private)
tooltip_request_vt := Tooltip_Request_VT {
	with_offset = proc(e: Tooltip_Request, offset: f32) -> Tooltip_Request {
		o := op(vel(e.nd), 258)
		put_f32(o, offset)
		return e
	},
	with_placement = proc(e: Tooltip_Request, placement: Placement) -> Tooltip_Request {
		o := op(vel(e.nd), 256)
		put_u16(o, u16(placement))
		return e
	},
	with_show_delay = proc(e: Tooltip_Request, delay: time.Duration) -> Tooltip_Request {
		o := op(vel(e.nd), 257)
		put_ms(o, i64(delay))
		return e
	},
}

