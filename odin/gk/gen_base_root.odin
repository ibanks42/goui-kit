	using t_styled: ^Styled_Trait(Base_Hover_Card),
	anchor: proc(e: Base_Hover_Card, anchor: Anchor) -> Base_Hover_Card,
	close_delay: proc(e: Base_Hover_Card, duration: time.Duration) -> Base_Hover_Card,
	content: proc(e: Base_Hover_Card, content: Row_Source) -> Base_Hover_Card, // gk.items(cx, state, proc(s: ^S, cx: ^Cx, hover_card_state_reads: Hover_Card_State_Reads) -> Stateful_Div)
	on_open_change: proc(e: Base_Hover_Card, callback: Handler) -> Base_Hover_Card,
	open_delay: proc(e: Base_Hover_Card, duration: time.Duration) -> Base_Hover_Card,
	trigger: proc(e: Base_Hover_Card, trigger: Element) -> Base_Hover_Card,
}

base_hover_card :: proc(id: Id, flags: ..Style_Flag, loc := #caller_location) -> Base_Hover_Card {
