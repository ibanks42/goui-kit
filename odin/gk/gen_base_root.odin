	on_mouse_up = transmute(proc(e: Base_Toggle, button: Mouse_Button, listener: Handler) -> Base_Toggle)interactive_element_on_mouse_up,
	on_mouse_up_out = transmute(proc(e: Base_Toggle, button: Mouse_Button, listener: Handler) -> Base_Toggle)interactive_element_on_mouse_up_out,
	on_pinch = transmute(proc(e: Base_Toggle, listener: Handler) -> Base_Toggle)interactive_element_on_pinch,
	on_scroll = transmute(proc(e: Base_Toggle, listener: Handler) -> Base_Toggle)interactive_element_on_scroll,
	tab_group = transmute(proc(e: Base_Toggle) -> Base_Toggle)interactive_element_tab_group,
	window_control_area = transmute(proc(e: Base_Toggle, area: Window_Control_Area) -> Base_Toggle)interactive_element_window_control_area,
	t_stateful_interactive_element = cast(^Stateful_Interactive_Element_Trait(Base_Toggle))&stateful_interactive_element_any,
	accessibility_label = proc(e: Base_Toggle, label: string) -> Base_Toggle {
		o := op(e.el, 256)
		put_str(o, label)
		return e
	},
	disabled = proc(e: Base_Toggle, disabled: bool) -> Base_Toggle {
		o := op(e.el, 257)
		put_u8(o, u8(disabled))
		return e
	},
	on_change = proc(e: Base_Toggle, handler: Handler) -> Base_Toggle {
		o := op(e.el, 258)
		put_u32(o, register(handler, 65))
		return e
	},
	pressed = proc(e: Base_Toggle, pressed: bool) -> Base_Toggle {
		o := op(e.el, 259)
		put_u8(o, u8(pressed))
		return e
	},
	styles = proc(e: Base_Toggle, build: Toggle_Styles) -> Base_Toggle {
		o := op(e.el, 260)
		put_u32(o, take_value(build.nd))
		return e
	},
	tab_index = proc(e: Base_Toggle, tab_index: int) -> Base_Toggle {
		o := op(e.el, 261)
		put_u64(o, u64(tab_index))
		return e
	},
	tab_stop = proc(e: Base_Toggle, tab_stop: bool) -> Base_Toggle {
		o := op(e.el, 262)
		put_u8(o, u8(tab_stop))
		return e
	},
	track_focus = proc(e: Base_Toggle, focus_handle: Focus_Handle) -> Base_Toggle {
		o := op(e.el, 263)
		put_u64(o, focus_handle.h)
		return e
	},
}

