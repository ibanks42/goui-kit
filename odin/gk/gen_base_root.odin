//
// Base_Table is gpui_kit::base::Table.
Base_Table :: struct {
	using el: Element,
	using vt: ^Base_Table_VT,
}

Base_Table_VT :: struct {
	using t_element_ext: ^Element_Ext_Trait(Base_Table),
