	using t_parent_element: ^Parent_Element_Trait(Base_Date_Picker),
	using t_interactive_element: ^Interactive_Element_Trait(Base_Date_Picker),
	using t_stateful_interactive_element: ^Stateful_Interactive_Element_Trait(Base_Date_Picker),
	disabled: proc(e: Base_Date_Picker, disabled: bool) -> Base_Date_Picker,
	on_open_change: proc(e: Base_Date_Picker, handler: Handler) -> Base_Date_Picker,
	open: proc(e: Base_Date_Picker, open: bool) -> Base_Date_Picker,
}

base_date_picker :: proc(id: Id, focus_handle: Focus_Handle, flags: ..Style_Flag, loc := #caller_location) -> Base_Date_Picker {
