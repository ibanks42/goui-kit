// Markdown_Extensions is gpui_kit::base::MarkdownExtensions.
Markdown_Extensions :: struct {
	using nd: Value,
	using vt: ^Markdown_Extensions_VT,
}

Markdown_Extensions_VT :: struct {
	block_renderer: proc(e: Markdown_Extensions, name: string, renderer: Row_Source) -> Markdown_Extensions, // gk.items(cx, state, proc(s: ^S, cx: ^Cx, markdown_node_read: Markdown_Node_Read) -> Element)
	block_surface: proc(e: Markdown_Extensions, name: string, render: Div) -> Markdown_Extensions,
	frontmatter: proc(e: Markdown_Extensions) -> Markdown_Extensions,
	mdx: proc(e: Markdown_Extensions) -> Markdown_Extensions,
	parser_revision: proc(e: Markdown_Extensions, revision: u64) -> Markdown_Extensions,
	plugin: proc(e: Markdown_Extensions, plugin: Markdown_Plugin_Any) -> Markdown_Extensions,
}

markdown_extensions_default :: proc(loc := #caller_location) -> Markdown_Extensions {
	e := Markdown_Extensions{new_value(336, loc), &markdown_extensions_vt}
	return e
}

@(private)
markdown_extensions_vt := Markdown_Extensions_VT {
	block_renderer = proc(e: Markdown_Extensions, name: string, renderer: Row_Source) -> Markdown_Extensions {
		o := op(vel(e.nd), 259)
		put_str(o, name)
		put_u64(o, items_check(renderer, 4))
		return e
	},
	block_surface = proc(e: Markdown_Extensions, name: string, render: Div) -> Markdown_Extensions {
		o := op(vel(e.nd), 260)
		put_str(o, name)
		put_u32(o, take(render.el))
		return e
	},
	frontmatter = proc(e: Markdown_Extensions) -> Markdown_Extensions {
		op(vel(e.nd), 256)
		return e
	},
	mdx = proc(e: Markdown_Extensions) -> Markdown_Extensions {
		op(vel(e.nd), 257)
		return e
	},
	parser_revision = proc(e: Markdown_Extensions, revision: u64) -> Markdown_Extensions {
		o := op(vel(e.nd), 258)
		put_u64(o, u64(revision))
		return e
	},
	plugin = proc(e: Markdown_Extensions, plugin: Markdown_Plugin_Any) -> Markdown_Extensions {
		o := op(vel(e.nd), 261)
		switch x in plugin {
		case Frontmatter_Plugin:
			put_u8(o, 0)
			put_u32(o, take_value(x.nd))
		case Markdown_Plugin:
			put_u8(o, 1)
			put_markdown_plugin(o, x)
		case:
			put_u8(o, 1)
			put_markdown_plugin(o, {})
		}
		return e
	},
}

