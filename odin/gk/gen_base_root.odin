	plugin = proc(e: Base_Text_View, plugin: Markdown_Plugin_Any) -> Base_Text_View {
		o := op(e.el, 276)
		switch x in plugin {
		case Frontmatter_Plugin:
			put_u8(o, 0)
			put_u32(o, take_value(x.nd))
		case Markdown_Plugin:
			put_u8(o, 1)
			put_markdown_plugin(o, x)
		case:
			put_u8(o, 1)
			put_markdown_plugin(o, {})
		}
		return e
	},
	scrollable = proc(e: Base_Text_View, scrollable: bool) -> Base_Text_View {
		o := op(e.el, 264)
		put_u8(o, u8(scrollable))
		return e
	},
	selectable = proc(e: Base_Text_View, selectable: bool) -> Base_Text_View {
		o := op(e.el, 265)
		put_u8(o, u8(selectable))
		return e
	},
	selection_format = proc(e: Base_Text_View, selection_format: Selection_Format) -> Base_Text_View {
		o := op(e.el, 266)
		put_u16(o, u16(selection_format))
		return e
	},
	style = proc(e: Base_Text_View, style: Base_Text_View_Style) -> Base_Text_View {
		o := op(e.el, 267)
		put_u32(o, take_value(style.nd))
		return e
	},
	table_actions = proc(e: Base_Text_View, f: Row_Source) -> Base_Text_View {
		o := op(e.el, 274)
		put_u64(o, items_check(f, 8))
		return e
	},
}

