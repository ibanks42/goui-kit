// Timing is gpui_kit::base::Timing.
Timing :: struct {
	using nd: Value,
	using vt: ^Timing_VT,
}

Timing_VT :: struct {
	delay: proc(e: Timing, delay: Signed_Duration) -> Timing,
	direction: proc(e: Timing, direction: Playback_Direction) -> Timing,
	ease: proc(e: Timing, easing: Easing) -> Timing,
	iterations: proc(e: Timing, iterations: Iteration_Count) -> Timing,
}

timing :: proc(duration: time.Duration, loc := #caller_location) -> Timing {
	e := Timing{new_value(415, loc), &timing_vt}
	o := node_args()
	put_ms(o, i64(duration))
	return e
}

@(private)
timing_vt := Timing_VT {
	delay = proc(e: Timing, delay: Signed_Duration) -> Timing {
		o := op(vel(e.nd), 256)
		put_Signed_Duration(o, delay)
		return e
	},
	direction = proc(e: Timing, direction: Playback_Direction) -> Timing {
		o := op(vel(e.nd), 257)
		put_u16(o, u16(direction))
		return e
	},
	ease = proc(e: Timing, easing: Easing) -> Timing {
		o := op(vel(e.nd), 258)
		put_Easing(o, easing)
		return e
	},
	iterations = proc(e: Timing, iterations: Iteration_Count) -> Timing {
		o := op(vel(e.nd), 259)
		put_Iteration_Count(o, iterations)
		return e
	},
}

