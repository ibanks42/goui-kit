// Alert_Dialog_Trigger is gpui_kit::base::AlertDialogTrigger.
Alert_Dialog_Trigger :: struct {
	using el: Element,
	using vt: ^Alert_Dialog_Trigger_VT,
}

Alert_Dialog_Trigger_VT :: struct {
	handle: proc(e: Alert_Dialog_Trigger, handle: Dialog_Handle) -> Alert_Dialog_Trigger,
	on_open: proc(e: Alert_Dialog_Trigger, open: Handler) -> Alert_Dialog_Trigger,
}

alert_dialog_trigger :: proc(trigger: Element, loc := #caller_location) -> Alert_Dialog_Trigger {
	use_base_alert_dialog()
	e := Alert_Dialog_Trigger{new_node(283, loc), &alert_dialog_trigger_vt}
	o := node_args()
	put_u32(o, take(trigger))
	return e
}

@(private)
alert_dialog_trigger_vt := Alert_Dialog_Trigger_VT {
	handle = proc(e: Alert_Dialog_Trigger, handle: Dialog_Handle) -> Alert_Dialog_Trigger {
		o := op(e.el, 257)
		put_obj(o, handle.h)
		return e
	},
	on_open = proc(e: Alert_Dialog_Trigger, open: Handler) -> Alert_Dialog_Trigger {
		o := op(e.el, 256)
		put_u32(o, register(open, 3))
		return e
	},
}

