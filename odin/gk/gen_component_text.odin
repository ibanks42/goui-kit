Text_View_Style_VT :: struct {
	code_block: proc(e: Text_View_Style, style: Style_Refinement) -> Text_View_Style,
	heading_font_size: proc(e: Text_View_Style, f: string) -> Text_View_Style,
	inline_code: proc(e: Text_View_Style, style: Highlight_Style) -> Text_View_Style,
	paragraph_gap: proc(e: Text_View_Style, gap: f32) -> Text_View_Style,
	table: proc(e: Text_View_Style, style: Style_Refinement) -> Text_View_Style,
	table_cell: proc(e: Text_View_Style, style: Style_Refinement) -> Text_View_Style,
	table_head: proc(e: Text_View_Style, style: Style_Refinement) -> Text_View_Style,
}

text_view_style_default :: proc(loc := #caller_location) -> Text_View_Style {
	e := Text_View_Style{new_value(798, loc), &text_view_style_vt}
	return e
}

@(private)
text_view_style_vt := Text_View_Style_VT {
	code_block = proc(e: Text_View_Style, style: Style_Refinement) -> Text_View_Style {
		o := op(vel(e.nd), 256)
		put_u32(o, take_value(style.nd))
		return e
	},
	heading_font_size = proc(e: Text_View_Style, f: string) -> Text_View_Style {
		o := op(vel(e.nd), 262)
		put_expr(o, f, 2)
		return e
	},
	inline_code = proc(e: Text_View_Style, style: Highlight_Style) -> Text_View_Style {
		o := op(vel(e.nd), 257)
		put_Highlight_Style(o, style)
		return e
	},
	paragraph_gap = proc(e: Text_View_Style, gap: f32) -> Text_View_Style {
		o := op(vel(e.nd), 258)
		put_f32(o, gap)
		return e
	},
	table = proc(e: Text_View_Style, style: Style_Refinement) -> Text_View_Style {
		o := op(vel(e.nd), 259)
		put_u32(o, take_value(style.nd))
		return e
	},
	table_cell = proc(e: Text_View_Style, style: Style_Refinement) -> Text_View_Style {
		o := op(vel(e.nd), 260)
		put_u32(o, take_value(style.nd))
		return e
	},
	table_head = proc(e: Text_View_Style, style: Style_Refinement) -> Text_View_Style {
		o := op(vel(e.nd), 261)
		put_u32(o, take_value(style.nd))
		return e
	},
}

