// Declarative language editing rules, independent of editor preferences and parsers.
//
// Mirrors the supported subset of Monaco's language configuration. `None` for `auto_closing_pairs`
// uses `brackets`; `Some(vec![])` disables all automatic pairs. Use the builders to configure a
// default value; additional language capabilities can be added without breaking callers.
// Tree-sitter queries are configured in the parser implementation, not in these rules.
//
// Language_Config is gpui_kit::base::input::language_config::LanguageConfig.
Language_Config :: struct {
	using nd: Value,
	using vt: ^Language_Config_VT,
}

Language_Config_VT :: struct {
	auto_close_before: proc(e: Language_Config, characters: string) -> Language_Config,
	auto_closing_pairs: proc(e: Language_Config, pairs: []Auto_Closing_Pair) -> Language_Config,
	brackets: proc(e: Language_Config, pairs: []Bracket_Pair) -> Language_Config,
	indentation_rules: proc(e: Language_Config, rules: Indentation_Rules) -> Language_Config,
}

language_config_default :: proc(loc := #caller_location) -> Language_Config {
	e := Language_Config{new_value(525, loc), &language_config_vt}
	return e
}

@(private)
language_config_vt := Language_Config_VT {
	auto_close_before = proc(e: Language_Config, characters: string) -> Language_Config {
		o := op(vel(e.nd), 256)
		put_str(o, characters)
		return e
	},
	auto_closing_pairs = proc(e: Language_Config, pairs: []Auto_Closing_Pair) -> Language_Config {
		o := op(vel(e.nd), 257)
		put_u32(o, u32(len(pairs)))
		for x0 in pairs {
			put_u32(o, take_value(x0.nd))
		}
		return e
	},
	brackets = proc(e: Language_Config, pairs: []Bracket_Pair) -> Language_Config {
		o := op(vel(e.nd), 258)
		put_u32(o, u32(len(pairs)))
		for x0 in pairs {
			put_u32(o, take_value(x0.nd))
		}
		return e
	},
	indentation_rules = proc(e: Language_Config, rules: Indentation_Rules) -> Language_Config {
		o := op(vel(e.nd), 259)
		put_u32(o, take_value(rules.nd))
		return e
	},
}

