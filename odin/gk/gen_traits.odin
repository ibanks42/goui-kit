stateful_interactive_element_hoverable_tooltip :: proc(e: Any_El, build_tooltip: View_Or_Tooltip) -> Any_El {
	o := op(e, 16801)
	{
		switch x in build_tooltip {
		case View:
			put_u8(o, 0)
			put_view_arg(o, x)
		case Kit_Tooltip:
