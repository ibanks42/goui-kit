@(private)
stateful_interactive_element_a11y_synthetic_children :: proc(e: Any_El, f: []A11y_Child) -> Any_El {
	o := op(e, 16805)
	put_u32(o, u32(len(f)))
	for x in f {
		put_str(o, x.key)
		put_u16(o, u16(x.role))
		put_str(o, x.label)
	}
	return e
}
