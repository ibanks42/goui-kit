// Parent_Element_Trait is gpui_kit::ParentElement.
Parent_Element_Trait :: struct($T: typeid) {
	text: proc(e: T, s: string) -> T,
	child_view: proc(e: T, v: View) -> T,
	// Add a single child element to this element.
	child: proc(e: T, child: Element) -> T,
	// Add multiple child elements to this element.
	children: proc(e: T, children: []Element) -> T,
}

@(private)
parent_element_child :: proc(e: Any_El, child: Element) -> Any_El {
	attach(e, child)
	return e
}
@(private)
parent_element_children :: proc(e: Any_El, children: []Element) -> Any_El {
	for c in children {
		attach(e, c)
	}
	return e
}
@(private)
parent_element_any := Parent_Element_Trait(Any_El) {
	text = rt_parent_text,
	child_view = rt_child_view,
	child = parent_element_child,
	children = parent_element_children,
}

