	Easing_Ease_In_Out,
	Easing_Cubic_Bezier,
	Easing_Steps,
	Easing_Linear_Stops,
	Easing_Custom,
}

@(private)
put_Easing :: proc(o: ^Tape, v: Easing) {
	#partial switch x in v {
	case Easing_Linear:
		put_u16(o, 0)
	case Easing_Ease:
		put_u16(o, 1)
	case Easing_Ease_In:
		put_u16(o, 2)
	case Easing_Ease_Out:
		put_u16(o, 3)
	case Easing_Ease_In_Out:
		put_u16(o, 4)
	case Easing_Cubic_Bezier:
		put_u16(o, 5)
		put_f32(o, x.x1)
		put_f32(o, x.y1)
		put_f32(o, x.x2)
		put_f32(o, x.y2)
	case Easing_Steps:
		put_u16(o, 6)
		put_nonzero(o, u64(x.count), 4)
		put_u16(o, u16(x.position))
	case Easing_Linear_Stops:
		put_u16(o, 7)
		put_u32(o, u32(len(x.v0)))
		for x0 in x.v0 {
			put_f32(o, x0.v0)
			put_f32(o, x0.v1)
		}
	case Easing_Custom:
		put_u16(o, 8)
		put_expr(o, x.v0, 1)
	case:
		put_u16(o, 0xffff)
	}
}

