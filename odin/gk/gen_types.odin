	#partial switch x in v {
	case Insert_Target_Tabs:
		put_u16(o, 0)
		put_u64(o, u64(x.node))
		if x0, ok := x.ix.?; ok {
			put_u8(o, 1)
			put_usize(o, x0)
		} else {
			put_u8(o, 0)
		}
		put_u8(o, u8(x.activate))
	case Insert_Target_Split:
		put_u16(o, 1)
		put_u64(o, u64(x.node))
		put_u16(o, u16(x.placement))
		if x0, ok := x.size.?; ok {
			put_u8(o, 1)
			put_f32(o, x0)
		} else {
			put_u8(o, 0)
		}
	case:
		put_u16(o, 0xffff)
	}
}

