	#partial switch x in v {
	case Matcher_Day_Of_Week:
		put_u16(o, 0)
		put_u32(o, u32(len(x.v0)))
		for x0 in x.v0 {
			put_u32(o, u32(x0))
		}
	case Matcher_Interval:
		put_u16(o, 1)
		{ lv := x.v0; put_value(o, &lv, type_info_of(Interval_Matcher)) }
	case Matcher_Range:
		put_u16(o, 2)
		{ lv := x.v0; put_value(o, &lv, type_info_of(Range_Matcher)) }
	case Matcher_Custom:
		put_u16(o, 3)
		put_u32(o, u32(len(x.v0)))
		for x0 in x.v0 {
			put_naive_date(o, x0)
		}
	case:
		put_u16(o, 0xffff)
	}
}

