@(private)
put_Date :: proc(o: ^Tape, v: Date) {
	#partial switch x in v {
	case Date_Single:
		put_u16(o, 0)
		if x0, ok := x.v0.?; ok {
			put_u8(o, 1)
			put_naive_date(o, x0)
		} else {
			put_u8(o, 0)
		}
	case Date_Range:
		put_u16(o, 1)
		if x0, ok := x.v0.?; ok {
			put_u8(o, 1)
			put_naive_date(o, x0)
		} else {
			put_u8(o, 0)
		}
		if x0, ok := x.v1.?; ok {
			put_u8(o, 1)
			put_naive_date(o, x0)
		} else {
			put_u8(o, 0)
		}
	case:
		put_u16(o, 0xffff)
	}
}

