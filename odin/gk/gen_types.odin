// Block_Node is gpui_kit::base::text::editor_host::BlockNode.
Block_Node_Kind :: enum u16 {
	Unknown = 13,
}
Block_Node_Root :: struct {
	children: []Block_Node,
	span: Maybe(Span),
}
Block_Node_Paragraph :: struct {
	v0: Paragraph,
}
Block_Node_Heading :: struct {
	level: u8,
	children: Paragraph,
	span: Maybe(Span),
}
Block_Node_Blockquote :: struct {
	children: []Block_Node,
	span: Maybe(Span),
}
Block_Node_Surface :: struct {
	name: string,
	children: []Block_Node,
	span: Maybe(Span),
}
Block_Node_List :: struct {
	children: []Block_Node,
	ordered: bool,
	start: Maybe(u32),
	span: Maybe(Span),
}
Block_Node_List_Item :: struct {
	children: []Block_Node,
	spread: bool,
	checked: Maybe(bool),
	task_marker: Maybe(Span),
	span: Maybe(Span),
}
Block_Node_Code_Block :: struct {
	v0: Base_Code_Block,
}
Block_Node_Table :: struct {
	v0: Base_Table_2,
}
Block_Node_Break :: struct {
	html: bool,
	span: Maybe(Span),
}
Block_Node_Horizontal_Rule :: struct {
	span: Maybe(Span),
}
Block_Node_Definition :: struct {
	identifier: string,
	url: string,
	title: Maybe(string),
	span: Maybe(Span),
}
// Block_Node_Held: a BlockNode the library holds (a function's result, PROTOCOLS.md 9.30); temporary until gk.retain, as any object a call hands out.
Block_Node_Held :: struct {
	using state: State,
}
Block_Node :: union #no_nil {
	Block_Node_Kind,
	Block_Node_Root,
	Block_Node_Paragraph,
	Block_Node_Heading,
	Block_Node_Blockquote,
	Block_Node_Surface,
	Block_Node_List,
	Block_Node_List_Item,
	Block_Node_Code_Block,
	Block_Node_Table,
	Block_Node_Break,
	Block_Node_Horizontal_Rule,
	Block_Node_Definition,
	Block_Node_Held,
}

@(private)
put_Block_Node :: proc(o: ^Tape, v: Block_Node) {
	switch x in v {
	case Block_Node_Kind:
		put_u16(o, u16(x))
	case Block_Node_Root:
		put_u16(o, 0)
		put_u32(o, u32(len(x.children)))
		for x0 in x.children {
			put_Block_Node(o, x0)
		}
		if x0, ok := x.span.?; ok {
			put_u8(o, 1)
			put_Span(o, x0)
		} else {
			put_u8(o, 0)
		}
	case Block_Node_Paragraph:
		put_u16(o, 1)
		put_u32(o, take_value(x.v0.nd))
	case Block_Node_Heading:
		put_u16(o, 2)
		put_u8(o, u8(x.level))
		put_u32(o, take_value(x.children.nd))
		if x0, ok := x.span.?; ok {
			put_u8(o, 1)
			put_Span(o, x0)
		} else {
			put_u8(o, 0)
		}
	case Block_Node_Blockquote:
		put_u16(o, 3)
		put_u32(o, u32(len(x.children)))
		for x0 in x.children {
			put_Block_Node(o, x0)
		}
		if x0, ok := x.span.?; ok {
			put_u8(o, 1)
			put_Span(o, x0)
		} else {
			put_u8(o, 0)
		}
	case Block_Node_Surface:
		put_u16(o, 4)
		put_str(o, x.name)
		put_u32(o, u32(len(x.children)))
		for x0 in x.children {
			put_Block_Node(o, x0)
		}
		if x0, ok := x.span.?; ok {
			put_u8(o, 1)
			put_Span(o, x0)
		} else {
			put_u8(o, 0)
		}
	case Block_Node_List:
		put_u16(o, 5)
		put_u32(o, u32(len(x.children)))
		for x0 in x.children {
			put_Block_Node(o, x0)
		}
		put_u8(o, u8(x.ordered))
		if x0, ok := x.start.?; ok {
			put_u8(o, 1)
			put_u32(o, u32(x0))
		} else {
			put_u8(o, 0)
		}
		if x0, ok := x.span.?; ok {
			put_u8(o, 1)
			put_Span(o, x0)
		} else {
			put_u8(o, 0)
		}
	case Block_Node_List_Item:
		put_u16(o, 6)
		put_u32(o, u32(len(x.children)))
		for x0 in x.children {
			put_Block_Node(o, x0)
		}
		put_u8(o, u8(x.spread))
		if x0, ok := x.checked.?; ok {
			put_u8(o, 1)
			put_u8(o, u8(x0))
		} else {
			put_u8(o, 0)
		}
		if x0, ok := x.task_marker.?; ok {
			put_u8(o, 1)
			put_Span(o, x0)
		} else {
			put_u8(o, 0)
		}
		if x0, ok := x.span.?; ok {
			put_u8(o, 1)
			put_Span(o, x0)
		} else {
			put_u8(o, 0)
		}
	case Block_Node_Code_Block:
		put_u16(o, 7)
		put_u32(o, take_value(x.v0.nd))
	case Block_Node_Table:
		put_u16(o, 9)
		put_obj(o, x.v0.h)
	case Block_Node_Break:
		put_u16(o, 10)
		put_u8(o, u8(x.html))
		if x0, ok := x.span.?; ok {
			put_u8(o, 1)
			put_Span(o, x0)
		} else {
			put_u8(o, 0)
		}
	case Block_Node_Horizontal_Rule:
		put_u16(o, 11)
		if x0, ok := x.span.?; ok {
			put_u8(o, 1)
			put_Span(o, x0)
		} else {
			put_u8(o, 0)
		}
	case Block_Node_Definition:
		put_u16(o, 12)
		put_str(o, x.identifier)
		put_str(o, x.url)
		if x0, ok := x.title.?; ok {
			put_u8(o, 1)
			put_str(o, x0)
		} else {
			put_u8(o, 0)
		}
		if x0, ok := x.span.?; ok {
			put_u8(o, 1)
			put_Span(o, x0)
		} else {
			put_u8(o, 0)
		}
	case Block_Node_Held:
		put_u16(o, 0xfffe)
		put_obj(o, x.h)
	}
}

