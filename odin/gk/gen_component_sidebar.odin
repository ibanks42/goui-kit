	accessibility_label: proc(e: Sidebar_Toggle_Button, label: string) -> Sidebar_Toggle_Button,
	// Set the collapsed state of the toggle button.
	collapsed: proc(e: Sidebar_Toggle_Button, collapsed: bool) -> Sidebar_Toggle_Button,
	// Add a click handler to the toggle button.
	on_click: proc(e: Sidebar_Toggle_Button, on_click: Handler) -> Sidebar_Toggle_Button,
	// Set the side of the toggle button.
	//
	// Default is `Side::Left`.
	side: proc(e: Sidebar_Toggle_Button, side: Side) -> Sidebar_Toggle_Button,
}

// Create a new SidebarToggleButton.
sidebar_toggle_button :: proc(loc := #caller_location) -> Sidebar_Toggle_Button {
	use_component_sidebar()
	e := Sidebar_Toggle_Button{new_node(758, loc), &sidebar_toggle_button_vt}
	return e
}

@(private)
sidebar_toggle_button_vt := Sidebar_Toggle_Button_VT {
	accessibility_label = proc(e: Sidebar_Toggle_Button, label: string) -> Sidebar_Toggle_Button {
		o := op(e.el, 256)
		put_str(o, label)
		return e
	},
	collapsed = proc(e: Sidebar_Toggle_Button, collapsed: bool) -> Sidebar_Toggle_Button {
		o := op(e.el, 257)
		put_u8(o, u8(collapsed))
		return e
	},
	on_click = proc(e: Sidebar_Toggle_Button, on_click: Handler) -> Sidebar_Toggle_Button {
		o := op(e.el, 258)
		put_u32(o, register(on_click, 1))
		return e
	},
	side = proc(e: Sidebar_Toggle_Button, side: Side) -> Sidebar_Toggle_Button {
		o := op(e.el, 259)
		put_u16(o, u16(side))
		return e
	},
}

