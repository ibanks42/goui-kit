		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_input()
		put_op(o, 1258)
		put_u64(o, s.h)
		put_u32(o, u32(len(candidates)))
		for x0 in candidates {
			put_Fold_Range(o, x0)
		}
		state_set(cx, req[:], loc)
	},
	set_folded = proc(s: Display_Map, cx: ^Cx, start_line: int, folded: bool, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_input()
		put_op(o, 1259)
		put_u64(o, s.h)
		put_usize(o, start_line)
		put_u8(o, u8(folded))
		state_set(cx, req[:], loc)
	},
	set_font = proc(s: Display_Map, cx: ^Cx, font: Font, font_size: f32, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_input()
		put_op(o, 1260)
		put_u64(o, s.h)
		{ fv := font; put_value(o, &fv, type_info_of(Font)) }
		put_f32(o, font_size)
		state_set(cx, req[:], loc)
	},
	set_wrapping_indent = proc(s: Display_Map, cx: ^Cx, wrapping_indent: Wrapping_Indent, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_input()
		put_op(o, 1261)
		put_u64(o, s.h)
		put_u16(o, u16(wrapping_indent))
		state_set(cx, req[:], loc)
	},
	toggle_fold = proc(s: Display_Map, cx: ^Cx, start_line: int, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_input()
		put_op(o, 1263)
		put_u64(o, s.h)
		put_usize(o, start_line)
		state_set(cx, req[:], loc)
	},
}

display_map :: proc(cx: ^Cx, font: Font, font_size: f32, wrap_width: Maybe(f32), loc := #caller_location) -> Display_Map {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_input()
	put_op(o, 1256)
	{ fv := font; put_value(o, &fv, type_info_of(Font)) }
	put_f32(o, font_size)
	if x0, ok := wrap_width.?; ok {
		put_u8(o, 1)
		put_f32(o, x0)
	} else {
		put_u8(o, 0)
	}
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {state = {h = state_make(cx, req[:], loc)}, vt = &display_map_vt}
}

@(init, private)
reg_dock :: proc "contextless" () {
	register_obj(typeid_of(Dock), &dock_vt)
}

// Dock is a handle to gpui_kit::base::dock::Dock, a library object the library keeps (PROTOCOLS.md section 13): a temporary handle when a read, a call or an event hands it out (gk.retain keeps it), a kept one from its constructor.
Dock :: struct {
	using state: State,
	using vt: ^Dock_VT,
}

Dock_VT :: struct {
	is_collapsible: proc(s: Dock, cx: ^Cx, loc := #caller_location) -> bool,
	is_open: proc(s: Dock, cx: ^Cx, loc := #caller_location) -> bool,
	is_resizing: proc(s: Dock, cx: ^Cx, loc := #caller_location) -> bool,
	size: proc(s: Dock, cx: ^Cx, loc := #caller_location) -> f32,
	set_collapsible: proc(s: Dock, cx: ^Cx, collapsible: bool, loc := #caller_location),
	set_open: proc(s: Dock, cx: ^Cx, open: bool, loc := #caller_location),
	set_resizing: proc(s: Dock, cx: ^Cx, resizing: bool, loc := #caller_location),
	set_size: proc(s: Dock, cx: ^Cx, size: f32, loc := #caller_location),
}

@(private)
dock_vt := Dock_VT {
	is_collapsible = proc(s: Dock, cx: ^Cx, loc := #caller_location) -> (v: bool) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_dock()
		put_op(o, 848)
		put_u64(o, s.h)
		r := obj_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	is_open = proc(s: Dock, cx: ^Cx, loc := #caller_location) -> (v: bool) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_dock()
		put_op(o, 849)
		put_u64(o, s.h)
		r := obj_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	is_resizing = proc(s: Dock, cx: ^Cx, loc := #caller_location) -> (v: bool) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_dock()
		put_op(o, 850)
		put_u64(o, s.h)
		r := obj_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	size = proc(s: Dock, cx: ^Cx, loc := #caller_location) -> (v: f32) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_dock()
		put_op(o, 856)
		put_u64(o, s.h)
		r := obj_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	set_collapsible = proc(s: Dock, cx: ^Cx, collapsible: bool, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_dock()
		put_op(o, 852)
		put_u64(o, s.h)
		put_u8(o, u8(collapsible))
		state_set(cx, req[:], loc)
	},
	set_open = proc(s: Dock, cx: ^Cx, open: bool, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_dock()
		put_op(o, 853)
		put_u64(o, s.h)
		put_u8(o, u8(open))
		state_set(cx, req[:], loc)
	},
	set_resizing = proc(s: Dock, cx: ^Cx, resizing: bool, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_dock()
		put_op(o, 854)
		put_u64(o, s.h)
		put_u8(o, u8(resizing))
		state_set(cx, req[:], loc)
	},
	set_size = proc(s: Dock, cx: ^Cx, size: f32, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_dock()
		put_op(o, 855)
		put_u64(o, s.h)
		put_f32(o, size)
		state_set(cx, req[:], loc)
	},
}

dock :: proc(cx: ^Cx, size: f32, loc := #caller_location) -> Dock {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_dock()
	put_op(o, 851)
	put_f32(o, size)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {state = {h = state_make(cx, req[:], loc)}, vt = &dock_vt}
}

// Dock_Area is a handle to gpui_kit::base::dock::DockArea, an entity the library keeps.
Dock_Area :: struct {
	using state: State,
	using vt: ^Dock_Area_VT,
}

Dock_Area_VT :: struct {
	bounds: proc(s: Dock_Area, cx: ^Cx, loc := #caller_location) -> Bounds,
	dock_size: proc(s: Dock_Area, cx: ^Cx, placement: Dock_Placement, loc := #caller_location) -> Maybe(f32),
	dump: proc(s: Dock_Area, cx: ^Cx, loc := #caller_location) -> Dock_Area_State,
	has_dock: proc(s: Dock_Area, cx: ^Cx, placement: Dock_Placement, loc := #caller_location) -> bool,
