	state_set(cx, req[:], loc)
}

table_state_on_table_event :: proc(s: Table_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription {
	slot, generation := keep_handler(cx, h, 100, loc)
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	put_op(o, 722)
	put_u64(o, s.h)
	put_u32(o, slot)
	put_u32(o, generation)
	r := state_get(s.h, cx, req[:], loc)
	return {rd_u64(&r), slot}
}

// Table_State_Builder is the chain of TableState's `self -> Self` methods; build makes the entity, in one crossing.
