// Set (0-based) `Position` of the cursor.
//
// This will move the cursor to the specified line and column, and update the selection range.
textarea_state_set_cursor_position :: proc(s: Textarea_State, cx: ^Cx, position: Lsp_Position, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_input()
	put_op(o, 1477)
	put_u64(o, s.h)
	{ lv := position; put_value(o, &lv, type_info_of(Lsp_Position)) }
	state_set(cx, req[:], loc)
}

// Update `->cursor_surrounding_lines` after construction.
textarea_state_set_cursor_surrounding_lines :: proc(s: Textarea_State, cx: ^Cx, lines: Maybe(int), loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_input()
	put_op(o, 566)
	put_u64(o, s.h)
	if x0, ok := lines.?; ok {
		put_u8(o, 1)
		put_usize(o, x0)
	} else {
		put_u8(o, 0)
	}
	state_set(cx, req[:], loc)
}

// Replace the textarea's text decorations, as UTF-8 byte ranges into `gk.input_state_value`.
// Ranges follow later edits like an editor's decoration collections, and one whose text is deleted
// is dropped.
