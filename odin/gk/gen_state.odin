		o := &req
		use_base_dock()
		put_op(o, 863)
		put_u64(o, s.h)
		put_u64(o, u64(node))
		put_u64(o, u64(panel))
		put_u16(o, u16(placement))
		state_set(cx, req[:], loc)
	},
	toggle_dock = proc(s: Dock_Area, cx: ^Cx, placement: Dock_Placement, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_dock()
		put_op(o, 344)
		put_u64(o, s.h)
		put_u16(o, u16(placement))
		state_set(cx, req[:], loc)
	},
	on_dock_event = proc(s: Dock_Area, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription {
		slot, generation := keep_handler(cx, h, 87, loc)
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		put_op(o, 343)
		put_u64(o, s.h)
		put_u32(o, slot)
		put_u32(o, generation)
		r := state_get(s.h, cx, req[:], loc)
		return {rd_u64(&r), slot}
	},
}

// Dock_Area_Builder is the chain of DockArea's `self -> Self` methods; build makes the entity, in one crossing.
Dock_Area_Builder :: struct {
	using vt: ^Dock_Area_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Dock_Area_Builder_VT :: struct {
	with_renderer: proc(b: Dock_Area_Builder, renderer: Dock_Renderer) -> Dock_Area_Builder,
	build: proc(b: Dock_Area_Builder) -> Dock_Area,
}

@(private)
dock_area_builder_vt := Dock_Area_Builder_VT {
	with_renderer = proc(b: Dock_Area_Builder, renderer: Dock_Renderer) -> Dock_Area_Builder {
		o := b.req
		put_op(o, 1)
		put_u64(o, renderer.h)
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Dock_Area_Builder) -> Dock_Area {
		return {state = {h = state_make(b.cx, b.req[:])}, vt = &dock_area_vt}
	},
}

dock_area :: proc(cx: ^Cx, id: string, version: Maybe(int), loc := #caller_location) -> Dock_Area_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_dock()
	put_op(o, 336)
	put_str(o, id)
	if x0, ok := version.?; ok {
		put_u8(o, 1)
		put_usize(o, x0)
	} else {
		put_u8(o, 0)
	}
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &dock_area_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

