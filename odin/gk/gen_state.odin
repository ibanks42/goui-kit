	o := &req
	use_base_input()
	put_op(o, 531)
	put_u64(o, s.h)
	state_set(cx, req[:], loc)
}

input_state_update_edge_drag :: proc(s: Input_State, cx: ^Cx, finger: Gpui_Point, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_input()
	put_op(o, 629)
	put_u64(o, s.h)
	put_Gpui_Point(o, finger)
	state_set(cx, req[:], loc)
}

input_state_on_input_event :: proc(s: Input_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription {
	slot, generation := keep_handler(cx, h, 97, loc)
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	put_op(o, 526)
	put_u64(o, s.h)
	put_u32(o, slot)
	put_u32(o, generation)
	r := state_get(s.h, cx, req[:], loc)
	return {rd_u64(&r), slot}
}

input_state_on_input_edits_event :: proc(s: Input_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription {
	slot, generation := keep_handler(cx, h, 120, loc)
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	put_op(o, 1751)
	put_u64(o, s.h)
	put_u32(o, slot)
	put_u32(o, generation)
	r := state_get(s.h, cx, req[:], loc)
