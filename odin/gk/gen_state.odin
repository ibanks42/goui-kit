	o := req
	use_base_text()
	put_op(o, 817)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &text_view_defaults_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

