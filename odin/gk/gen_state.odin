	},
}

// Textarea_State_Builder is the chain of TextareaState's `self -> Self` methods; build makes the entity, in one crossing.
Textarea_State_Builder :: struct {
	using vt: ^Textarea_State_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Textarea_State_Builder_VT :: struct {
	auto_grow: proc(b: Textarea_State_Builder, min_rows: int, max_rows: int) -> Textarea_State_Builder,
	autocapitalize: proc(b: Textarea_State_Builder, autocapitalize: Autocapitalize) -> Textarea_State_Builder,
	autocorrect: proc(b: Textarea_State_Builder, autocorrect: bool) -> Textarea_State_Builder,
	clean_on_escape: proc(b: Textarea_State_Builder) -> Textarea_State_Builder,
	context_menu: proc(b: Textarea_State_Builder, enable: bool) -> Textarea_State_Builder,
	cursor_surrounding_lines: proc(b: Textarea_State_Builder, lines: Maybe(int)) -> Textarea_State_Builder,
	default_value: proc(b: Textarea_State_Builder, value: string) -> Textarea_State_Builder,
	input_action: proc(b: Textarea_State_Builder, action: Text_Input_Action) -> Textarea_State_Builder,
	mask_pattern: proc(b: Textarea_State_Builder, pattern: Mask_Pattern_Into) -> Textarea_State_Builder,
	placeholder: proc(b: Textarea_State_Builder, placeholder: string) -> Textarea_State_Builder,
	scroll_beyond_last_line: proc(b: Textarea_State_Builder, rows: Maybe(int)) -> Textarea_State_Builder,
	scroll_bounce: proc(b: Textarea_State_Builder, scroll_bounce: bool) -> Textarea_State_Builder,
	searchable: proc(b: Textarea_State_Builder, searchable: bool) -> Textarea_State_Builder,
	build: proc(b: Textarea_State_Builder) -> Textarea_State,
}

@(private)
textarea_state_builder_vt := Textarea_State_Builder_VT {
	auto_grow = proc(b: Textarea_State_Builder, min_rows: int, max_rows: int) -> Textarea_State_Builder {
		o := b.req
		put_op(o, 1)
		put_usize(o, min_rows)
		put_usize(o, max_rows)
		o[b.count_at] += 1
		return b
	},
	autocapitalize = proc(b: Textarea_State_Builder, autocapitalize: Autocapitalize) -> Textarea_State_Builder {
		o := b.req
		put_op(o, 2)
		put_u16(o, u16(autocapitalize))
		o[b.count_at] += 1
		return b
	},
	autocorrect = proc(b: Textarea_State_Builder, autocorrect: bool) -> Textarea_State_Builder {
		o := b.req
		put_op(o, 3)
		put_u8(o, u8(autocorrect))
		o[b.count_at] += 1
		return b
	},
	clean_on_escape = proc(b: Textarea_State_Builder) -> Textarea_State_Builder {
		o := b.req
		put_op(o, 4)
		o[b.count_at] += 1
		return b
	},
	context_menu = proc(b: Textarea_State_Builder, enable: bool) -> Textarea_State_Builder {
		o := b.req
		put_op(o, 5)
		put_u8(o, u8(enable))
		o[b.count_at] += 1
		return b
	},
	cursor_surrounding_lines = proc(b: Textarea_State_Builder, lines: Maybe(int)) -> Textarea_State_Builder {
		o := b.req
		put_op(o, 6)
		if x0, ok := lines.?; ok {
			put_u8(o, 1)
			put_usize(o, x0)
		} else {
			put_u8(o, 0)
		}
		o[b.count_at] += 1
		return b
	},
	default_value = proc(b: Textarea_State_Builder, value: string) -> Textarea_State_Builder {
		o := b.req
		put_op(o, 7)
		put_str(o, value)
		o[b.count_at] += 1
		return b
	},
	input_action = proc(b: Textarea_State_Builder, action: Text_Input_Action) -> Textarea_State_Builder {
		o := b.req
		put_op(o, 8)
		put_u16(o, u16(action))
		o[b.count_at] += 1
		return b
	},
	mask_pattern = proc(b: Textarea_State_Builder, pattern: Mask_Pattern_Into) -> Textarea_State_Builder {
		o := b.req
		put_op(o, 13)
		put_Mask_Pattern_Into(o, pattern)
		o[b.count_at] += 1
		return b
	},
	placeholder = proc(b: Textarea_State_Builder, placeholder: string) -> Textarea_State_Builder {
		o := b.req
		put_op(o, 9)
		put_str(o, placeholder)
		o[b.count_at] += 1
		return b
	},
	scroll_beyond_last_line = proc(b: Textarea_State_Builder, rows: Maybe(int)) -> Textarea_State_Builder {
		o := b.req
		put_op(o, 10)
		if x0, ok := rows.?; ok {
			put_u8(o, 1)
			put_usize(o, x0)
		} else {
			put_u8(o, 0)
		}
		o[b.count_at] += 1
		return b
	},
	scroll_bounce = proc(b: Textarea_State_Builder, scroll_bounce: bool) -> Textarea_State_Builder {
		o := b.req
		put_op(o, 11)
		put_u8(o, u8(scroll_bounce))
		o[b.count_at] += 1
		return b
	},
	searchable = proc(b: Textarea_State_Builder, searchable: bool) -> Textarea_State_Builder {
		o := b.req
		put_op(o, 12)
		put_u8(o, u8(searchable))
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Textarea_State_Builder) -> Textarea_State {
		return {state = {h = state_make(b.cx, b.req[:])}, vt = &textarea_state_vt}
	},
}

textarea_state :: proc(cx: ^Cx, loc := #caller_location) -> Textarea_State_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_input()
	put_op(o, 551)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &textarea_state_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

@(init, private)
reg_theme :: proc "contextless" () {
	register_obj(typeid_of(Theme), &theme_vt)
}

theme_change :: proc(cx: ^Cx, mode: Theme_Mode_Into, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_component_theme()
	put_op(o, 1163)
	put_Theme_Mode_Into(o, mode)
	state_set(cx, req[:], loc)
}

theme_global :: proc(cx: ^Cx, loc := #caller_location) -> Theme {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_component_theme()
	put_op(o, 959)
	r := obj_get(0, cx, req[:], loc)
	return {state = {h = rd_u64(&r)}, vt = &theme_vt}
}

theme_global_mut :: proc(cx: ^Cx, loc := #caller_location) -> Theme {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_component_theme()
	put_op(o, 960)
	r := obj_get(0, cx, req[:], loc)
	return {state = {h = rd_u64(&r)}, vt = &theme_vt}
}

theme_set_scrollbar_mode :: proc(cx: ^Cx, mode: Scrollbar_Mode, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_component_theme()
	put_op(o, 971)
	put_u16(o, u16(mode))
	state_set(cx, req[:], loc)
}

theme_sync_base :: proc(cx: ^Cx, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_component_theme()
	put_op(o, 974)
	state_set(cx, req[:], loc)
}

theme_sync_scrollbar_appearance :: proc(cx: ^Cx, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_component_theme()
	put_op(o, 975)
	state_set(cx, req[:], loc)
}

theme_sync_system_appearance :: proc(cx: ^Cx, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_component_theme()
	put_op(o, 1164)
	state_set(cx, req[:], loc)
}

// Theme is a handle to gpui_kit::component::Theme, a library object the library keeps (PROTOCOLS.md section 13): a temporary handle when a read, a call or an event hands it out (gk.retain keeps it), a kept one from its constructor.
Theme :: struct {
	using state: State,
	using vt: ^Theme_VT,
}

Theme_VT :: struct {
	color_tokens: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Base_Color_Tokens,
	colors: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Kit_Theme_Color_2,
	cursor_blink: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Cursor_Blink_Read,
	dark_theme: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Theme_Config_Rc,
	focus_ring: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> bool,
	font_family: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Temp_String,
	font_size: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> f32,
	highlight_theme: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Highlight_Theme_Arc,
	input_background: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Hsla,
	is_dark: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> bool,
	light_theme: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Theme_Config_Rc,
	list: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Base_List_Settings,
	mode: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Theme_Mode,
	mono_font_family: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Temp_String,
	mono_font_size: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> f32,
	motion: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Kit_Motion_Tokens,
	motion_tokens: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Kit_Motion_Tokens,
	notification: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Kit_Notification_Settings,
	radius: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> f32,
	radius_2xl: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> f32,
	radius_3xl: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> f32,
	radius_4xl: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> f32,
	radius_full: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> f32,
	radius_lg: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> f32,
	radius_tokens: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Base_Radius_Tokens,
	resolve_semantic_config: proc(s: Theme, cx: ^Cx, config: Semantic_Theme_Config, loc := #caller_location) -> Base_Semantic_Theme_Tokens,
	scrollbar_mode: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Scrollbar_Mode,
	semantic_tokens: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Base_Semantic_Theme_Tokens,
	shadow: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> bool,
	shadow_tokens: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Base_Shadow_Tokens,
	sheet: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Kit_Sheet_Settings,
	spacing_tokens: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Base_Spacing_Tokens,
	theme_name: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Temp_String,
	tokens: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Theme_Tokens,
	transparent: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Hsla,
	typography_tokens: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> Base_Typography_Tokens,
	window_radius: proc(s: Theme, cx: ^Cx, loc := #caller_location) -> f32,
	apply_config: proc(s: Theme, cx: ^Cx, config: Theme_Config_Rc, loc := #caller_location),
	apply_semantic_tokens: proc(s: Theme, cx: ^Cx, tokens: Semantic_Theme_Tokens, loc := #caller_location),
	set_colors: proc(s: Theme, cx: ^Cx, value: Kit_Theme_Color, loc := #caller_location),
	set_cursor_blink: proc(s: Theme, cx: ^Cx, value: Cursor_Blink, loc := #caller_location),
	set_dark_theme: proc(s: Theme, cx: ^Cx, value: Theme_Config_Rc, loc := #caller_location),
	set_focus_ring: proc(s: Theme, cx: ^Cx, value: bool, loc := #caller_location),
	set_font_family: proc(s: Theme, cx: ^Cx, value: string, loc := #caller_location),
	set_font_size: proc(s: Theme, cx: ^Cx, value: f32, loc := #caller_location),
	set_highlight_theme: proc(s: Theme, cx: ^Cx, value: Highlight_Theme_Arc, loc := #caller_location),
	set_light_theme: proc(s: Theme, cx: ^Cx, value: Theme_Config_Rc, loc := #caller_location),
	set_list: proc(s: Theme, cx: ^Cx, value: List_Settings, loc := #caller_location),
	set_mode: proc(s: Theme, cx: ^Cx, value: Theme_Mode, loc := #caller_location),
	set_mono_font_family: proc(s: Theme, cx: ^Cx, value: string, loc := #caller_location),
	set_mono_font_size: proc(s: Theme, cx: ^Cx, value: f32, loc := #caller_location),
	set_motion: proc(s: Theme, cx: ^Cx, value: Motion_Tokens, loc := #caller_location),
	set_notification: proc(s: Theme, cx: ^Cx, value: Notification_Settings, loc := #caller_location),
	set_radius: proc(s: Theme, cx: ^Cx, value: f32, loc := #caller_location),
	set_radius_lg: proc(s: Theme, cx: ^Cx, value: f32, loc := #caller_location),
	set_shadow: proc(s: Theme, cx: ^Cx, value: bool, loc := #caller_location),
	set_sheet: proc(s: Theme, cx: ^Cx, value: Sheet_Settings, loc := #caller_location),
	set_transparent: proc(s: Theme, cx: ^Cx, value: Color, loc := #caller_location),
	set_window_radius: proc(s: Theme, cx: ^Cx, value: f32, loc := #caller_location),
	apply_semantic_config: proc(s: Theme, cx: ^Cx, config: Semantic_Theme_Config, loc := #caller_location) -> Base_Semantic_Theme_Tokens,
	apply_semantic_config_str: proc(s: Theme, cx: ^Cx, content: string, loc := #caller_location) -> Fallible(Base_Semantic_Theme_Tokens),
}

@(private)
theme_vt := Theme_VT {
	color_tokens = proc(s: Theme, cx: ^Cx, loc := #caller_location) -> (v: Base_Color_Tokens) {
		req := make(Tape, 0, 32, context.temp_allocator)
