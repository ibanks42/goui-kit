input_content_with_token :: proc(s: Input_Content, cx: ^Cx, range: Range, token: Inline_Token, loc := #caller_location) -> (v: Fallible(Input_Content)) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_input()
	put_op(o, 1143)
	put_u64(o, s.h)
	put_range(o, range)
	put_vtape(o, token.nd)
	r := state_call(s.h, cx, req[:], loc)
	rd_into(&r, &v)
	return
}

input_content :: proc(cx: ^Cx, text: string, loc := #caller_location) -> Input_Content {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_input()
	put_op(o, 903)
	put_str(o, text)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {state = {h = state_make(cx, req[:], loc)}}
}

