// Undo_History_Builder is the chain of UndoHistory's `self -> Self` methods; build makes the entity, in one crossing.
Undo_History_Builder :: struct {
	using vt: ^Undo_History_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Undo_History_Builder_VT :: struct {
	group_interval: proc(b: Undo_History_Builder, group_interval: time.Duration) -> Undo_History_Builder,
	max_undos: proc(b: Undo_History_Builder, max_undos: int) -> Undo_History_Builder,
	build: proc(b: Undo_History_Builder) -> Undo_History,
}

@(private)
undo_history_builder_vt := Undo_History_Builder_VT {
	group_interval = proc(b: Undo_History_Builder, group_interval: time.Duration) -> Undo_History_Builder {
		o := b.req
		put_op(o, 1)
		put_ms(o, i64(group_interval))
		o[b.count_at] += 1
		return b
	},
	max_undos = proc(b: Undo_History_Builder, max_undos: int) -> Undo_History_Builder {
		o := b.req
		put_op(o, 2)
		put_usize(o, max_undos)
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Undo_History_Builder) -> Undo_History {
		return {state = {h = state_make(b.cx, b.req[:])}, vt = &undo_history_vt}
	},
}

undo_history :: proc(cx: ^Cx, loc := #caller_location) -> Undo_History_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_root()
	put_op(o, 1308)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &undo_history_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

