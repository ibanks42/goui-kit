// Resizable_State is a handle to gpui_kit::base::ResizableState, an entity the library keeps.
Resizable_State :: struct {
	using state: State,
	using vt: ^Resizable_State_VT,
}

Resizable_State_VT :: struct {
	container_size: proc(s: Resizable_State, cx: ^Cx, loc := #caller_location) -> f32,
	sizes: proc(s: Resizable_State, cx: ^Cx, loc := #caller_location) -> []f32,
	clear: proc(s: Resizable_State, cx: ^Cx, loc := #caller_location),
	insert_panel: proc(s: Resizable_State, cx: ^Cx, size: Maybe(f32), ix: Maybe(int), loc := #caller_location),
	remove_panel: proc(s: Resizable_State, cx: ^Cx, panel_ix: int, loc := #caller_location),
	reset_panel: proc(s: Resizable_State, cx: ^Cx, panel_ix: int, loc := #caller_location),
	resize_panel: proc(s: Resizable_State, cx: ^Cx, ix: int, size: f32, loc := #caller_location),
	on_resizable_panel_event: proc(s: Resizable_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription,
}

@(private)
resizable_state_vt := Resizable_State_VT {
	container_size = proc(s: Resizable_State, cx: ^Cx, loc := #caller_location) -> (v: f32) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_resizable()
		put_op(o, 1527)
		put_u64(o, s.h)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	sizes = proc(s: Resizable_State, cx: ^Cx, loc := #caller_location) -> (v: []f32) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_resizable()
		put_op(o, 1533)
		put_u64(o, s.h)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	clear = proc(s: Resizable_State, cx: ^Cx, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_resizable()
		put_op(o, 1526)
		put_u64(o, s.h)
		state_set(cx, req[:], loc)
	},
	insert_panel = proc(s: Resizable_State, cx: ^Cx, size: Maybe(f32), ix: Maybe(int), loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_resizable()
		put_op(o, 1528)
		put_u64(o, s.h)
		if x0, ok := size.?; ok {
			put_u8(o, 1)
			put_f32(o, x0)
		} else {
			put_u8(o, 0)
		}
		if x0, ok := ix.?; ok {
			put_u8(o, 1)
			put_usize(o, x0)
		} else {
			put_u8(o, 0)
		}
		state_set(cx, req[:], loc)
	},
	remove_panel = proc(s: Resizable_State, cx: ^Cx, panel_ix: int, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_resizable()
		put_op(o, 1530)
		put_u64(o, s.h)
		put_usize(o, panel_ix)
		state_set(cx, req[:], loc)
	},
	reset_panel = proc(s: Resizable_State, cx: ^Cx, panel_ix: int, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_resizable()
		put_op(o, 1531)
		put_u64(o, s.h)
		put_usize(o, panel_ix)
		state_set(cx, req[:], loc)
	},
	resize_panel = proc(s: Resizable_State, cx: ^Cx, ix: int, size: f32, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_resizable()
		put_op(o, 1532)
		put_u64(o, s.h)
		put_usize(o, ix)
		put_f32(o, size)
		state_set(cx, req[:], loc)
	},
	on_resizable_panel_event = proc(s: Resizable_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription {
		slot, generation := keep_handler(cx, h, 96, loc)
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		put_op(o, 1534)
		put_u64(o, s.h)
		put_u32(o, slot)
		put_u32(o, generation)
		r := state_get(s.h, cx, req[:], loc)
		return {rd_u64(&r), slot}
	},
}

resizable_state :: proc(cx: ^Cx, loc := #caller_location) -> Resizable_State {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_resizable()
	put_op(o, 1529)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {state = {h = state_make(cx, req[:], loc)}, vt = &resizable_state_vt}
}

