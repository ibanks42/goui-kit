Toast_Manager_VT :: struct {
	get: proc(s: Toast_Manager, cx: ^Cx, id: u64, loc := #caller_location) -> Maybe(u64),
	is_empty: proc(s: Toast_Manager, cx: ^Cx, loc := #caller_location) -> bool,
	iter: proc(s: Toast_Manager, cx: ^Cx, loc := #caller_location) -> []Tuple_U64_U64_Toast_Transition_Status,
	len_: proc(s: Toast_Manager, cx: ^Cx, loc := #caller_location) -> int,
	visible: proc(s: Toast_Manager, cx: ^Cx, limit: int, loc := #caller_location) -> []Tuple_U64_U64_Toast_Transition_Status,
	advance: proc(s: Toast_Manager, cx: ^Cx, now: time.Duration, paused: bool, loc := #caller_location) -> Toast_Advance_U64_U64,
	dismiss: proc(s: Toast_Manager, cx: ^Cx, id: u64, now: time.Duration, loc := #caller_location) -> bool,
	dismiss_all: proc(s: Toast_Manager, cx: ^Cx, now: time.Duration, loc := #caller_location) -> []u64,
	push: proc(s: Toast_Manager, cx: ^Cx, id: u64, value: u64, options: Toast_Options, now: time.Duration, loc := #caller_location) -> Maybe(u64),
}

@(private)
toast_manager_vt := Toast_Manager_VT {
	get = proc(s: Toast_Manager, cx: ^Cx, id: u64, loc := #caller_location) -> (v: Maybe(u64)) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_toast()
		put_op(o, 1628)
		put_u64(o, s.h)
		put_u64(o, u64(id))
		r := obj_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	is_empty = proc(s: Toast_Manager, cx: ^Cx, loc := #caller_location) -> (v: bool) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_toast()
		put_op(o, 1629)
		put_u64(o, s.h)
		r := obj_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	iter = proc(s: Toast_Manager, cx: ^Cx, loc := #caller_location) -> (v: []Tuple_U64_U64_Toast_Transition_Status) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_toast()
		put_op(o, 1630)
		put_u64(o, s.h)
		r := obj_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	len_ = proc(s: Toast_Manager, cx: ^Cx, loc := #caller_location) -> (v: int) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_toast()
		put_op(o, 1631)
		put_u64(o, s.h)
		r := obj_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	visible = proc(s: Toast_Manager, cx: ^Cx, limit: int, loc := #caller_location) -> (v: []Tuple_U64_U64_Toast_Transition_Status) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_toast()
		put_op(o, 1634)
		put_u64(o, s.h)
		put_usize(o, limit)
		r := obj_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	advance = proc(s: Toast_Manager, cx: ^Cx, now: time.Duration, paused: bool, loc := #caller_location) -> (v: Toast_Advance_U64_U64) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_toast()
		put_op(o, 1625)
		put_u64(o, s.h)
		put_i64(o, i64(now))
		put_u8(o, u8(paused))
		r := state_call(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	dismiss = proc(s: Toast_Manager, cx: ^Cx, id: u64, now: time.Duration, loc := #caller_location) -> (v: bool) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_toast()
		put_op(o, 1626)
		put_u64(o, s.h)
		put_u64(o, u64(id))
		put_i64(o, i64(now))
		r := state_call(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	dismiss_all = proc(s: Toast_Manager, cx: ^Cx, now: time.Duration, loc := #caller_location) -> (v: []u64) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_toast()
		put_op(o, 1627)
		put_u64(o, s.h)
		put_i64(o, i64(now))
		r := state_call(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	push = proc(s: Toast_Manager, cx: ^Cx, id: u64, value: u64, options: Toast_Options, now: time.Duration, loc := #caller_location) -> (v: Maybe(u64)) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_toast()
		put_op(o, 1633)
		put_u64(o, s.h)
		put_u64(o, u64(id))
		put_u64(o, u64(value))
		put_Toast_Options(o, options)
		put_i64(o, i64(now))
		r := state_call(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
}

toast_manager :: proc(cx: ^Cx, motion: Toast_Motion, loc := #caller_location) -> Toast_Manager {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_toast()
	put_op(o, 1632)
	put_Toast_Motion(o, motion)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {state = {h = state_make(cx, req[:], loc)}, vt = &toast_manager_vt}
}

