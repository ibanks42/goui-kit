// Get the buffer line for a given display row
display_map_display_row_to_buffer_line :: proc(s: Display_Map, cx: ^Cx, display_row: int, loc := #caller_location) -> (v: int) {
	req := make(Tape, 0, 32, context.temp_allocator)
