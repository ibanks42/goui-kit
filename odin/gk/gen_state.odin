// List_State_Builder is the chain of ListState's `self -> Self` methods; build makes the entity, in one crossing.
List_State_Builder :: struct {
	using vt: ^List_State_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

List_State_Builder_VT :: struct {
	searchable: proc(b: List_State_Builder, searchable: bool) -> List_State_Builder,
	selectable: proc(b: List_State_Builder, selectable: bool) -> List_State_Builder,
	build: proc(b: List_State_Builder) -> List_State,
}

@(private)
list_state_builder_vt := List_State_Builder_VT {
	searchable = proc(b: List_State_Builder, searchable: bool) -> List_State_Builder {
		o := b.req
		put_op(o, 1)
		put_u8(o, u8(searchable))
		o[b.count_at] += 1
		return b
	},
	selectable = proc(b: List_State_Builder, selectable: bool) -> List_State_Builder {
		o := b.req
		put_op(o, 2)
		put_u8(o, u8(selectable))
		o[b.count_at] += 1
		return b
	},
	build = proc(b: List_State_Builder) -> List_State {
		return {state = {h = state_make(b.cx, b.req[:])}}
	},
}

list_state :: proc(cx: ^Cx, delegate: Row_Source, loc := #caller_location) -> List_State_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_component_list()
	put_op(o, 691)
	put_u64(o, delegate.h)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &list_state_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

