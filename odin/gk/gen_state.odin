		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_dock()
		put_op(o, 861)
		put_u64(o, s.h)
		put_u64(o, u64(node))
		put_u32(o, u32(len(sizes)))
		for x0 in sizes {
			put_f32(o, x0)
		}
		state_set(cx, req[:], loc)
	},
	set_version = proc(s: Dock_Area, cx: ^Cx, version: Maybe(int), loc := #caller_location) {
