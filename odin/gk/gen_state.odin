	return
}

// Get the value, combining the date with its time of day.
date_picker_state_date_time :: proc(s: Date_Picker_State, cx: ^Cx, loc := #caller_location) -> (v: Date_Time) {
	req := make(Tape, 0, 32, context.temp_allocator)
