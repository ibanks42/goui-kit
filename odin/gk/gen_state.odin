// Reset the list to `item_count` rows.
message_scroller_state_reset :: proc(s: Message_Scroller_State, cx: ^Cx, item_count: int, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
