list_state_on_list_event :: proc(s: List_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription {
	slot, generation := keep_handler(cx, h, 99, loc)
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	put_op(o, 698)
	put_u64(o, s.h)
	put_u32(o, slot)
	put_u32(o, generation)
	r := state_get(s.h, cx, req[:], loc)
	return {rd_u64(&r), slot}
}

// List_State_Builder is the chain of ListState's `self -> Self` methods; build makes the entity, in one crossing.
List_State_Builder :: struct {
	using vt: ^List_State_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

List_State_Builder_VT :: struct {
	// Sets whether the list is searchable, default is `false`.
	//
	// When `true`, there will be a search input at the top of the list.
	searchable: proc(b: List_State_Builder, searchable: bool) -> List_State_Builder,
	// Sets whether the list is selectable, default is true.
	selectable: proc(b: List_State_Builder, selectable: bool) -> List_State_Builder,
	build: proc(b: List_State_Builder) -> List_State,
}

@(private)
list_state_builder_vt := List_State_Builder_VT {
	searchable = proc(b: List_State_Builder, searchable: bool) -> List_State_Builder {
		o := b.req
		put_op(o, 1)
		put_u8(o, u8(searchable))
		o[b.count_at] += 1
		return b
	},
	selectable = proc(b: List_State_Builder, selectable: bool) -> List_State_Builder {
		o := b.req
		put_op(o, 2)
		put_u8(o, u8(selectable))
		o[b.count_at] += 1
		return b
	},
	build = proc(b: List_State_Builder) -> List_State {
		return {state = {h = state_make(b.cx, b.req[:])}}
	},
}

list_state :: proc(cx: ^Cx, delegate: Row_Source, loc := #caller_location) -> List_State_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_component_list()
	put_op(o, 691)
	put_u64(o, delegate.h)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &list_state_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

// Markdown_Extensions_Arc is a handle to std::sync::Arc<gpui_kit::base::MarkdownExtensions>, a library object the library keeps (PROTOCOLS.md section 13): a temporary handle when a read, a call or an event hands it out (gk.retain keeps it), a kept one from its constructor. Its procedures are named markdown_extensions_arc_*.
Markdown_Extensions_Arc :: struct {
