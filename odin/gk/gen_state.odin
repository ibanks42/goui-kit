// Transition_State is a handle to gpui_kit::base::TransitionState<f32>, a library object the library keeps (PROTOCOLS.md section 13): a temporary handle when a read, a call or an event hands it out (gk.retain keeps it), a kept one from its constructor. Its procedures are named transition_state_*.
Transition_State :: struct {
	using state: State,
}

// Returns the current value toward `target`, as `transition_with_status` does, and requests the
// next animation frame while the status is `Delayed` or `Running`.
//
// Call this while rendering an element. A target that changes while the element is not rendered
// starts transitioning at the next sample.
transition_state_sample :: proc(s: Transition_State, cx: ^Cx, target: f32, policy: Transition, loc := #caller_location) -> (v: Motion_Value_F32) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_motion()
	put_op(o, 1680)
	put_u64(o, s.h)
	put_f32(o, target)
	put_vtape(o, policy.nd)
	r := state_call(s.h, cx, req[:], loc)
	rd_into(&r, &v)
	return
}

transition_state_default :: proc(cx: ^Cx, loc := #caller_location) -> Transition_State {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_motion()
	put_op(o, 1679)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {state = {h = state_make(cx, req[:], loc)}}
}

