	},
	on_combobox_event = proc(s: Combobox_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription {
		slot, generation := keep_handler(cx, h, 102, loc)
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		put_op(o, 1117)
		put_u64(o, s.h)
		put_u32(o, slot)
		put_u32(o, generation)
		r := state_get(s.h, cx, req[:], loc)
		return {rd_u64(&r), slot}
	},
}

// Combobox_State_Builder is the chain of ComboboxState's `self -> Self` methods; build makes the entity, in one crossing.
Combobox_State_Builder :: struct {
	using vt: ^Combobox_State_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Combobox_State_Builder_VT :: struct {
	multiple: proc(b: Combobox_State_Builder, multiple: bool) -> Combobox_State_Builder,
	searchable: proc(b: Combobox_State_Builder, searchable: bool) -> Combobox_State_Builder,
	build: proc(b: Combobox_State_Builder) -> Combobox_State,
}

@(private)
combobox_state_builder_vt := Combobox_State_Builder_VT {
	multiple = proc(b: Combobox_State_Builder, multiple: bool) -> Combobox_State_Builder {
		o := b.req
		put_op(o, 1)
		put_u8(o, u8(multiple))
		o[b.count_at] += 1
		return b
	},
	searchable = proc(b: Combobox_State_Builder, searchable: bool) -> Combobox_State_Builder {
		o := b.req
		put_op(o, 2)
		put_u8(o, u8(searchable))
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Combobox_State_Builder) -> Combobox_State {
		return {state = {h = state_make(b.cx, b.req[:])}, vt = &combobox_state_vt}
	},
}

combobox_state :: proc(cx: ^Cx, delegate: Row_Source, selected_indices: Index_Path_List, loc := #caller_location) -> Combobox_State_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_component_combobox()
	put_op(o, 1107)
	put_u64(o, delegate.h)
	selected_indices_rec: []Base_Index_Path
	switch x in selected_indices {
	case []int:
		selected_indices_rec = make([]Base_Index_Path, len(x), context.temp_allocator)
		for selected_indices_n, selected_indices_i in x {selected_indices_rec[selected_indices_i] = {row = selected_indices_n}}
	case []Base_Index_Path:
		selected_indices_rec = x
	}
	put_u32(o, u32(len(selected_indices_rec)))
	for x0 in selected_indices_rec {
		put_Base_Index_Path(o, x0)
	}
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &combobox_state_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

// Command_State is a handle to gpui_kit::component::command::CommandState, an entity the library keeps.
