	set_masked = proc(s: Otp_State, cx: ^Cx, masked: bool, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_otp_input()
		put_op(o, 298)
		put_u64(o, s.h)
		put_u8(o, u8(masked))
		state_set(cx, req[:], loc)
	},
	set_value = proc(s: Otp_State, cx: ^Cx, value: string, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_otp_input()
		put_op(o, 299)
		put_u64(o, s.h)
		put_str(o, value)
		state_set(cx, req[:], loc)
	},
	on_otp_event = proc(s: Otp_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription {
		slot, generation := keep_handler(cx, h, 95, loc)
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		put_op(o, 300)
		put_u64(o, s.h)
		put_u32(o, slot)
		put_u32(o, generation)
		r := state_get(s.h, cx, req[:], loc)
		return {rd_u64(&r), slot}
	},
}

// Otp_State_Builder is the chain of OtpState's `self -> Self` methods; build makes the entity, in one crossing.
Otp_State_Builder :: struct {
	using vt: ^Otp_State_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Otp_State_Builder_VT :: struct {
	default_value: proc(b: Otp_State_Builder, value: string) -> Otp_State_Builder,
	masked: proc(b: Otp_State_Builder, masked: bool) -> Otp_State_Builder,
	build: proc(b: Otp_State_Builder) -> Otp_State,
}

@(private)
otp_state_builder_vt := Otp_State_Builder_VT {
	default_value = proc(b: Otp_State_Builder, value: string) -> Otp_State_Builder {
		o := b.req
		put_op(o, 1)
		put_str(o, value)
		o[b.count_at] += 1
		return b
	},
	masked = proc(b: Otp_State_Builder, masked: bool) -> Otp_State_Builder {
		o := b.req
		put_op(o, 2)
		put_u8(o, u8(masked))
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Otp_State_Builder) -> Otp_State {
		return {state = {h = state_make(b.cx, b.req[:])}, vt = &otp_state_vt}
	},
}

otp_state :: proc(cx: ^Cx, length: int, loc := #caller_location) -> Otp_State_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_otp_input()
	put_op(o, 297)
	put_usize(o, length)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &otp_state_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

