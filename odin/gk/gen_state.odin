		return {rd_u64(&r), slot}
	},
}

// Calendar_State_Builder is the chain of CalendarState's `self -> Self` methods; build makes the entity, in one crossing.
Calendar_State_Builder :: struct {
	using vt: ^Calendar_State_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Calendar_State_Builder_VT :: struct {
	disabled_matcher: proc(b: Calendar_State_Builder, matcher: Matcher_Into) -> Calendar_State_Builder,
	year_range: proc(b: Calendar_State_Builder, range: Tuple_I32_I32) -> Calendar_State_Builder,
	build: proc(b: Calendar_State_Builder) -> Calendar_State,
}

@(private)
calendar_state_builder_vt := Calendar_State_Builder_VT {
	disabled_matcher = proc(b: Calendar_State_Builder, matcher: Matcher_Into) -> Calendar_State_Builder {
		o := b.req
		put_op(o, 2)
		put_Matcher_Into(o, matcher)
		o[b.count_at] += 1
		return b
	},
	year_range = proc(b: Calendar_State_Builder, range: Tuple_I32_I32) -> Calendar_State_Builder {
		o := b.req
		put_op(o, 1)
		put_u32(o, u32(range.v0))
		put_u32(o, u32(range.v1))
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Calendar_State_Builder) -> Calendar_State {
		return {state = {h = state_make(b.cx, b.req[:])}, vt = &calendar_state_vt}
	},
}

calendar_state :: proc(cx: ^Cx, loc := #caller_location) -> Calendar_State_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_calendar()
	put_op(o, 262)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &calendar_state_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

