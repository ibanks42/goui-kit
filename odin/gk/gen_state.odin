// Input_Content is a handle to gpui_kit::base::input::InputContent, a library object the library keeps (PROTOCOLS.md section 13): a temporary handle when a read, a call or an event hands it out (gk.retain keeps it), a kept one from its constructor.
Input_Content :: struct {
	using state: State,
	using vt: ^Input_Content_VT,
}

Input_Content_VT :: struct {
	text: proc(s: Input_Content, cx: ^Cx, loc := #caller_location) -> Temp_String,
	tokens: proc(s: Input_Content, cx: ^Cx, loc := #caller_location) -> []Inline_Token_Span,
	with_token: proc(s: Input_Content, cx: ^Cx, range: Range, token: Inline_Token, loc := #caller_location) -> Fallible(Input_Content),
}

@(private)
input_content_vt := Input_Content_VT {
	text = proc(s: Input_Content, cx: ^Cx, loc := #caller_location) -> (v: Temp_String) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_input()
		put_op(o, 904)
		put_u64(o, s.h)
		r := obj_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	tokens = proc(s: Input_Content, cx: ^Cx, loc := #caller_location) -> (v: []Inline_Token_Span) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_input()
		put_op(o, 905)
		put_u64(o, s.h)
		r := obj_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	with_token = proc(s: Input_Content, cx: ^Cx, range: Range, token: Inline_Token, loc := #caller_location) -> (v: Fallible(Input_Content)) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_input()
		put_op(o, 1143)
		put_u64(o, s.h)
		put_range(o, range)
		put_vtape(o, token.nd)
		r := state_call(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
}

input_content :: proc(cx: ^Cx, text: string, loc := #caller_location) -> Input_Content {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_input()
	put_op(o, 903)
	put_str(o, text)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {state = {h = state_make(cx, req[:], loc)}, vt = &input_content_vt}
}

