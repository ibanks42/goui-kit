	}
	state_set(cx, req[:], loc)
}

tree_state_set_selected_index :: proc(s: Tree_State, cx: ^Cx, ix: Maybe(int), loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_tree()
	put_op(o, 688)
	put_u64(o, s.h)
	if x0, ok := ix.?; ok {
		put_u8(o, 1)
		put_usize(o, x0)
	} else {
		put_u8(o, 0)
	}
	state_set(cx, req[:], loc)
}

tree_state_set_selected_item :: proc(s: Tree_State, cx: ^Cx, item: Maybe(Tree_Item), loc := #caller_location) {
