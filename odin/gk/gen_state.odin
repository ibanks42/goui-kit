		use_base_input()
		put_op(o, 1726)
		put_u64(o, s.h)
		put_Buffer_Point(o, pos)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	display_map_display_pos_to_buffer_pos = proc(s: Textarea_State, cx: ^Cx, pos: Display_Point, loc := #caller_location) -> (v: Buffer_Point) {
