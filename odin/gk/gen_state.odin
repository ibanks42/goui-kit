	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_component_list()
	put_op(o, 1023)
	put_u64(o, s.h)
	ix_rec: Base_Index_Path
	switch x in ix {
	case int:
		ix_rec = Base_Index_Path{row = x}
	case Base_Index_Path:
		ix_rec = x
	}
	put_Base_Index_Path(o, ix_rec)
	put_u16(o, u16(strategy))
	state_set(cx, req[:], loc)
}

