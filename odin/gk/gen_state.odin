// Text_View_Defaults_Builder is the chain of TextViewDefaults's `self -> Self` methods; build makes the entity, in one crossing.
Text_View_Defaults_Builder :: struct {
	using vt: ^Text_View_Defaults_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Text_View_Defaults_Builder_VT :: struct {
	with_code_block_highlighter: proc(b: Text_View_Defaults_Builder, highlighter: Ask(Code_Block, []Tuple_Range_Highlight_Style)) -> Text_View_Defaults_Builder,
	with_inherit_text_color: proc(b: Text_View_Defaults_Builder, inherit: bool) -> Text_View_Defaults_Builder,
	with_style: proc(b: Text_View_Defaults_Builder, style: Base_Text_View_Style) -> Text_View_Defaults_Builder,
	build: proc(b: Text_View_Defaults_Builder) -> Text_View_Defaults,
}

@(private)
text_view_defaults_builder_vt := Text_View_Defaults_Builder_VT {
	with_code_block_highlighter = proc(b: Text_View_Defaults_Builder, highlighter: Ask(Code_Block, []Tuple_Range_Highlight_Style)) -> Text_View_Defaults_Builder {
		o := b.req
		put_op(o, 2)
		put_u64(o, highlighter.src.h)
		o[b.count_at] += 1
		return b
	},
	with_inherit_text_color = proc(b: Text_View_Defaults_Builder, inherit: bool) -> Text_View_Defaults_Builder {
		o := b.req
		put_op(o, 1)
		put_u8(o, u8(inherit))
		o[b.count_at] += 1
		return b
	},
	with_style = proc(b: Text_View_Defaults_Builder, style: Base_Text_View_Style) -> Text_View_Defaults_Builder {
		o := b.req
		put_op(o, 3)
		put_vtape(o, style.nd)
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Text_View_Defaults_Builder) -> Text_View_Defaults {
		return {state = {h = state_make(b.cx, b.req[:])}, vt = &text_view_defaults_vt}
	},
}

