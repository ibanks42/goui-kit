		o := &req
		use_base_touch_selection()
		put_op(o, 833)
		put_u64(o, s.h)
		r := obj_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
}

@(init, private)
reg_transition_state :: proc "contextless" () {
	register_obj(typeid_of(Transition_State), &transition_state_vt)
}

// Transition_State is a handle to gpui_kit::base::TransitionState<f32>, a library object the library keeps (PROTOCOLS.md section 13): a temporary handle when a read, a call or an event hands it out (gk.retain keeps it), a kept one from its constructor.
Transition_State :: struct {
	using state: State,
	using vt: ^Transition_State_VT,
}

Transition_State_VT :: struct {
	sample: proc(s: Transition_State, cx: ^Cx, target: f32, policy: Transition, loc := #caller_location) -> Motion_Value_F32,
}

@(private)
transition_state_vt := Transition_State_VT {
	sample = proc(s: Transition_State, cx: ^Cx, target: f32, policy: Transition, loc := #caller_location) -> (v: Motion_Value_F32) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_motion()
		put_op(o, 1680)
		put_u64(o, s.h)
		put_f32(o, target)
		put_vtape(o, policy.nd)
		r := state_call(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
}

transition_state_default :: proc(cx: ^Cx, loc := #caller_location) -> Transition_State {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_motion()
	put_op(o, 1679)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {state = {h = state_make(cx, req[:], loc)}, vt = &transition_state_vt}
}

// Tree_State is a handle to gpui_kit::base::TreeState, an entity the library keeps.
Tree_State :: struct {
	using state: State,
	using vt: ^Tree_State_VT,
}

Tree_State_VT :: struct {
	entry: proc(s: Tree_State, cx: ^Cx, ix: int, loc := #caller_location) -> Maybe(Base_Tree_Entry),
	index_of: proc(s: Tree_State, cx: ^Cx, id: string, loc := #caller_location) -> Maybe(int),
	scroll_handle: proc(s: Tree_State, cx: ^Cx, loc := #caller_location) -> Scroll_Handle,
	selected_entry: proc(s: Tree_State, cx: ^Cx, loc := #caller_location) -> Maybe(Base_Tree_Entry),
	selected_index: proc(s: Tree_State, cx: ^Cx, loc := #caller_location) -> Maybe(int),
	selected_item: proc(s: Tree_State, cx: ^Cx, loc := #caller_location) -> Maybe(Base_Tree_Item),
	focus: proc(s: Tree_State, cx: ^Cx, loc := #caller_location),
	reveal_item: proc(s: Tree_State, cx: ^Cx, id: string, strategy: Scroll_Strategy, loc := #caller_location),
	scroll_to_item: proc(s: Tree_State, cx: ^Cx, ix: int, strategy: Scroll_Strategy, loc := #caller_location),
	set_items: proc(s: Tree_State, cx: ^Cx, items: []Tree_Item, loc := #caller_location),
	set_selected_index: proc(s: Tree_State, cx: ^Cx, ix: Maybe(int), loc := #caller_location),
	set_selected_item: proc(s: Tree_State, cx: ^Cx, item: Maybe(Tree_Item), loc := #caller_location),
	on_tree_event: proc(s: Tree_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription,
}

@(private)
tree_state_vt := Tree_State_VT {
	entry = proc(s: Tree_State, cx: ^Cx, ix: int, loc := #caller_location) -> (v: Maybe(Base_Tree_Entry)) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_tree()
		put_op(o, 841)
		put_u64(o, s.h)
		put_usize(o, ix)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	index_of = proc(s: Tree_State, cx: ^Cx, id: string, loc := #caller_location) -> (v: Maybe(int)) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_tree()
		put_op(o, 682)
		put_u64(o, s.h)
		put_str(o, id)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	scroll_handle = proc(s: Tree_State, cx: ^Cx, loc := #caller_location) -> (v: Scroll_Handle) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_tree()
		put_op(o, 1640)
		put_u64(o, s.h)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	selected_entry = proc(s: Tree_State, cx: ^Cx, loc := #caller_location) -> (v: Maybe(Base_Tree_Entry)) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_tree()
		put_op(o, 842)
		put_u64(o, s.h)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	selected_index = proc(s: Tree_State, cx: ^Cx, loc := #caller_location) -> (v: Maybe(int)) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_tree()
		put_op(o, 686)
		put_u64(o, s.h)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	selected_item = proc(s: Tree_State, cx: ^Cx, loc := #caller_location) -> (v: Maybe(Base_Tree_Item)) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_tree()
		put_op(o, 687)
		put_u64(o, s.h)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	focus = proc(s: Tree_State, cx: ^Cx, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_tree()
		put_op(o, 681)
		put_u64(o, s.h)
		state_set(cx, req[:], loc)
	},
	reveal_item = proc(s: Tree_State, cx: ^Cx, id: string, strategy: Scroll_Strategy, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_tree()
		put_op(o, 684)
		put_u64(o, s.h)
		put_str(o, id)
		put_u16(o, u16(strategy))
		state_set(cx, req[:], loc)
	},
	scroll_to_item = proc(s: Tree_State, cx: ^Cx, ix: int, strategy: Scroll_Strategy, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_tree()
		put_op(o, 685)
		put_u64(o, s.h)
		put_usize(o, ix)
		put_u16(o, u16(strategy))
		state_set(cx, req[:], loc)
	},
	set_items = proc(s: Tree_State, cx: ^Cx, items: []Tree_Item, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_tree()
		put_op(o, 843)
		put_u64(o, s.h)
		put_u32(o, u32(len(items)))
		for x0 in items {
			put_vtape(o, x0.nd)
		}
		state_set(cx, req[:], loc)
	},
	set_selected_index = proc(s: Tree_State, cx: ^Cx, ix: Maybe(int), loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_tree()
		put_op(o, 688)
		put_u64(o, s.h)
		if x0, ok := ix.?; ok {
			put_u8(o, 1)
			put_usize(o, x0)
		} else {
			put_u8(o, 0)
		}
		state_set(cx, req[:], loc)
	},
	set_selected_item = proc(s: Tree_State, cx: ^Cx, item: Maybe(Tree_Item), loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_tree()
		put_op(o, 844)
		put_u64(o, s.h)
		if x0, ok := item.?; ok {
			put_u8(o, 1)
			put_vtape(o, x0.nd)
		} else {
			put_u8(o, 0)
		}
		state_set(cx, req[:], loc)
	},
	on_tree_event = proc(s: Tree_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription {
		slot, generation := keep_handler(cx, h, 86, loc)
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		put_op(o, 689)
		put_u64(o, s.h)
		put_u32(o, slot)
		put_u32(o, generation)
		r := state_get(s.h, cx, req[:], loc)
		return {rd_u64(&r), slot}
	},
}

// Tree_State_Builder is the chain of TreeState's `self -> Self` methods; build makes the entity, in one crossing.
Tree_State_Builder :: struct {
	using vt: ^Tree_State_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Tree_State_Builder_VT :: struct {
	items: proc(b: Tree_State_Builder, items: []Tree_Item) -> Tree_State_Builder,
	build: proc(b: Tree_State_Builder) -> Tree_State,
}

@(private)
tree_state_builder_vt := Tree_State_Builder_VT {
	items = proc(b: Tree_State_Builder, items: []Tree_Item) -> Tree_State_Builder {
		o := b.req
		put_op(o, 1)
		put_u32(o, u32(len(items)))
		for x0 in items {
			put_vtape(o, x0.nd)
		}
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Tree_State_Builder) -> Tree_State {
		return {state = {h = state_make(b.cx, b.req[:])}, vt = &tree_state_vt}
	},
}

tree_state :: proc(cx: ^Cx, loc := #caller_location) -> Tree_State_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_tree()
	put_op(o, 683)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &tree_state_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

