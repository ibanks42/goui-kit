}

pane_tree_set_active :: proc(s: Pane_Tree, cx: ^Cx, node: Node_Id, ix: int, loc := #caller_location) -> (v: Edit_Result) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_dock()
	put_op(o, 879)
	put_u64(o, s.h)
	put_u64(o, u64(node))
	put_usize(o, ix)
	r := state_call(s.h, cx, req[:], loc)
