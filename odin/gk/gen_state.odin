	ix_rec: Maybe(Base_Index_Path)
	switch x in ix {
	case int:
		ix_rec = Base_Index_Path{row = x}
	case Base_Index_Path:
		ix_rec = x
	}
	if x0, ok := ix_rec.?; ok {
		put_u8(o, 1)
		put_Base_Index_Path(o, x0)
