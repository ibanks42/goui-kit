// Scale_Band_Builder is the chain of ScaleBand's `self -> Self` methods; build makes the entity, in one crossing.
Scale_Band_Builder :: struct {
	using vt: ^Scale_Band_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Scale_Band_Builder_VT :: struct {
	band_count: proc(b: Scale_Band_Builder, count: int) -> Scale_Band_Builder,
	max_band_width: proc(b: Scale_Band_Builder, width: f32) -> Scale_Band_Builder,
	padding_inner: proc(b: Scale_Band_Builder, padding_inner: f32) -> Scale_Band_Builder,
	padding_outer: proc(b: Scale_Band_Builder, padding_outer: f32) -> Scale_Band_Builder,
	build: proc(b: Scale_Band_Builder) -> Scale_Band,
}

@(private)
scale_band_builder_vt := Scale_Band_Builder_VT {
	band_count = proc(b: Scale_Band_Builder, count: int) -> Scale_Band_Builder {
		o := b.req
		put_op(o, 1)
		put_usize(o, count)
		o[b.count_at] += 1
		return b
	},
	max_band_width = proc(b: Scale_Band_Builder, width: f32) -> Scale_Band_Builder {
		o := b.req
		put_op(o, 2)
		put_f32(o, width)
		o[b.count_at] += 1
		return b
	},
	padding_inner = proc(b: Scale_Band_Builder, padding_inner: f32) -> Scale_Band_Builder {
		o := b.req
		put_op(o, 3)
		put_f32(o, padding_inner)
		o[b.count_at] += 1
		return b
	},
	padding_outer = proc(b: Scale_Band_Builder, padding_outer: f32) -> Scale_Band_Builder {
		o := b.req
		put_op(o, 4)
		put_f32(o, padding_outer)
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Scale_Band_Builder) -> Scale_Band {
		return {state = {h = state_make(b.cx, b.req[:])}}
	},
}

scale_band :: proc(cx: ^Cx, domain: []string, range: [2]f32, loc := #caller_location) -> Scale_Band_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_root()
	put_op(o, 1148)
	put_u32(o, u32(len(domain)))
	for x0 in domain {
		put_str(o, x0)
	}
	for x0 in range {
		put_f32(o, x0)
	}
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &scale_band_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

