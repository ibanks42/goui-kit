// Get the wrap row count (before folding)
display_map_wrap_row_count :: proc(s: Display_Map, cx: ^Cx, loc := #caller_location) -> (v: int) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_input()
	put_op(o, 1265)
	put_u64(o, s.h)
	r := obj_get(s.h, cx, req[:], loc)
