	on_questionnaire_event = proc(s: Questionnaire_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription {
		slot, generation := keep_handler(cx, h, 89, loc)
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		put_op(o, 1102)
		put_u64(o, s.h)
		put_u32(o, slot)
		put_u32(o, generation)
		r := state_get(s.h, cx, req[:], loc)
		return {rd_u64(&r), slot}
	},
}

// Questionnaire_State_Builder is the chain of QuestionnaireState's `self -> Self` methods; build makes the entity, in one crossing.
Questionnaire_State_Builder :: struct {
	using vt: ^Questionnaire_State_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Questionnaire_State_Builder_VT :: struct {
	with_current_item: proc(b: Questionnaire_State_Builder, name: string) -> Questionnaire_State_Builder,
	with_shortcuts: proc(b: Questionnaire_State_Builder, mode: Questionnaire_Shortcut_Mode) -> Questionnaire_State_Builder,
	build: proc(b: Questionnaire_State_Builder) -> Questionnaire_State,
}

@(private)
questionnaire_state_builder_vt := Questionnaire_State_Builder_VT {
	with_current_item = proc(b: Questionnaire_State_Builder, name: string) -> Questionnaire_State_Builder {
		o := b.req
		put_op(o, 1)
		put_str(o, name)
		o[b.count_at] += 1
		return b
	},
	with_shortcuts = proc(b: Questionnaire_State_Builder, mode: Questionnaire_Shortcut_Mode) -> Questionnaire_State_Builder {
		o := b.req
		put_op(o, 2)
		put_u16(o, u16(mode))
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Questionnaire_State_Builder) -> Questionnaire_State {
		return {state = {h = state_make(b.cx, b.req[:])}, vt = &questionnaire_state_vt}
	},
}

questionnaire_state :: proc(cx: ^Cx, items: []Questionnaire_Item_Definition, loc := #caller_location) -> Questionnaire_State_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_questionnaire()
	put_op(o, 1089)
	put_u32(o, u32(len(items)))
	for x0 in items {
		put_vtape(o, x0.nd)
	}
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &questionnaire_state_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

@(init, private)
reg_questionnaire_submission :: proc "contextless" () {
	register_obj(typeid_of(Questionnaire_Submission), &questionnaire_submission_vt)
}

// Questionnaire_Submission is a handle to gpui_kit::base::questionnaire::QuestionnaireSubmission, a library object the library keeps (PROTOCOLS.md section 13): a temporary handle when a read, a call or an event hands it out (gk.retain keeps it), a kept one from its constructor.
Questionnaire_Submission :: struct {
	using state: State,
	using vt: ^Questionnaire_Submission_VT,
}

Questionnaire_Submission_VT :: struct {
	answer: proc(s: Questionnaire_Submission, cx: ^Cx, name: string, loc := #caller_location) -> Maybe(Questionnaire_Answer_Read),
	items: proc(s: Questionnaire_Submission, cx: ^Cx, loc := #caller_location) -> []Questionnaire_Submission_Item,
}

@(private)
questionnaire_submission_vt := Questionnaire_Submission_VT {
	answer = proc(s: Questionnaire_Submission, cx: ^Cx, name: string, loc := #caller_location) -> (v: Maybe(Questionnaire_Answer_Read)) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_questionnaire()
		put_op(o, 1432)
		put_u64(o, s.h)
		put_str(o, name)
		r := obj_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	items = proc(s: Questionnaire_Submission, cx: ^Cx, loc := #caller_location) -> (v: []Questionnaire_Submission_Item) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_questionnaire()
		put_op(o, 1433)
		put_u64(o, s.h)
		r := obj_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
}

questionnaire_submission_default :: proc(cx: ^Cx, loc := #caller_location) -> Questionnaire_Submission {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_questionnaire()
	put_op(o, 1485)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {state = {h = state_make(cx, req[:], loc)}, vt = &questionnaire_submission_vt}
}

@(init, private)
reg_questionnaire_submission_item :: proc "contextless" () {
	register_obj(typeid_of(Questionnaire_Submission_Item), &questionnaire_submission_item_vt)
}

// Questionnaire_Submission_Item is a handle to gpui_kit::base::questionnaire::QuestionnaireSubmissionItem, a library object the library keeps (PROTOCOLS.md section 13): a temporary handle when a read, a call or an event hands it out (gk.retain keeps it), a kept one from its constructor.
Questionnaire_Submission_Item :: struct {
	using state: State,
	using vt: ^Questionnaire_Submission_Item_VT,
}

Questionnaire_Submission_Item_VT :: struct {
	answer: proc(s: Questionnaire_Submission_Item, cx: ^Cx, loc := #caller_location) -> Questionnaire_Answer_Read,
	name: proc(s: Questionnaire_Submission_Item, cx: ^Cx, loc := #caller_location) -> Temp_String,
	status: proc(s: Questionnaire_Submission_Item, cx: ^Cx, loc := #caller_location) -> Questionnaire_Item_Status,
}

@(private)
