	rd_into(&r, &v)
	return
}

// Samples the sequence and requests a frame while a step is active.
sequence_sample :: proc(s: Sequence, cx: ^Cx, loc := #caller_location) -> (v: Sequence_Sample) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_motion()
