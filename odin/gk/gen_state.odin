}

// Get the tick of the scale.
scale_linear_tick :: proc(s: Scale_Linear, cx: ^Cx, value: f64, loc := #caller_location) -> (v: Maybe(f32)) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_plot()
	put_op(o, 1153)
	put_u64(o, s.h)
	put_u64(o, transmute(u64)f64(value))
	r := obj_get(s.h, cx, req[:], loc)
	rd_into(&r, &v)
	return
}

// Map the extent of `domain` onto `range`: the smallest domain value to `range`0`` and the largest
// to `range`1``, so a reversed range such as `height, 0.` puts larger values higher.
scale_linear :: proc(cx: ^Cx, domain: []f64, range: [2]f32, loc := #caller_location) -> Scale_Linear {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_plot()
	put_op(o, 1152)
	put_u32(o, u32(len(domain)))
	for x0 in domain {
		put_u64(o, transmute(u64)f64(x0))
	}
	for x0 in range {
		put_f32(o, x0)
	}
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {state = {h = state_make(cx, req[:], loc)}}
}

// Scale_Ordinal is a handle to gpui_kit::base::plot::scale::ScaleOrdinal<gpui_kit::SharedString, gpui_kit::Hsla>, a library object the library keeps (PROTOCOLS.md section 13): a temporary handle when a read, a call or an event hands it out (gk.retain keeps it), a kept one from its constructor. Its procedures are named scale_ordinal_*.
Scale_Ordinal :: struct {
