// History_Builder is the chain of History's `self -> Self` methods; build makes the entity, in one crossing.
History_Builder :: struct {
	using vt: ^History_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

History_Builder_VT :: struct {
	max_entries: proc(b: History_Builder, max_entries: int) -> History_Builder,
	build: proc(b: History_Builder) -> History,
}

