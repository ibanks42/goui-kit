	return
}

// Ask the container to close `panel`. Nothing happens for a panel that is not in this group, or
// when either the group or the panel refuses.
tab_group_close_panel :: proc(s: Tab_Group, cx: ^Cx, panel: Dock_Panel_Id, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_dock()
	put_op(o, 1561)
	put_u64(o, s.h)
	put_u64(o, u64(panel))
	state_set(cx, req[:], loc)
}

// Display `ix`, if it names a tab that is not already displayed.
tab_group_select_tab :: proc(s: Tab_Group, cx: ^Cx, ix: int, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_dock()
	put_op(o, 1568)
	put_u64(o, s.h)
	put_usize(o, ix)
	state_set(cx, req[:], loc)
}

tab_group_toggle_zoom :: proc(s: Tab_Group, cx: ^Cx, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_dock()
	put_op(o, 1570)
	put_u64(o, s.h)
	state_set(cx, req[:], loc)
}

tab_group_on_tab_group_event :: proc(s: Tab_Group, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription {
	slot, generation := keep_handler(cx, h, 88, loc)
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	put_op(o, 1569)
	put_u64(o, s.h)
	put_u32(o, slot)
	put_u32(o, generation)
	r := state_get(s.h, cx, req[:], loc)
	return {rd_u64(&r), slot}
}

// Tab_Group_Builder is the chain of TabGroup's `self -> Self` methods; build makes the entity, in one crossing.
Tab_Group_Builder :: struct {
	using vt: ^Tab_Group_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Tab_Group_Builder_VT :: struct {
	with_renderer: proc(b: Tab_Group_Builder, renderer: Dock_Renderer) -> Tab_Group_Builder,
	build: proc(b: Tab_Group_Builder) -> Tab_Group,
}

@(private)
tab_group_builder_vt := Tab_Group_Builder_VT {
	with_renderer = proc(b: Tab_Group_Builder, renderer: Dock_Renderer) -> Tab_Group_Builder {
		o := b.req
		put_op(o, 1)
		put_u64(o, renderer.h)
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Tab_Group_Builder) -> Tab_Group {
		return {state = {h = state_make(b.cx, b.req[:])}}
	},
}

// What a skin needs to draw a tab group, and the callbacks it invokes rather than reimplementing
// behavior.
//
// Tab_Group_Context is a handle to gpui_kit::base::dock::TabGroupContext, a library object the library keeps (PROTOCOLS.md section 13): a temporary handle when a read, a call or an event hands it out (gk.retain keeps it), a kept one from its constructor. Its procedures are named tab_group_context_*.
Tab_Group_Context :: struct {
	using state: State,
}

tab_group_context_active_ix :: proc(s: Tab_Group_Context, cx: ^Cx, loc := #caller_location) -> (v: int) {
