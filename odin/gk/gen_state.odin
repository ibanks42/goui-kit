display_map_on_layout_changed :: proc(s: Display_Map, cx: ^Cx, wrap_width: Maybe(f32), loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_input()
	put_op(o, 1257)
	put_u64(o, s.h)
	if x0, ok := wrap_width.?; ok {
		put_u8(o, 1)
		put_f32(o, x0)
	} else {
		put_u8(o, 0)
	}
	state_set(cx, req[:], loc)
}

display_map_set_fold_candidates :: proc(s: Display_Map, cx: ^Cx, candidates: []Fold_Range, loc := #caller_location) {
