	put_str(o, path)
	put_u16(o, u16(side))
	put_usize(o, line)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {state = {h = state_make(cx, req[:], loc)}, vt = &diff_line_position_vt}
}

