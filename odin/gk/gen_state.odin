		put_usize(o, line)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	display_map_buffer_pos_to_display_pos = proc(s: Textarea_State, cx: ^Cx, pos: Buffer_Point, loc := #caller_location) -> (v: Display_Point) {
		req := make(Tape, 0, 32, context.temp_allocator)
