		o := b.req
		put_op(o, 1)
		put_u16(o, u16(axis))
		o[b.count_at] += 1
		return b
	},
	with_looping = proc(b: Carousel_State_Builder, looping: bool) -> Carousel_State_Builder {
		o := b.req
		put_op(o, 2)
		put_u8(o, u8(looping))
		o[b.count_at] += 1
		return b
