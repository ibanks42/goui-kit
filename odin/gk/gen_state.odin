// Sequence_Builder is the chain of Sequence's `self -> Self` methods; build makes the entity, in one crossing.
Sequence_Builder :: struct {
	using vt: ^Sequence_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Sequence_Builder_VT :: struct {
	with_step: proc(b: Sequence_Builder, target: f32, transition: Transition) -> Sequence_Builder,
	with_steps: proc(b: Sequence_Builder, steps: []Sequence_Step) -> Sequence_Builder,
	build: proc(b: Sequence_Builder) -> Sequence,
}

@(private)
sequence_builder_vt := Sequence_Builder_VT {
	with_step = proc(b: Sequence_Builder, target: f32, transition: Transition) -> Sequence_Builder {
		o := b.req
		put_op(o, 2)
		put_f32(o, target)
		put_vtape(o, transition.nd)
		o[b.count_at] += 1
		return b
	},
	with_steps = proc(b: Sequence_Builder, steps: []Sequence_Step) -> Sequence_Builder {
		o := b.req
		put_op(o, 1)
		put_u32(o, u32(len(steps)))
		for x0 in steps {
			put_u64(o, x0.h)
		}
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Sequence_Builder) -> Sequence {
		return {state = {h = state_make(b.cx, b.req[:])}}
	},
}

sequence :: proc(cx: ^Cx, id: Transition_Id_Into, from: f32, loc := #caller_location) -> Sequence_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_motion()
	put_op(o, 1132)
	put_Transition_Id_Into(o, id)
	put_f32(o, from)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &sequence_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

