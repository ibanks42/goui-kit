	resize_item: proc(s: Grid_Layout_State, cx: ^Cx, id: string, col_span: int, row_span: int, loc := #caller_location) -> bool,
	on_grid_layout_event: proc(s: Grid_Layout_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription,
}

@(private)
grid_layout_state_vt := Grid_Layout_State_VT {
