	o := &req
	use_base_input()
	put_op(o, 510)
	put_u64(o, s.h)
	if x0, ok := lines.?; ok {
		put_u8(o, 1)
		put_usize(o, x0)
	} else {
		put_u8(o, 0)
	}
	state_set(cx, req[:], loc)
}

