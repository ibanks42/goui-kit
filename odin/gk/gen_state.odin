	series: proc(s: Stack, cx: ^Cx, loc := #caller_location) -> []Stack_Series,
}

@(private)
stack_vt := Stack_VT {
	series = proc(s: Stack, cx: ^Cx, loc := #caller_location) -> (v: []Stack_Series) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_plot()
		put_op(o, 1639)
		put_u64(o, s.h)
		r := obj_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
}

// Stack_Builder is the chain of Stack's `self -> Self` methods; build makes the entity, in one crossing.
Stack_Builder :: struct {
	using vt: ^Stack_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Stack_Builder_VT :: struct {
	data: proc(b: Stack_Builder, data: Data) -> Stack_Builder,
	keys: proc(b: Stack_Builder, keys: []string) -> Stack_Builder,
	value: proc(b: Stack_Builder, value: string) -> Stack_Builder,
	build: proc(b: Stack_Builder) -> Stack,
}

@(private)
stack_builder_vt := Stack_Builder_VT {
	data = proc(b: Stack_Builder, data: Data) -> Stack_Builder {
		o := b.req
		put_op(o, 1)
		put_data(o, data)
		o[b.count_at] += 1
		return b
	},
	keys = proc(b: Stack_Builder, keys: []string) -> Stack_Builder {
		o := b.req
		put_op(o, 2)
		put_u32(o, u32(len(keys)))
		for x0 in keys {
			put_str(o, x0)
		}
		o[b.count_at] += 1
		return b
	},
	value = proc(b: Stack_Builder, value: string) -> Stack_Builder {
		o := b.req
		put_op(o, 3)
		put_field(o, value, .Opt)
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Stack_Builder) -> Stack {
		return {state = {h = state_make(b.cx, b.req[:])}, vt = &stack_vt}
	},
}

stack :: proc(cx: ^Cx, loc := #caller_location) -> Stack_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_plot()
	put_op(o, 1638)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &stack_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

