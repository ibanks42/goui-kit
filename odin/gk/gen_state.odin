	set_selection: proc(s: Table_State, cx: ^Cx, selection: Table_Selection, loc := #caller_location),
	delegate_mut: proc(s: Table_State, cx: ^Cx, loc := #caller_location) -> Row_Source,
	fit_col: proc(s: Table_State, cx: ^Cx, col_ix: int, loc := #caller_location) -> bool,
	on_table_event: proc(s: Table_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription,
}

@(private)
table_state_vt := Table_State_VT {
	col_width = proc(s: Table_State, cx: ^Cx, col_ix: int, loc := #caller_location) -> (v: Maybe(f32)) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_table()
		put_op(o, 701)
		put_u64(o, s.h)
		put_usize(o, col_ix)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	delegate = proc(s: Table_State, cx: ^Cx, loc := #caller_location) -> (v: Row_Source) {
		req := make(Tape, 0, 32, context.temp_allocator)
