// Color_Picker_State_Builder is the chain of ColorPickerState's `self -> Self` methods; build makes the entity, in one crossing.
Color_Picker_State_Builder :: struct {
	using vt: ^Color_Picker_State_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Color_Picker_State_Builder_VT :: struct {
	default_value: proc(b: Color_Picker_State_Builder, value: Color) -> Color_Picker_State_Builder,
	build: proc(b: Color_Picker_State_Builder) -> Color_Picker_State,
}

@(private)
color_picker_state_builder_vt := Color_Picker_State_Builder_VT {
	default_value = proc(b: Color_Picker_State_Builder, value: Color) -> Color_Picker_State_Builder {
		o := b.req
		put_op(o, 1)
		put_color(o, value)
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Color_Picker_State_Builder) -> Color_Picker_State {
		return {state = {h = state_make(b.cx, b.req[:])}, vt = &color_picker_state_vt}
	},
}

color_picker_state :: proc(cx: ^Cx, loc := #caller_location) -> Color_Picker_State_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_color_picker()
	put_op(o, 280)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &color_picker_state_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

