		return
	},
	display_map_buffer_line_to_display_row = proc(s: Textarea_State, cx: ^Cx, line: int, loc := #caller_location) -> (v: int) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_input()
