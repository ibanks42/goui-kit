@(private)
input_state_vt := Input_State_VT {
	content = proc(s: Input_State, cx: ^Cx, loc := #caller_location) -> (v: Input_Content) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_input()
		put_op(o, 916)
		put_u64(o, s.h)
