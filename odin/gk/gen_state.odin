	return
}

// Get the current selected value.
select_state_selected_value :: proc(s: Select_State, cx: ^Cx, loc := #caller_location) -> (v: Maybe(Temp_String)) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_component_select()
	put_op(o, 1171)
	put_u64(o, s.h)
	r := state_get(s.h, cx, req[:], loc)
	rd_into(&r, &v)
	return
}

// Focus the select trigger input.
select_state_focus :: proc(s: Select_State, cx: ^Cx, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_component_select()
	put_op(o, 1118)
	put_u64(o, s.h)
	state_set(cx, req[:], loc)
}

// Replace the delegate (item data) for the select state.
select_state_set_items :: proc(s: Select_State, cx: ^Cx, items: Row_Source, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_component_select()
	put_op(o, 1121)
	put_u64(o, s.h)
	put_u64(o, items.h)
	state_set(cx, req[:], loc)
}

// Set the selected index for the select.
select_state_set_selected_index :: proc(s: Select_State, cx: ^Cx, selected_index: Maybe_Index_Path, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_component_select()
	put_op(o, 1122)
	put_u64(o, s.h)
	selected_index_rec: Maybe(Base_Index_Path)
	switch x in selected_index {
	case int:
		selected_index_rec = Base_Index_Path{row = x}
	case Base_Index_Path:
		selected_index_rec = x
	}
	if x0, ok := selected_index_rec.?; ok {
		put_u8(o, 1)
		put_Base_Index_Path(o, x0)
	} else {
		put_u8(o, 0)
	}
	state_set(cx, req[:], loc)
}

// Set selected value for the select.
//
// Looks up the position from the delegate and sets the selected index accordingly. Passes `None`
// when the value is not found.
//
// The delegate looks the value up in its matched items, so an active search query is cleared first
// to get an index into the full item list.
select_state_set_selected_value :: proc(s: Select_State, cx: ^Cx, selected_value: string, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_component_select()
	put_op(o, 1172)
	put_u64(o, s.h)
	put_str(o, selected_value)
	state_set(cx, req[:], loc)
}

select_state_on_select_event :: proc(s: Select_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription {
	slot, generation := keep_handler(cx, h, 103, loc)
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	put_op(o, 1123)
	put_u64(o, s.h)
	put_u32(o, slot)
	put_u32(o, generation)
	r := state_get(s.h, cx, req[:], loc)
	return {rd_u64(&r), slot}
}

// Select_State_Builder is the chain of SelectState's `self -> Self` methods; build makes the entity, in one crossing.
Select_State_Builder :: struct {
	using vt: ^Select_State_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Select_State_Builder_VT :: struct {
	// Sets whether the dropdown menu is searchable, default is `false`.
	//
	// When `true`, a search input appears at the top of the dropdown menu.
	searchable: proc(b: Select_State_Builder, searchable: bool) -> Select_State_Builder,
	build: proc(b: Select_State_Builder) -> Select_State,
}

@(private)
select_state_builder_vt := Select_State_Builder_VT {
	searchable = proc(b: Select_State_Builder, searchable: bool) -> Select_State_Builder {
		o := b.req
		put_op(o, 1)
		put_u8(o, u8(searchable))
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Select_State_Builder) -> Select_State {
		return {state = {h = state_make(b.cx, b.req[:])}}
	},
}

// Create a new Select state.
select_state :: proc(cx: ^Cx, delegate: Row_Source, selected_index: Maybe_Index_Path, loc := #caller_location) -> Select_State_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_component_select()
	put_op(o, 1119)
	put_u64(o, delegate.h)
	selected_index_rec: Maybe(Base_Index_Path)
	switch x in selected_index {
	case int:
		selected_index_rec = Base_Index_Path{row = x}
	case Base_Index_Path:
		selected_index_rec = x
	}
	if x0, ok := selected_index_rec.?; ok {
		put_u8(o, 1)
		put_Base_Index_Path(o, x0)
	} else {
		put_u8(o, 0)
	}
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &select_state_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

// Sequence is a handle to gpui_kit::base::Sequence<f32>, a library object the library keeps (PROTOCOLS.md section 13): a temporary handle when a read, a call or an event hands it out (gk.retain keeps it), a kept one from its constructor. Its procedures are named sequence_*.
Sequence :: struct {
