pane_tree_insert_panel :: proc(s: Pane_Tree, cx: ^Cx, panel: Dock_Panel_Id, target: Insert_Target, loc := #caller_location) -> (v: Edit_Result) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_dock()
	put_op(o, 1555)
	put_u64(o, s.h)
	put_u64(o, u64(panel))
	put_Insert_Target(o, target)
	r := state_call(s.h, cx, req[:], loc)
	rd_into(&r, &v)
	return
}

// Move a panel to a new home without ever removing it from the tree's perspective, so the caller
// never fires `on_removed` for a drag.
pane_tree_move_panel :: proc(s: Pane_Tree, cx: ^Cx, panel: Dock_Panel_Id, target: Insert_Target, loc := #caller_location) -> (v: Edit_Result) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_dock()
	put_op(o, 1556)
	put_u64(o, s.h)
	put_u64(o, u64(panel))
	put_Insert_Target(o, target)
	r := state_call(s.h, cx, req[:], loc)
	rd_into(&r, &v)
	return
}

pane_tree_remove_panel :: proc(s: Pane_Tree, cx: ^Cx, panel: Dock_Panel_Id, loc := #caller_location) -> (v: Edit_Result) {
	req := make(Tape, 0, 32, context.temp_allocator)
