	max_entries = proc(b: History_Builder, max_entries: int) -> History_Builder {
		o := b.req
		put_op(o, 1)
		put_usize(o, max_entries)
		o[b.count_at] += 1
		return b
	},
	build = proc(b: History_Builder) -> History {
		return {state = {h = state_make(b.cx, b.req[:])}, vt = &history_vt}
	},
}

history :: proc(cx: ^Cx, loc := #caller_location) -> History_Builder {
	req := new(Tape, context.temp_allocator)
