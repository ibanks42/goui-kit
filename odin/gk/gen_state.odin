	o := &req
	use_base_input()
	put_op(o, 1685)
	put_u64(o, s.h)
	state_set(cx, req[:], loc)
}

// Replace all decorations in this collection.
//
// This corresponds to Monaco's `IEditorDecorationsCollection.set`
