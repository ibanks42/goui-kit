	o := &req
	use_base_root()
	put_op(o, 1154)
	put_u64(o, s.h)
	put_str(o, value)
	r := obj_get(s.h, cx, req[:], loc)
	rd_into(&r, &v)
	return
}

// Scale_Ordinal_Builder is the chain of ScaleOrdinal's `self -> Self` methods; build makes the entity, in one crossing.
Scale_Ordinal_Builder :: struct {
	using vt: ^Scale_Ordinal_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Scale_Ordinal_Builder_VT :: struct {
	// Set the domain to the specified array of values.
	domain: proc(b: Scale_Ordinal_Builder, domain: []string) -> Scale_Ordinal_Builder,
	// Set the range of the ordinal scale to the specified array of values.
	range: proc(b: Scale_Ordinal_Builder, range: []Color) -> Scale_Ordinal_Builder,
	// Set the output value of the scale for unknown input values and returns this scale.
	unknown: proc(b: Scale_Ordinal_Builder, unknown: Color) -> Scale_Ordinal_Builder,
	build: proc(b: Scale_Ordinal_Builder) -> Scale_Ordinal,
}

@(private)
scale_ordinal_builder_vt := Scale_Ordinal_Builder_VT {
	domain = proc(b: Scale_Ordinal_Builder, domain: []string) -> Scale_Ordinal_Builder {
		o := b.req
		put_op(o, 1)
		put_u32(o, u32(len(domain)))
		for x0 in domain {
			put_str(o, x0)
		}
		o[b.count_at] += 1
		return b
	},
	range = proc(b: Scale_Ordinal_Builder, range: []Color) -> Scale_Ordinal_Builder {
		o := b.req
		put_op(o, 2)
		put_u32(o, u32(len(range)))
		for x0 in range {
			put_color(o, x0)
		}
		o[b.count_at] += 1
		return b
	},
	unknown = proc(b: Scale_Ordinal_Builder, unknown: Color) -> Scale_Ordinal_Builder {
		o := b.req
		put_op(o, 3)
		put_color(o, unknown)
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Scale_Ordinal_Builder) -> Scale_Ordinal {
		return {state = {h = state_make(b.cx, b.req[:])}}
	},
}

scale_ordinal :: proc(cx: ^Cx, domain: []string, range: []Color, loc := #caller_location) -> Scale_Ordinal_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_root()
	put_op(o, 1155)
	put_u32(o, u32(len(domain)))
	for x0 in domain {
		put_str(o, x0)
	}
	put_u32(o, u32(len(range)))
	for x0 in range {
		put_color(o, x0)
	}
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &scale_ordinal_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

