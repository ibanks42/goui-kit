// Set the index of the item that has been right clicked.
list_state_set_right_clicked_index :: proc(s: List_State, cx: ^Cx, ix: Maybe_Index_Path, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_component_list()
	put_op(o, 1025)
	put_u64(o, s.h)
	ix_rec: Maybe(Base_Index_Path)
	switch x in ix {
	case int:
		ix_rec = Base_Index_Path{row = x}
	case Base_Index_Path:
		ix_rec = x
	}
	if x0, ok := ix_rec.?; ok {
		put_u8(o, 1)
		put_Base_Index_Path(o, x0)
	} else {
		put_u8(o, 0)
	}
	state_set(cx, req[:], loc)
}

