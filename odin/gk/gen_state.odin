// Slider_State_Builder is the chain of SliderState's `self -> Self` methods; build makes the entity, in one crossing.
Slider_State_Builder :: struct {
	using vt: ^Slider_State_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Slider_State_Builder_VT :: struct {
	default_value: proc(b: Slider_State_Builder, value: Slider_Value_Into) -> Slider_State_Builder,
	max: proc(b: Slider_State_Builder, max: f32) -> Slider_State_Builder,
	min: proc(b: Slider_State_Builder, min: f32) -> Slider_State_Builder,
	scale: proc(b: Slider_State_Builder, scale: Slider_Scale) -> Slider_State_Builder,
	step: proc(b: Slider_State_Builder, step: f32) -> Slider_State_Builder,
	build: proc(b: Slider_State_Builder) -> Slider_State,
}

@(private)
slider_state_builder_vt := Slider_State_Builder_VT {
	default_value = proc(b: Slider_State_Builder, value: Slider_Value_Into) -> Slider_State_Builder {
		o := b.req
		put_op(o, 5)
		put_Slider_Value_Into(o, value)
		o[b.count_at] += 1
		return b
	},
	max = proc(b: Slider_State_Builder, max: f32) -> Slider_State_Builder {
		o := b.req
		put_op(o, 1)
		put_f32(o, max)
		o[b.count_at] += 1
		return b
	},
	min = proc(b: Slider_State_Builder, min: f32) -> Slider_State_Builder {
		o := b.req
		put_op(o, 2)
		put_f32(o, min)
		o[b.count_at] += 1
		return b
	},
	scale = proc(b: Slider_State_Builder, scale: Slider_Scale) -> Slider_State_Builder {
		o := b.req
		put_op(o, 3)
		put_u16(o, u16(scale))
		o[b.count_at] += 1
		return b
	},
	step = proc(b: Slider_State_Builder, step: f32) -> Slider_State_Builder {
		o := b.req
		put_op(o, 4)
		put_f32(o, step)
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Slider_State_Builder) -> Slider_State {
		return {state = {h = state_make(b.cx, b.req[:])}, vt = &slider_state_vt}
	},
}

slider_state :: proc(cx: ^Cx, loc := #caller_location) -> Slider_State_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_slider()
	put_op(o, 349)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &slider_state_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

// Speech_State is a handle to gpui_kit::component::speech::SpeechState, an entity the library keeps.
Speech_State :: struct {
	using state: State,
	using vt: ^Speech_State_VT,
}

Speech_State_VT :: struct {
	has_recognizer: proc(s: Speech_State, cx: ^Cx, loc := #caller_location) -> bool,
	is_available: proc(s: Speech_State, cx: ^Cx, loc := #caller_location) -> bool,
	levels: proc(s: Speech_State, cx: ^Cx, loc := #caller_location) -> []f32,
	status: proc(s: Speech_State, cx: ^Cx, loc := #caller_location) -> Speech_Status,
	transcript: proc(s: Speech_State, cx: ^Cx, loc := #caller_location) -> Temp_String,
	cancel: proc(s: Speech_State, cx: ^Cx, loc := #caller_location),
	start: proc(s: Speech_State, cx: ^Cx, loc := #caller_location),
	stop: proc(s: Speech_State, cx: ^Cx, loc := #caller_location),
	toggle: proc(s: Speech_State, cx: ^Cx, loc := #caller_location),
	on_speech_event: proc(s: Speech_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription,
}

@(private)
speech_state_vt := Speech_State_VT {
	has_recognizer = proc(s: Speech_State, cx: ^Cx, loc := #caller_location) -> (v: bool) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_speech()
		put_op(o, 397)
		put_u64(o, s.h)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	is_available = proc(s: Speech_State, cx: ^Cx, loc := #caller_location) -> (v: bool) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_speech()
		put_op(o, 398)
		put_u64(o, s.h)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	levels = proc(s: Speech_State, cx: ^Cx, loc := #caller_location) -> (v: []f32) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_speech()
		put_op(o, 1316)
		put_u64(o, s.h)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	status = proc(s: Speech_State, cx: ^Cx, loc := #caller_location) -> (v: Speech_Status) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_speech()
		put_op(o, 401)
		put_u64(o, s.h)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	transcript = proc(s: Speech_State, cx: ^Cx, loc := #caller_location) -> (v: Temp_String) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_speech()
		put_op(o, 405)
		put_u64(o, s.h)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	cancel = proc(s: Speech_State, cx: ^Cx, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_speech()
		put_op(o, 396)
		put_u64(o, s.h)
		state_set(cx, req[:], loc)
	},
	start = proc(s: Speech_State, cx: ^Cx, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_speech()
		put_op(o, 400)
		put_u64(o, s.h)
		state_set(cx, req[:], loc)
	},
	stop = proc(s: Speech_State, cx: ^Cx, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_speech()
		put_op(o, 402)
		put_u64(o, s.h)
		state_set(cx, req[:], loc)
	},
	toggle = proc(s: Speech_State, cx: ^Cx, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_speech()
		put_op(o, 404)
		put_u64(o, s.h)
		state_set(cx, req[:], loc)
	},
	on_speech_event = proc(s: Speech_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription {
		slot, generation := keep_handler(cx, h, 93, loc)
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		put_op(o, 403)
		put_u64(o, s.h)
		put_u32(o, slot)
		put_u32(o, generation)
		r := state_get(s.h, cx, req[:], loc)
		return {rd_u64(&r), slot}
	},
}

// Speech_State_Builder is the chain of SpeechState's `self -> Self` methods; build makes the entity, in one crossing.
Speech_State_Builder :: struct {
	using vt: ^Speech_State_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Speech_State_Builder_VT :: struct {
	stop_timeout: proc(b: Speech_State_Builder, timeout: time.Duration) -> Speech_State_Builder,
	system_fallback: proc(b: Speech_State_Builder, system_fallback: bool) -> Speech_State_Builder,
	build: proc(b: Speech_State_Builder) -> Speech_State,
}

@(private)
speech_state_builder_vt := Speech_State_Builder_VT {
	stop_timeout = proc(b: Speech_State_Builder, timeout: time.Duration) -> Speech_State_Builder {
		o := b.req
		put_op(o, 1)
		put_ms(o, i64(timeout))
		o[b.count_at] += 1
		return b
	},
	system_fallback = proc(b: Speech_State_Builder, system_fallback: bool) -> Speech_State_Builder {
		o := b.req
		put_op(o, 2)
		put_u8(o, u8(system_fallback))
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Speech_State_Builder) -> Speech_State {
		return {state = {h = state_make(b.cx, b.req[:])}, vt = &speech_state_vt}
	},
}

speech_state :: proc(cx: ^Cx, loc := #caller_location) -> Speech_State_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_component_speech()
	put_op(o, 399)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &speech_state_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

