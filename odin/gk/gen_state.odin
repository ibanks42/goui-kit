	on_diff_event = proc(s: Diff_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription {
		slot, generation := keep_handler(cx, h, 92, loc)
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		put_op(o, 1018)
		put_u64(o, s.h)
		put_u32(o, slot)
