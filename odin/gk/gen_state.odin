// Pie is a handle to gpui_kit::base::plot::shape::Pie<crate::data::Datum>, a library object the library keeps (PROTOCOLS.md section 13): a temporary handle when a read, a call or an event hands it out (gk.retain keeps it), a kept one from its constructor.
Pie :: struct {
	using state: State,
	using vt: ^Pie_VT,
}

Pie_VT :: struct {
	arcs: proc(s: Pie, cx: ^Cx, data: Data, loc := #caller_location) -> []Arc_Data,
}

@(private)
pie_vt := Pie_VT {
	arcs = proc(s: Pie, cx: ^Cx, data: Data, loc := #caller_location) -> (v: []Arc_Data) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_plot()
		put_op(o, 1636)
		put_u64(o, s.h)
		put_data(o, data)
		r := obj_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
}

// Pie_Builder is the chain of Pie's `self -> Self` methods; build makes the entity, in one crossing.
Pie_Builder :: struct {
	using vt: ^Pie_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Pie_Builder_VT :: struct {
	end_angle: proc(b: Pie_Builder, end_angle: f32) -> Pie_Builder,
	pad_angle: proc(b: Pie_Builder, pad_angle: f32) -> Pie_Builder,
	start_angle: proc(b: Pie_Builder, start_angle: f32) -> Pie_Builder,
	value: proc(b: Pie_Builder, value: string) -> Pie_Builder,
	build: proc(b: Pie_Builder) -> Pie,
}

@(private)
pie_builder_vt := Pie_Builder_VT {
	end_angle = proc(b: Pie_Builder, end_angle: f32) -> Pie_Builder {
		o := b.req
		put_op(o, 1)
		put_f32(o, end_angle)
		o[b.count_at] += 1
		return b
	},
	pad_angle = proc(b: Pie_Builder, pad_angle: f32) -> Pie_Builder {
		o := b.req
		put_op(o, 2)
		put_f32(o, pad_angle)
		o[b.count_at] += 1
		return b
	},
	start_angle = proc(b: Pie_Builder, start_angle: f32) -> Pie_Builder {
		o := b.req
		put_op(o, 3)
		put_f32(o, start_angle)
		o[b.count_at] += 1
		return b
	},
	value = proc(b: Pie_Builder, value: string) -> Pie_Builder {
		o := b.req
		put_op(o, 4)
		put_field(o, value, .Opt)
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Pie_Builder) -> Pie {
		return {state = {h = state_make(b.cx, b.req[:])}, vt = &pie_vt}
	},
}

pie :: proc(cx: ^Cx, loc := #caller_location) -> Pie_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_plot()
	put_op(o, 1637)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &pie_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

