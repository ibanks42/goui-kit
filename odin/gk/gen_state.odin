	using state: State,
}

tree_state_entry :: proc(s: Tree_State, cx: ^Cx, ix: int, loc := #caller_location) -> (v: Maybe(Base_Tree_Entry)) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_tree()
	put_op(o, 841)
	put_u64(o, s.h)
	put_usize(o, ix)
	r := state_get(s.h, cx, req[:], loc)
	rd_into(&r, &v)
	return
}

tree_state_index_of :: proc(s: Tree_State, cx: ^Cx, id: string, loc := #caller_location) -> (v: Maybe(int)) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_tree()
	put_op(o, 682)
	put_u64(o, s.h)
	put_str(o, id)
	r := state_get(s.h, cx, req[:], loc)
	rd_into(&r, &v)
	return
}

tree_state_scroll_handle :: proc(s: Tree_State, cx: ^Cx, loc := #caller_location) -> (v: Scroll_Handle) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_tree()
	put_op(o, 1640)
	put_u64(o, s.h)
	r := state_get(s.h, cx, req[:], loc)
	rd_into(&r, &v)
	return
}

tree_state_selected_entry :: proc(s: Tree_State, cx: ^Cx, loc := #caller_location) -> (v: Maybe(Base_Tree_Entry)) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_tree()
	put_op(o, 842)
	put_u64(o, s.h)
	r := state_get(s.h, cx, req[:], loc)
	rd_into(&r, &v)
	return
}

tree_state_selected_index :: proc(s: Tree_State, cx: ^Cx, loc := #caller_location) -> (v: Maybe(int)) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_tree()
	put_op(o, 686)
	put_u64(o, s.h)
	r := state_get(s.h, cx, req[:], loc)
	rd_into(&r, &v)
	return
}

tree_state_selected_item :: proc(s: Tree_State, cx: ^Cx, loc := #caller_location) -> (v: Maybe(Base_Tree_Item)) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_tree()
	put_op(o, 687)
	put_u64(o, s.h)
	r := state_get(s.h, cx, req[:], loc)
	rd_into(&r, &v)
	return
}

tree_state_focus :: proc(s: Tree_State, cx: ^Cx, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_tree()
	put_op(o, 681)
	put_u64(o, s.h)
	state_set(cx, req[:], loc)
}

tree_state_reveal_item :: proc(s: Tree_State, cx: ^Cx, id: string, strategy: Scroll_Strategy, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_tree()
	put_op(o, 684)
	put_u64(o, s.h)
	put_str(o, id)
	put_u16(o, u16(strategy))
	state_set(cx, req[:], loc)
}

tree_state_scroll_to_item :: proc(s: Tree_State, cx: ^Cx, ix: int, strategy: Scroll_Strategy, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_tree()
	put_op(o, 685)
	put_u64(o, s.h)
	put_usize(o, ix)
	put_u16(o, u16(strategy))
	state_set(cx, req[:], loc)
}

tree_state_set_items :: proc(s: Tree_State, cx: ^Cx, items: []Tree_Item, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_tree()
	put_op(o, 843)
	put_u64(o, s.h)
	put_u32(o, u32(len(items)))
	for x0 in items {
		put_vtape(o, x0.nd)
	}
	state_set(cx, req[:], loc)
}

tree_state_set_selected_index :: proc(s: Tree_State, cx: ^Cx, ix: Maybe(int), loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_tree()
	put_op(o, 688)
	put_u64(o, s.h)
	if x0, ok := ix.?; ok {
		put_u8(o, 1)
		put_usize(o, x0)
	} else {
		put_u8(o, 0)
	}
	state_set(cx, req[:], loc)
}

tree_state_set_selected_item :: proc(s: Tree_State, cx: ^Cx, item: Maybe(Tree_Item), loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_tree()
	put_op(o, 844)
	put_u64(o, s.h)
	if x0, ok := item.?; ok {
		put_u8(o, 1)
		put_vtape(o, x0.nd)
	} else {
		put_u8(o, 0)
	}
	state_set(cx, req[:], loc)
}

tree_state_on_tree_event :: proc(s: Tree_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription {
	slot, generation := keep_handler(cx, h, 86, loc)
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	put_op(o, 689)
	put_u64(o, s.h)
	put_u32(o, slot)
	put_u32(o, generation)
	r := state_get(s.h, cx, req[:], loc)
	return {rd_u64(&r), slot}
}

// Tree_State_Builder is the chain of TreeState's `self -> Self` methods; build makes the entity, in one crossing.
Tree_State_Builder :: struct {
	using vt: ^Tree_State_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Tree_State_Builder_VT :: struct {
	items: proc(b: Tree_State_Builder, items: []Tree_Item) -> Tree_State_Builder,
	build: proc(b: Tree_State_Builder) -> Tree_State,
}

@(private)
tree_state_builder_vt := Tree_State_Builder_VT {
	items = proc(b: Tree_State_Builder, items: []Tree_Item) -> Tree_State_Builder {
		o := b.req
		put_op(o, 1)
		put_u32(o, u32(len(items)))
		for x0 in items {
			put_vtape(o, x0.nd)
		}
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Tree_State_Builder) -> Tree_State {
		return {state = {h = state_make(b.cx, b.req[:])}}
	},
}

tree_state :: proc(cx: ^Cx, loc := #caller_location) -> Tree_State_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_tree()
	put_op(o, 683)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &tree_state_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

