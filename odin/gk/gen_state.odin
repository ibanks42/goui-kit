// Get the rope text
display_map_text :: proc(s: Display_Map, cx: ^Cx, loc := #caller_location) -> (v: Temp_String) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_input()
	put_op(o, 1262)
	put_u64(o, s.h)
	r := obj_get(s.h, cx, req[:], loc)
