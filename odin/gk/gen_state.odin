// Retained editing behavior for a segmented time field.
//
// The field is one Tab stop. Inside it, one segment is selected at a time: Up/Down step the
// selected segment and wrap within it (no carry into the next unit), Left/Right and Tab/Shift-Tab
// move between segments, digits are typed with a two-digit buffer that advances to the next
// segment once no further digit could fit, `a`/`p` set the AM/PM segment, and Backspace/Delete
// reset the segment.
//
// The owner supplies the value with `gk.time_field_state_set_time`, which does not emit; user
// edits emit `Change`.
//
// Time_Field_State is a handle to gpui_kit::base::TimeFieldState, an entity the library keeps. Its procedures are named time_field_state_*.
Time_Field_State :: struct {
	using state: State,
}

// The segment that keyboard editing applies to.
time_field_state_selected_segment :: proc(s: Time_Field_State, cx: ^Cx, loc := #caller_location) -> (v: Time_Segment) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_time_field()
	put_op(o, 319)
	put_u64(o, s.h)
	r := state_get(s.h, cx, req[:], loc)
	rd_into(&r, &v)
	return
}

time_field_state_time :: proc(s: Time_Field_State, cx: ^Cx, loc := #caller_location) -> (v: Civil_Time) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_time_field()
	put_op(o, 1330)
	put_u64(o, s.h)
	r := state_get(s.h, cx, req[:], loc)
	rd_into(&r, &v)
	return
}

time_field_state_focus :: proc(s: Time_Field_State, cx: ^Cx, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_time_field()
	put_op(o, 407)
	put_u64(o, s.h)
	state_set(cx, req[:], loc)
}

time_field_state_set_hour_cycle :: proc(s: Time_Field_State, cx: ^Cx, hour_cycle: Hour_Cycle, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_time_field()
	put_op(o, 320)
	put_u64(o, s.h)
	put_u16(o, u16(hour_cycle))
	state_set(cx, req[:], loc)
}

time_field_state_set_precision :: proc(s: Time_Field_State, cx: ^Cx, precision: Time_Precision, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_time_field()
	put_op(o, 321)
	put_u64(o, s.h)
	put_u16(o, u16(precision))
	state_set(cx, req[:], loc)
}

// Replace the time without emitting `Change`.
time_field_state_set_time :: proc(s: Time_Field_State, cx: ^Cx, time: Civil_Time, loc := #caller_location) {
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_base_time_field()
	put_op(o, 1329)
	put_u64(o, s.h)
	put_civil_time(o, time)
	state_set(cx, req[:], loc)
}

time_field_state_on_time_field_event :: proc(s: Time_Field_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription {
	slot, generation := keep_handler(cx, h, 111, loc)
	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	put_op(o, 322)
	put_u64(o, s.h)
	put_u32(o, slot)
	put_u32(o, generation)
	r := state_get(s.h, cx, req[:], loc)
	return {rd_u64(&r), slot}
}

// Time_Field_State_Builder is the chain of TimeFieldState's `self -> Self` methods; build makes the entity, in one crossing.
Time_Field_State_Builder :: struct {
	using vt: ^Time_Field_State_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Time_Field_State_Builder_VT :: struct {
	// Set the hour cycle, default: `H23`.
	hour_cycle: proc(b: Time_Field_State_Builder, hour_cycle: Hour_Cycle) -> Time_Field_State_Builder,
	// Set the precision, default: `Minute`.
	precision: proc(b: Time_Field_State_Builder, precision: Time_Precision) -> Time_Field_State_Builder,
	build: proc(b: Time_Field_State_Builder) -> Time_Field_State,
}

@(private)
time_field_state_builder_vt := Time_Field_State_Builder_VT {
	hour_cycle = proc(b: Time_Field_State_Builder, hour_cycle: Hour_Cycle) -> Time_Field_State_Builder {
		o := b.req
		put_op(o, 1)
		put_u16(o, u16(hour_cycle))
		o[b.count_at] += 1
		return b
	},
	precision = proc(b: Time_Field_State_Builder, precision: Time_Precision) -> Time_Field_State_Builder {
		o := b.req
		put_op(o, 2)
		put_u16(o, u16(precision))
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Time_Field_State_Builder) -> Time_Field_State {
		return {state = {h = state_make(b.cx, b.req[:])}}
	},
}

time_field_state :: proc(cx: ^Cx, loc := #caller_location) -> Time_Field_State_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_time_field()
	put_op(o, 318)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &time_field_state_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

