Combobox_State_VT :: struct {
	query: proc(s: Combobox_State, cx: ^Cx, loc := #caller_location) -> Temp_String,
	selected_value: proc(s: Combobox_State, cx: ^Cx, loc := #caller_location) -> Maybe(Temp_String),
	selected_values: proc(s: Combobox_State, cx: ^Cx, loc := #caller_location) -> []Temp_String,
	selection: proc(s: Combobox_State, cx: ^Cx, loc := #caller_location) -> []Tuple_Base_Index_Path_Search_Item,
	clear_selection: proc(s: Combobox_State, cx: ^Cx, loc := #caller_location),
	focus: proc(s: Combobox_State, cx: ^Cx, loc := #caller_location),
	set_items: proc(s: Combobox_State, cx: ^Cx, items: Row_Source, loc := #caller_location),
	set_query: proc(s: Combobox_State, cx: ^Cx, query: string, loc := #caller_location),
	set_selected_indices: proc(s: Combobox_State, cx: ^Cx, indices: Index_Path_List, loc := #caller_location),
	set_selected_values: proc(s: Combobox_State, cx: ^Cx, values: []string, loc := #caller_location),
	add_selected_index: proc(s: Combobox_State, cx: ^Cx, index: Index_Path, loc := #caller_location) -> bool,
	remove_selected_index: proc(s: Combobox_State, cx: ^Cx, index: Index_Path, loc := #caller_location) -> bool,
	on_combobox_event: proc(s: Combobox_State, cx: ^Cx, h: Handler, loc := #caller_location) -> Subscription,
}

@(private)
combobox_state_vt := Combobox_State_VT {
	query = proc(s: Combobox_State, cx: ^Cx, loc := #caller_location) -> (v: Temp_String) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_combobox()
		put_op(o, 1108)
		put_u64(o, s.h)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	selected_value = proc(s: Combobox_State, cx: ^Cx, loc := #caller_location) -> (v: Maybe(Temp_String)) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_combobox()
		put_op(o, 1110)
		put_u64(o, s.h)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	selected_values = proc(s: Combobox_State, cx: ^Cx, loc := #caller_location) -> (v: []Temp_String) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_combobox()
		put_op(o, 1111)
		put_u64(o, s.h)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	selection = proc(s: Combobox_State, cx: ^Cx, loc := #caller_location) -> (v: []Tuple_Base_Index_Path_Search_Item) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_combobox()
		put_op(o, 1112)
		put_u64(o, s.h)
		r := state_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	add_selected_index = proc(s: Combobox_State, cx: ^Cx, index: Index_Path, loc := #caller_location) -> (v: bool) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_combobox()
		put_op(o, 1104)
		put_u64(o, s.h)
		index_rec: Base_Index_Path
		switch x in index {
		case int:
			index_rec = Base_Index_Path{row = x}
		case Base_Index_Path:
			index_rec = x
		}
		put_Base_Index_Path(o, index_rec)
		r := state_call(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	remove_selected_index = proc(s: Combobox_State, cx: ^Cx, index: Index_Path, loc := #caller_location) -> (v: bool) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_combobox()
		put_op(o, 1109)
		put_u64(o, s.h)
		index_rec: Base_Index_Path
		switch x in index {
		case int:
			index_rec = Base_Index_Path{row = x}
		case Base_Index_Path:
			index_rec = x
		}
		put_Base_Index_Path(o, index_rec)
		r := state_call(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	clear_selection = proc(s: Combobox_State, cx: ^Cx, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_combobox()
		put_op(o, 1105)
		put_u64(o, s.h)
		state_set(cx, req[:], loc)
	},
	focus = proc(s: Combobox_State, cx: ^Cx, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_combobox()
		put_op(o, 1106)
		put_u64(o, s.h)
		state_set(cx, req[:], loc)
	},
	set_items = proc(s: Combobox_State, cx: ^Cx, items: Row_Source, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_combobox()
		put_op(o, 1113)
		put_u64(o, s.h)
		put_u64(o, items.h)
		state_set(cx, req[:], loc)
	},
	set_query = proc(s: Combobox_State, cx: ^Cx, query: string, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_combobox()
		put_op(o, 1114)
		put_u64(o, s.h)
		put_str(o, query)
		state_set(cx, req[:], loc)
	},
	set_selected_indices = proc(s: Combobox_State, cx: ^Cx, indices: Index_Path_List, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_combobox()
		put_op(o, 1115)
		put_u64(o, s.h)
		indices_rec: []Base_Index_Path
		switch x in indices {
		case []int:
			indices_rec = make([]Base_Index_Path, len(x), context.temp_allocator)
			for indices_n, indices_i in x {indices_rec[indices_i] = {row = indices_n}}
		case []Base_Index_Path:
			indices_rec = x
		}
		put_u32(o, u32(len(indices_rec)))
		for x0 in indices_rec {
			put_Base_Index_Path(o, x0)
		}
		state_set(cx, req[:], loc)
	},
	set_selected_values = proc(s: Combobox_State, cx: ^Cx, values: []string, loc := #caller_location) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_component_combobox()
		put_op(o, 1116)
		put_u64(o, s.h)
		put_u32(o, u32(len(values)))
