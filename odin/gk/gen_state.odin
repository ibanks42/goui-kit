	},
}

// Diff_State_Builder is the chain of DiffState's `self -> Self` methods; build makes the entity, in one crossing.
Diff_State_Builder :: struct {
	using vt: ^Diff_State_Builder_VT,
	cx:       ^Cx,
	req:      ^Tape,
	count_at: int,
}

Diff_State_Builder_VT :: struct {
	with_context_lines: proc(b: Diff_State_Builder, lines: Maybe(int)) -> Diff_State_Builder,
	with_expansion_lines: proc(b: Diff_State_Builder, lines: int) -> Diff_State_Builder,
	with_inline_max_line_length: proc(b: Diff_State_Builder, length: int) -> Diff_State_Builder,
	with_inline_unit: proc(b: Diff_State_Builder, unit: Maybe(Diff_Inline_Unit)) -> Diff_State_Builder,
	with_min_collapsed_lines: proc(b: Diff_State_Builder, lines: int) -> Diff_State_Builder,
	with_mode: proc(b: Diff_State_Builder, mode: Diff_Mode) -> Diff_State_Builder,
	with_syntax_highlighter: proc(b: Diff_State_Builder, highlighter: Ask(Tuple_Temp_String_Temp_String, []Tuple_Range_Highlight_Style)) -> Diff_State_Builder,
	with_syntax_max_line_length: proc(b: Diff_State_Builder, length: int) -> Diff_State_Builder,
	build: proc(b: Diff_State_Builder) -> Diff_State,
}

@(private)
diff_state_builder_vt := Diff_State_Builder_VT {
	with_context_lines = proc(b: Diff_State_Builder, lines: Maybe(int)) -> Diff_State_Builder {
		o := b.req
		put_op(o, 1)
		if x0, ok := lines.?; ok {
			put_u8(o, 1)
			put_usize(o, x0)
		} else {
			put_u8(o, 0)
		}
		o[b.count_at] += 1
		return b
	},
	with_expansion_lines = proc(b: Diff_State_Builder, lines: int) -> Diff_State_Builder {
		o := b.req
		put_op(o, 2)
		put_usize(o, lines)
		o[b.count_at] += 1
		return b
	},
	with_inline_max_line_length = proc(b: Diff_State_Builder, length: int) -> Diff_State_Builder {
		o := b.req
		put_op(o, 3)
		put_usize(o, length)
		o[b.count_at] += 1
		return b
	},
	with_inline_unit = proc(b: Diff_State_Builder, unit: Maybe(Diff_Inline_Unit)) -> Diff_State_Builder {
		o := b.req
		put_op(o, 4)
		if x0, ok := unit.?; ok {
			put_u8(o, 1)
			put_u16(o, u16(x0))
		} else {
			put_u8(o, 0)
		}
		o[b.count_at] += 1
		return b
	},
	with_min_collapsed_lines = proc(b: Diff_State_Builder, lines: int) -> Diff_State_Builder {
		o := b.req
		put_op(o, 5)
		put_usize(o, lines)
		o[b.count_at] += 1
		return b
	},
	with_mode = proc(b: Diff_State_Builder, mode: Diff_Mode) -> Diff_State_Builder {
		o := b.req
		put_op(o, 6)
		put_u16(o, u16(mode))
		o[b.count_at] += 1
		return b
	},
	with_syntax_highlighter = proc(b: Diff_State_Builder, highlighter: Ask(Tuple_Temp_String_Temp_String, []Tuple_Range_Highlight_Style)) -> Diff_State_Builder {
		o := b.req
		put_op(o, 8)
		put_u64(o, highlighter.src.h)
		o[b.count_at] += 1
		return b
	},
	with_syntax_max_line_length = proc(b: Diff_State_Builder, length: int) -> Diff_State_Builder {
		o := b.req
		put_op(o, 7)
		put_usize(o, length)
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Diff_State_Builder) -> Diff_State {
		return {state = {h = state_make(b.cx, b.req[:])}, vt = &diff_state_vt}
	},
}

diff_state :: proc(cx: ^Cx, files: []Diff_File, loc := #caller_location) -> Diff_State_Builder {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_component_diff()
	put_op(o, 1000)
	put_u32(o, u32(len(files)))
	for x0 in files {
		put_vtape(o, x0.nd)
	}
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {vt = &diff_state_builder_vt, cx = cx, req = req, count_at = len(req) - 2}
}

@(init, private)
reg_discrete :: proc "contextless" () {
	register_obj(typeid_of(Discrete), &discrete_vt)
}

// Discrete is a handle to gpui_kit::base::Discrete<f32>, a library object the library keeps (PROTOCOLS.md section 13): a temporary handle when a read, a call or an event hands it out (gk.retain keeps it), a kept one from its constructor.
Discrete :: struct {
	using state: State,
	using vt: ^Discrete_VT,
}

Discrete_VT :: struct {
	sample: proc(s: Discrete, cx: ^Cx, progress: f32, loc := #caller_location) -> f32,
	switch_at: proc(s: Discrete, cx: ^Cx, progress: f32, loc := #caller_location) -> Fallible(Discrete),
}

@(private)
discrete_vt := Discrete_VT {
	sample = proc(s: Discrete, cx: ^Cx, progress: f32, loc := #caller_location) -> (v: f32) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_motion()
		put_op(o, 1129)
		put_u64(o, s.h)
		put_f32(o, progress)
		r := obj_get(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
	switch_at = proc(s: Discrete, cx: ^Cx, progress: f32, loc := #caller_location) -> (v: Fallible(Discrete)) {
		req := make(Tape, 0, 32, context.temp_allocator)
		o := &req
		use_base_motion()
		put_op(o, 1130)
		put_u64(o, s.h)
		put_f32(o, progress)
		r := state_call(s.h, cx, req[:], loc)
		rd_into(&r, &v)
		return
	},
}

discrete :: proc(cx: ^Cx, from: f32, to: f32, loc := #caller_location) -> Discrete {
	req := new(Tape, context.temp_allocator)
	req^ = make(Tape, 0, 64, context.temp_allocator)
	o := req
	use_base_motion()
	put_op(o, 1128)
	put_f32(o, from)
	put_f32(o, to)
	put_u16(o, 0) // how many builder ops follow (at most 255 are counted here)
	return {state = {h = state_make(cx, req[:], loc)}, vt = &discrete_vt}
}

