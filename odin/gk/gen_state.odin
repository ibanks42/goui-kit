	with_selected_index = proc(b: Carousel_State_Builder, index: int) -> Carousel_State_Builder {
		o := b.req
		put_op(o, 3)
		put_usize(o, index)
		o[b.count_at] += 1
		return b
	},
	build = proc(b: Carousel_State_Builder) -> Carousel_State {
		return {state = {h = state_make(b.cx, b.req[:])}}
	},
}

