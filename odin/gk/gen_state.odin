	use_base_input()
	put_op(o, 1772)
	put_u64(o, s.h)
	put_u32(o, u32(len(decorations)))
	for x0 in decorations {
		put_Text_Decoration(o, x0)
	}
	state_set(cx, req[:], loc)
}

