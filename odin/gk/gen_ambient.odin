	req := make(Tape, 0, 32, context.temp_allocator)
	o := &req
	use_component_root()
	put_op(o, 760)
	put_usize(o, scale)
	r := ambient_call(cx, req[:], true, loc)
	rd_into(&r, &v)
	return
}

// Return the path to draw for the icon at `path`: the answer of the resolver set with
