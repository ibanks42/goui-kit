	use_base_plot()
	e := Radial_Line_Shape{new_value(815, loc), &radial_line_shape_vt}
	return e
}

radial_line_shape_default :: proc(loc := #caller_location) -> Radial_Line_Shape {
	use_base_plot()
	e := Radial_Line_Shape{new_value(814, loc), &radial_line_shape_vt}
	return e
}

@(private)
radial_line_shape_vt := Radial_Line_Shape_VT {
	angle = proc(e: Radial_Line_Shape, angle: string) -> Radial_Line_Shape {
		o := op(vel(e.nd), 256)
		put_field(o, angle, .Opt)
		return e
	},
	closed = proc(e: Radial_Line_Shape) -> Radial_Line_Shape {
		op(vel(e.nd), 257)
		return e
	},
	data = proc(e: Radial_Line_Shape, data: Data) -> Radial_Line_Shape {
		o := op(vel(e.nd), 258)
		put_data(o, data)
		return e
	},
	dot = proc(e: Radial_Line_Shape) -> Radial_Line_Shape {
		op(vel(e.nd), 259)
		return e
	},
	dot_fill = proc(e: Radial_Line_Shape, fill: Color) -> Radial_Line_Shape {
		o := op(vel(e.nd), 260)
		put_color(o, fill)
		return e
	},
	dot_size = proc(e: Radial_Line_Shape, dot_size: f32) -> Radial_Line_Shape {
		o := op(vel(e.nd), 261)
		put_f32(o, dot_size)
		return e
	},
	dot_stroke = proc(e: Radial_Line_Shape, stroke: Color) -> Radial_Line_Shape {
		o := op(vel(e.nd), 262)
		put_color(o, stroke)
		return e
	},
	fill = proc(e: Radial_Line_Shape, fill: Color) -> Radial_Line_Shape {
		o := op(vel(e.nd), 263)
		put_color(o, fill)
		return e
	},
	radius = proc(e: Radial_Line_Shape, radius: string) -> Radial_Line_Shape {
		o := op(vel(e.nd), 264)
		put_field(o, radius, .Opt)
		return e
	},
	stroke = proc(e: Radial_Line_Shape, stroke: Color) -> Radial_Line_Shape {
		o := op(vel(e.nd), 265)
		put_color(o, stroke)
		return e
	},
	stroke_width = proc(e: Radial_Line_Shape, stroke_width: f32) -> Radial_Line_Shape {
		o := op(vel(e.nd), 266)
		put_f32(o, stroke_width)
		return e
	},
}

// The Sankey layout generator.
//
// Sankey is gpui_kit::base::plot::shape::Sankey.
Sankey :: struct {
	using nd: Value,
	using vt: ^Sankey_VT,
}

Sankey_VT :: struct {
	// Set the layout bounds as `[x0, y0, x1, y1]`. Defaults to `[0, 0, 1, 1]`.
	extent: proc(e: Sankey, x0: f32, y0: f32, x1: f32, y1: f32) -> Sankey,
	// Set the number of relaxation passes. Defaults to 6.
	iterations: proc(e: Sankey, iterations: int) -> Sankey,
	// Set the node alignment. Defaults to `Justify`.
	node_align: proc(e: Sankey, align: Sankey_Align) -> Sankey,
	// Set the vertical gap between nodes in a column. Defaults to 8.
	node_padding: proc(e: Sankey, node_padding: f32) -> Sankey,
	// Set the node rectangle width. Defaults to 24.
	node_width: proc(e: Sankey, node_width: f32) -> Sankey,
	// Equivalent to `extent(0., 0., width, height)`.
	size: proc(e: Sankey, width: f32, height: f32) -> Sankey,
	// Set how values map to heights. Defaults to `Linear`.
	value_scale: proc(e: Sankey, value_scale: Sankey_Value_Scale) -> Sankey,
}

// Create a generator with the d3-sankey defaults (see `default`).
sankey :: proc(loc := #caller_location) -> Sankey {
	e := Sankey{new_value(536, loc), &sankey_vt}
	return e
}

sankey_default :: proc(loc := #caller_location) -> Sankey {
	e := Sankey{new_value(535, loc), &sankey_vt}
	return e
}

@(private)
sankey_vt := Sankey_VT {
	extent = proc(e: Sankey, x0: f32, y0: f32, x1: f32, y1: f32) -> Sankey {
		o := op(vel(e.nd), 256)
		put_f32(o, x0)
		put_f32(o, y0)
		put_f32(o, x1)
		put_f32(o, y1)
		return e
	},
	iterations = proc(e: Sankey, iterations: int) -> Sankey {
		o := op(vel(e.nd), 257)
		put_usize(o, iterations)
		return e
	},
	node_align = proc(e: Sankey, align: Sankey_Align) -> Sankey {
		o := op(vel(e.nd), 258)
		put_u16(o, u16(align))
		return e
	},
	node_padding = proc(e: Sankey, node_padding: f32) -> Sankey {
		o := op(vel(e.nd), 259)
		put_f32(o, node_padding)
		return e
	},
	node_width = proc(e: Sankey, node_width: f32) -> Sankey {
		o := op(vel(e.nd), 260)
		put_f32(o, node_width)
		return e
	},
	size = proc(e: Sankey, width: f32, height: f32) -> Sankey {
		o := op(vel(e.nd), 261)
		put_f32(o, width)
		put_f32(o, height)
		return e
	},
	value_scale = proc(e: Sankey, value_scale: Sankey_Value_Scale) -> Sankey {
		o := op(vel(e.nd), 262)
		put_u16(o, u16(value_scale))
		return e
	},
}

// An input link of a Sankey diagram.
//
// `source` and `target` are indices into the node list (d3-sankey's default `nodeId`), `value` is
// the flow amount.
//
// Sankey_Link is gpui_kit::base::plot::shape::SankeyLink.
Sankey_Link :: struct {
	using nd: Value,
	using vt: ^Sankey_Link_VT,
}

Sankey_Link_VT :: struct {
}

// Create a link from the `source` node index to the `target` node index carrying `value`.
sankey_link :: proc(source: int, target: int, value: f64, loc := #caller_location) -> Sankey_Link {
	e := Sankey_Link{new_value(537, loc), &sankey_link_vt}
	o := node_args()
	put_usize(o, source)
	put_usize(o, target)
	put_u64(o, transmute(u64)f64(value))
	return e
}

@(private)
sankey_link_vt := Sankey_Link_VT {
}

