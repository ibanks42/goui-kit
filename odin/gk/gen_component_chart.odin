// Pie_Chart is gpui_kit::component::chart::PieChart<crate::data::Datum>.
Pie_Chart :: struct {
	using el: Element,
	using vt: ^Pie_Chart_VT,
}

Pie_Chart_VT :: struct {
	// Draw the data in the first time this chart is painted. On by default.
	//
	// The theme sets how long it takes, and the system's reduced-motion setting skips it. Turn it off
	// for a chart that is painted again and again as it scrolls in and out of view, such as one in
	// each row of a long list, where it would draw in every time.
	appear: proc(e: Pie_Chart, appear: bool) -> Pie_Chart,
	// Draw the data in again whenever `key` changes, such as the symbol or period a chart shows.
	//
	// Without one the data draws in once, and later data paints in place.
	appear_key: proc(e: Pie_Chart, key: string) -> Pie_Chart,
	// Set the color of the pie chart.
	color: proc(e: Pie_Chart, color: string) -> Pie_Chart,
	// Name this chart's `ElementId`, replacing the default taken from the construction site.
	//
	// Pass one where a single construction site renders several of these charts as siblings: they
	// share the default id, and with it one hover state and one path cache. The id must be unique
	// among those siblings.
	id: proc(e: Pie_Chart, id: Id) -> Pie_Chart,
	// Set the inner radius of the pie chart, in pixels.
	//
	// This and `->inner_radius_ratio` replace each other; the last one set applies.
	inner_radius: proc(e: Pie_Chart, inner_radius: f32) -> Pie_Chart,
	// Set the inner radius of the pie chart based on the arc data.
	inner_radius_fn: proc(e: Pie_Chart, inner_radius_fn: string) -> Pie_Chart,
	// Set the inner radius as a fraction of the ring's outer radius, from `0.` (a pie) to `1.`: `0.6`
	// cuts a donut whose hole is 60% of the ring's radius, whatever size the chart is given.
	//
	// The outer radius is the one set with `->outer_radius`, or 40% of the chart's height when none is
	// set, so a donut keeps its proportions in a panel of unknown or changing size. This and
	// `->inner_radius` replace each other; the last one set applies, and `->inner_radius_fn` overrides
	// both.
	inner_radius_ratio: proc(e: Pie_Chart, ratio: f32) -> Pie_Chart,
	// Turn this chart's interactive layer on or off. On by default.
	//
	// The layer is the hitbox under the cursor and what it drives: the hovered slice lifts out of the
	// ring, and a tooltip shows its value and share. Turn it off for a chart that only decorates, or
	// one an element above it wants the cursor for: without a hitbox it neither answers the mouse nor
	// takes the hover from what sits over it.
	interactive: proc(e: Pie_Chart, interactive: bool) -> Pie_Chart,
	// Set the label text for each slice.
	//
	// Once set, a "leader line + text" is drawn outside the ring for every slice.
	label: proc(e: Pie_Chart, label: string) -> Pie_Chart,
	// Set the label text color (defaults to the theme's `foreground` colour).
	label_color: proc(e: Pie_Chart, color: Color) -> Pie_Chart,
	// Set the extra gap between `outer_radius` and the label radius (defaults to 15px).
	label_gap: proc(e: Pie_Chart, gap: f32) -> Pie_Chart,
	// Set the leader line color per slice (defaults to the theme's `border` colour).
	label_line_color: proc(e: Pie_Chart, color: string) -> Pie_Chart,
	// Set the series name shown in the hover tooltip row (e.g. "Desktop").
	name: proc(e: Pie_Chart, name: string) -> Pie_Chart,
	// Set the outer radius of the pie chart.
	outer_radius: proc(e: Pie_Chart, outer_radius: f32) -> Pie_Chart,
	// Set the outer radius of the pie chart based on the arc data.
	outer_radius_fn: proc(e: Pie_Chart, outer_radius_fn: string) -> Pie_Chart,
	// Set the pad angle of the pie chart.
	pad_angle: proc(e: Pie_Chart, pad_angle: f32) -> Pie_Chart,
	// Name the slice under the cursor in the hover tooltip's row, beside its value. Falls back to
	// `name`, the one name the whole series carries.
	//
	// A pie shows one number per slice, so the slice's own name is what the row wants; a single series
	// name leaves the row reading as a swatch and a number with a gap between them. The alternative
	// was to title the tooltip from `label`, but that also draws the leader lines around the ring.
	tooltip_name: proc(e: Pie_Chart, name: string) -> Pie_Chart,
	// Set the text of the hover tooltip's row, the value the slice is worth. Defaults to the raw value
	// followed by its share in parentheses.
	//
	// The closure receives the datum, the value `value` returned for it, and that value's share of the
	// total as a percentage. Set it wherever the raw number is not what a reader should see: a value
	// that is already a ratio reads as `0.35 (35.0%)` by default, and a chart drawn from adjusted
	// values — a floor that keeps a hairline slice visible, say — would report the adjustment as
	// though it were the datum.
	tooltip_value: proc(e: Pie_Chart, value: string) -> Pie_Chart,
	value: proc(e: Pie_Chart, value: string) -> Pie_Chart,
}

pie_chart :: proc(data: Data, loc := #caller_location) -> Pie_Chart {
	use_component_chart()
	e := Pie_Chart{new_node(820, loc), &pie_chart_vt}
	o := node_args()
	put_data(o, data)
	return e
}

@(private)
pie_chart_vt := Pie_Chart_VT {
	appear = proc(e: Pie_Chart, appear: bool) -> Pie_Chart {
		o := op(e.el, 256)
		put_u8(o, u8(appear))
		return e
	},
	appear_key = proc(e: Pie_Chart, key: string) -> Pie_Chart {
		o := op(e.el, 257)
		put_str(o, key)
		return e
	},
	color = proc(e: Pie_Chart, color: string) -> Pie_Chart {
		o := op(e.el, 258)
		put_field(o, color, .Color)
		return e
	},
	id = proc(e: Pie_Chart, id: Id) -> Pie_Chart {
		o := op(e.el, 259)
		put_id(o, id)
		return e
	},
	inner_radius = proc(e: Pie_Chart, inner_radius: f32) -> Pie_Chart {
		o := op(e.el, 260)
		put_f32(o, inner_radius)
		return e
	},
	inner_radius_fn = proc(e: Pie_Chart, inner_radius_fn: string) -> Pie_Chart {
		o := op(e.el, 261)
		put_field(o, inner_radius_fn, .Num)
		return e
	},
	inner_radius_ratio = proc(e: Pie_Chart, ratio: f32) -> Pie_Chart {
		o := op(e.el, 262)
		put_f32(o, ratio)
		return e
	},
	interactive = proc(e: Pie_Chart, interactive: bool) -> Pie_Chart {
		o := op(e.el, 263)
		put_u8(o, u8(interactive))
		return e
	},
	label = proc(e: Pie_Chart, label: string) -> Pie_Chart {
		o := op(e.el, 264)
		put_field(o, label, .Text)
		return e
	},
	label_color = proc(e: Pie_Chart, color: Color) -> Pie_Chart {
		o := op(e.el, 265)
		put_color(o, color)
		return e
	},
	label_gap = proc(e: Pie_Chart, gap: f32) -> Pie_Chart {
		o := op(e.el, 266)
		put_f32(o, gap)
		return e
	},
	label_line_color = proc(e: Pie_Chart, color: string) -> Pie_Chart {
		o := op(e.el, 267)
		put_field(o, color, .Color)
		return e
	},
	name = proc(e: Pie_Chart, name: string) -> Pie_Chart {
		o := op(e.el, 268)
		put_str(o, name)
		return e
	},
	outer_radius = proc(e: Pie_Chart, outer_radius: f32) -> Pie_Chart {
		o := op(e.el, 269)
		put_f32(o, outer_radius)
		return e
	},
	outer_radius_fn = proc(e: Pie_Chart, outer_radius_fn: string) -> Pie_Chart {
		o := op(e.el, 270)
		put_field(o, outer_radius_fn, .Num)
		return e
	},
	pad_angle = proc(e: Pie_Chart, pad_angle: f32) -> Pie_Chart {
		o := op(e.el, 271)
		put_f32(o, pad_angle)
		return e
	},
	tooltip_name = proc(e: Pie_Chart, name: string) -> Pie_Chart {
		o := op(e.el, 272)
		put_field(o, name, .Text)
		return e
	},
	tooltip_value = proc(e: Pie_Chart, value: string) -> Pie_Chart {
		o := op(e.el, 273)
		put_format(o, value, 2, true)
		return e
	},
	value = proc(e: Pie_Chart, value: string) -> Pie_Chart {
		o := op(e.el, 274)
		put_field(o, value, .Num)
		return e
	},
}

// A radar (spider) chart.
//
// Each datum is one dimension (a spoke), placed clockwise around the center starting at 12
// o'clock. Add one series per `->value` call; each series is drawn as a closed polygon connecting
// its values on every spoke.
//
// Radar_Chart is gpui_kit::component::chart::RadarChart<crate::data::Datum, f64>.
Radar_Chart :: struct {
	using el: Element,
	using vt: ^Radar_Chart_VT,
}

Radar_Chart_VT :: struct {
	// Draw the data in the first time this chart is painted. On by default.
	//
	// The theme sets how long it takes, and the system's reduced-motion setting skips it. Turn it off
	// for a chart that is painted again and again as it scrolls in and out of view, such as one in
	// each row of a long list, where it would draw in every time.
	appear: proc(e: Radar_Chart, appear: bool) -> Radar_Chart,
	// Draw the data in again whenever `key` changes, such as the symbol or period a chart shows.
	//
	// Without one the data draws in once, and later data paints in place.
	appear_key: proc(e: Radar_Chart, key: string) -> Radar_Chart,
	// Show dots on the vertices of each series.
	dot: proc(e: Radar_Chart) -> Radar_Chart,
	// Set the fill color of the most recently added series.
	//
	// Defaults to the series stroke color with 0.3 opacity.
	fill: proc(e: Radar_Chart, fill: Color) -> Radar_Chart,
	// Show or hide the grid rings and spokes.
	//
	// Default is true.
	grid: proc(e: Radar_Chart, grid: bool) -> Radar_Chart,
	// Set the number of concentric grid rings (defaults to 4).
	grid_levels: proc(e: Radar_Chart, grid_levels: int) -> Radar_Chart,
	// Name this chart's `ElementId`, replacing the default taken from the construction site.
	//
	// Pass one where a single construction site renders several of these charts as siblings: they
	// share the default id, and with it one hover state and one path cache. The id must be unique
	// among those siblings.
	id: proc(e: Radar_Chart, id: Id) -> Radar_Chart,
	// Turn this chart's interactive layer on or off. On by default.
	//
	// The layer is the hitbox under the cursor and what it drives: a dot per series marks the hovered
	// dimension, and a tooltip shows a row each. Turn it off for a chart that only decorates, or one
	// an element above it wants the cursor for: without a hitbox it neither answers the mouse nor
	// takes the hover from what sits over it.
	interactive: proc(e: Radar_Chart, interactive: bool) -> Radar_Chart,
	// Set the label for each dimension, shown outside the outer ring.
	//
	// Return a string for a plain text label, or `element.into_any_element()` for a custom one; see
	// `RadarLabel` for how the two differ.
	label: proc(e: Radar_Chart, label: string) -> Radar_Chart,
	// Set the text label color (defaults to the theme's `muted_foreground` colour).
	//
	// Element labels style themselves; this does not apply to them.
	label_color: proc(e: Radar_Chart, color: Color) -> Radar_Chart,
	// Set the extra gap between the outer ring and the labels (defaults to 10px).
	label_gap: proc(e: Radar_Chart, gap: f32) -> Radar_Chart,
	// Set the value at the outer ring.
	//
	// Defaults to the maximum value across all series.
	max_value: proc(e: Radar_Chart, max_value: f64) -> Radar_Chart,
	// Set the name of the most recently added series, shown in its tooltip row.
	//
	// Call after the matching `->value` (e.g. `.value(..).stroke(..).name("Desktop")`).
	name: proc(e: Radar_Chart, name: string) -> Radar_Chart,
	// Set the outer radius of the radar chart.
	//
	// Defaults to 40% of the bounds height.
	outer_radius: proc(e: Radar_Chart, outer_radius: f32) -> Radar_Chart,
	// Set the stroke color of the most recently added series.
	//
	// Defaults to the theme chart colors, cycled per series.
	stroke: proc(e: Radar_Chart, stroke: Color) -> Radar_Chart,
	// Draw the tooltip box's content for a datum yourself, in place of the title and rows, for a
	// layout they cannot express such as a table.
	//
	// The dots and where the box sits stay the chart's, and `->tooltip_title`, `->tooltip_value` and
	// `->tooltip_value_color` no longer apply.
	tooltip_content: proc(e: Radar_Chart, content: Row_Source) -> Radar_Chart,
	// Set the hover tooltip's title for a datum, instead of its dimension label.
	tooltip_title: proc(e: Radar_Chart, title: string) -> Radar_Chart,
	// Set the text of each tooltip row's value; the raw number by default.
	//
	// The closure receives the datum, the row's index (the series' index in the order `value` added
	// them) and the value the row reads.
	tooltip_value: proc(e: Radar_Chart, value: string) -> Radar_Chart,
	// Color each tooltip row's value, such as green or red by its sign; the tooltip's text color by
	// default.
	//
	// The closure receives the same arguments as `->tooltip_value`.
	tooltip_value_color: proc(e: Radar_Chart, color: string) -> Radar_Chart,
	// Add a series to the radar chart.
	//
	// Call multiple times to overlay multiple series, each paired with the matching `->stroke` and
	// `->fill` calls.
	value: proc(e: Radar_Chart, value: string) -> Radar_Chart,
}

radar_chart :: proc(data: Data, loc := #caller_location) -> Radar_Chart {
	use_component_chart()
	e := Radar_Chart{new_node(821, loc), &radar_chart_vt}
	o := node_args()
	put_data(o, data)
	return e
}

@(private)
radar_chart_vt := Radar_Chart_VT {
	appear = proc(e: Radar_Chart, appear: bool) -> Radar_Chart {
		o := op(e.el, 256)
		put_u8(o, u8(appear))
		return e
	},
	appear_key = proc(e: Radar_Chart, key: string) -> Radar_Chart {
		o := op(e.el, 257)
		put_str(o, key)
		return e
	},
	dot = proc(e: Radar_Chart) -> Radar_Chart {
		op(e.el, 258)
		return e
	},
	fill = proc(e: Radar_Chart, fill: Color) -> Radar_Chart {
		o := op(e.el, 259)
		put_color(o, fill)
		return e
	},
	grid = proc(e: Radar_Chart, grid: bool) -> Radar_Chart {
		o := op(e.el, 260)
		put_u8(o, u8(grid))
		return e
	},
	grid_levels = proc(e: Radar_Chart, grid_levels: int) -> Radar_Chart {
		o := op(e.el, 261)
		put_usize(o, grid_levels)
		return e
	},
	id = proc(e: Radar_Chart, id: Id) -> Radar_Chart {
		o := op(e.el, 262)
		put_id(o, id)
		return e
	},
	interactive = proc(e: Radar_Chart, interactive: bool) -> Radar_Chart {
		o := op(e.el, 263)
		put_u8(o, u8(interactive))
		return e
	},
	label = proc(e: Radar_Chart, label: string) -> Radar_Chart {
		o := op(e.el, 264)
		put_field(o, label, .Text)
		return e
	},
	label_color = proc(e: Radar_Chart, color: Color) -> Radar_Chart {
		o := op(e.el, 265)
		put_color(o, color)
		return e
	},
	label_gap = proc(e: Radar_Chart, gap: f32) -> Radar_Chart {
		o := op(e.el, 266)
		put_f32(o, gap)
		return e
	},
	max_value = proc(e: Radar_Chart, max_value: f64) -> Radar_Chart {
		o := op(e.el, 267)
		put_u64(o, transmute(u64)f64(max_value))
		return e
	},
	name = proc(e: Radar_Chart, name: string) -> Radar_Chart {
		o := op(e.el, 268)
		put_str(o, name)
		return e
	},
	outer_radius = proc(e: Radar_Chart, outer_radius: f32) -> Radar_Chart {
		o := op(e.el, 269)
		put_f32(o, outer_radius)
		return e
	},
	stroke = proc(e: Radar_Chart, stroke: Color) -> Radar_Chart {
		o := op(e.el, 270)
		put_color(o, stroke)
		return e
	},
	tooltip_content = proc(e: Radar_Chart, content: Row_Source) -> Radar_Chart {
		o := op(e.el, 271)
		put_u64(o, content.h)
		return e
	},
	tooltip_title = proc(e: Radar_Chart, title: string) -> Radar_Chart {
		o := op(e.el, 272)
		put_field(o, title, .Text)
		return e
	},
	tooltip_value = proc(e: Radar_Chart, value: string) -> Radar_Chart {
		o := op(e.el, 273)
		put_format(o, value, 2, true)
		return e
	},
	tooltip_value_color = proc(e: Radar_Chart, color: string) -> Radar_Chart {
		o := op(e.el, 274)
		put_field(o, color, .Color)
		return e
	},
	value = proc(e: Radar_Chart, value: string) -> Radar_Chart {
		o := op(e.el, 275)
		put_field(o, value, .Num)
		return e
	},
}

// A Sankey diagram, layout modeled after d3-sankey (https://github.com/d3/d3-sankey).
//
// Links reference nodes by their index in the node list; map string ids to indices before
// constructing.
//
// Sankey_Chart is gpui_kit::component::chart::SankeyChart<crate::data::Datum>.
Sankey_Chart :: struct {
	using el: Element,
	using vt: ^Sankey_Chart_VT,
}

Sankey_Chart_VT :: struct {
	// Draw the data in the first time this chart is painted. On by default.
	//
	// The theme sets how long it takes, and the system's reduced-motion setting skips it. Turn it off
	// for a chart that is painted again and again as it scrolls in and out of view, such as one in
	// each row of a long list, where it would draw in every time.
	appear: proc(e: Sankey_Chart, appear: bool) -> Sankey_Chart,
	// Draw the data in again whenever `key` changes, such as the symbol or period a chart shows.
	//
	// Without one the data draws in once, and later data paints in place.
	appear_key: proc(e: Sankey_Chart, key: string) -> Sankey_Chart,
	// Name this chart's `ElementId`, replacing the default taken from the construction site.
	//
	// Pass one where a single construction site renders several of these charts as siblings: they
	// share the default id, and with it one hover state and one path cache. The id must be unique
	// among those siblings.
	id: proc(e: Sankey_Chart, id: Id) -> Sankey_Chart,
	// Turn this chart's interactive layer on or off. On by default.
	//
	// The layer is the hitbox under the cursor and what it drives: the hovered node's links stand out
	// from the rest, and a tooltip shows its label and throughput. Turn it off for a chart that only
	// decorates, or one an element above it wants the cursor for: without a hitbox it neither answers
	// the mouse nor takes the hover from what sits over it.
	interactive: proc(e: Sankey_Chart, interactive: bool) -> Sankey_Chart,
	// Set the number of relaxation passes. Defaults to 6.
	iterations: proc(e: Sankey_Chart, iterations: int) -> Sankey_Chart,
	// Set the gap between a node and its labels. Defaults to 6.
	label_gap: proc(e: Sankey_Chart, gap: f32) -> Sankey_Chart,
	// Set fully custom node labels, one `Sankey_Label` per line, top to bottom. Takes precedence over
	// `node_label`/`value_label` when set; unset by default.
	//
	// The closure receives the datum and the node's raw computed throughput (max of incoming and
	// outgoing flow, in unscaled units).
	labels: proc(e: Sankey_Chart, labels: [][]Sankey_Label) -> Sankey_Chart,
	// Set the opacity of the link ribbons. Defaults to 0.3.
	link_opacity: proc(e: Sankey_Chart, opacity: f32) -> Sankey_Chart,
	// Set the minimum ribbon thickness, so tiny flows stay visible. Defaults to 1.
	min_link_width: proc(e: Sankey_Chart, width: f32) -> Sankey_Chart,
	// Set the node alignment. Defaults to `Justify`.
	node_align: proc(e: Sankey_Chart, align: Sankey_Align) -> Sankey_Chart,
	// Set the color of each node.
	//
	// Defaults to cycling the theme chart palette by node index.
	node_color: proc(e: Sankey_Chart, color: string) -> Sankey_Chart,
	// Set the corner radius of the node rectangles. Defaults to 0.
	node_corner_radius: proc(e: Sankey_Chart, radius: f32) -> Sankey_Chart,
	// Set the name label of each node, drawn in muted foreground. No name label is drawn unless set.
	node_label: proc(e: Sankey_Chart, label: string) -> Sankey_Chart,
	// Set the vertical gap between nodes in a column. Defaults to 16.
	node_padding: proc(e: Sankey_Chart, node_padding: f32) -> Sankey_Chart,
	// Set the node rectangle width. Defaults to 10.
	node_width: proc(e: Sankey_Chart, node_width: f32) -> Sankey_Chart,
	// Name the node under the cursor in the hover tooltip's row, beside its throughput. Unset, the row
	// carries no name at all.
	//
	// A sankey shows one number per node, so the node's own name is what the row wants; without it the
	// row reads as a swatch and a number with a gap between them. The alternative was to title the
	// tooltip from `node_label`, but that also draws the name beside the node — and a chart drawing
	// its text through `labels` sets neither.
	tooltip_name: proc(e: Sankey_Chart, name: string) -> Sankey_Chart,
	// Set the text of the hover tooltip's row, the node's throughput.
	//
	// `value_label` supplies it when this is unset, and the raw number when neither is set — which is
	// what a chart drawing its text through `labels` gets, however carefully it formats the value it
	// draws.
	tooltip_value: proc(e: Sankey_Chart, value: string) -> Sankey_Chart,
	// Set the value label of each node, drawn above the name label. No value label is drawn unless
	// set.
	//
	// The closure receives the datum and the node's raw computed throughput (max of incoming and
	// outgoing flow, in unscaled units).
	value_label: proc(e: Sankey_Chart, label: string) -> Sankey_Chart,
	// Set how flow values map to node heights.
	//
	// Defaults to `Linear`. Use `Sqrt` to keep a dominant flow from dwarfing the small ones without
	// pre-transforming the data; labels still receive the raw values.
	value_scale: proc(e: Sankey_Chart, value_scale: Sankey_Value_Scale) -> Sankey_Chart,
}

// Create a chart from nodes and links; links reference nodes by their index in `nodes` (map string
// ids to indices before constructing).
sankey_chart :: proc(nodes: Data, links: []Sankey_Link, loc := #caller_location) -> Sankey_Chart {
	use_component_chart()
	e := Sankey_Chart{new_node(822, loc), &sankey_chart_vt}
	o := node_args()
	put_data(o, nodes)
	put_u32(o, u32(len(links)))
	for x0 in links {
		put_u32(o, take_value(x0.nd))
	}
	return e
}

@(private)
sankey_chart_vt := Sankey_Chart_VT {
	appear = proc(e: Sankey_Chart, appear: bool) -> Sankey_Chart {
		o := op(e.el, 256)
		put_u8(o, u8(appear))
		return e
	},
	appear_key = proc(e: Sankey_Chart, key: string) -> Sankey_Chart {
		o := op(e.el, 257)
		put_str(o, key)
		return e
	},
	id = proc(e: Sankey_Chart, id: Id) -> Sankey_Chart {
		o := op(e.el, 258)
		put_id(o, id)
		return e
	},
	interactive = proc(e: Sankey_Chart, interactive: bool) -> Sankey_Chart {
		o := op(e.el, 259)
		put_u8(o, u8(interactive))
		return e
	},
	iterations = proc(e: Sankey_Chart, iterations: int) -> Sankey_Chart {
		o := op(e.el, 260)
		put_usize(o, iterations)
		return e
	},
	label_gap = proc(e: Sankey_Chart, gap: f32) -> Sankey_Chart {
		o := op(e.el, 261)
		put_f32(o, gap)
		return e
	},
	labels = proc(e: Sankey_Chart, labels: [][]Sankey_Label) -> Sankey_Chart {
		o := op(e.el, 274)
		put_u32(o, u32(len(labels)))
		for x0 in labels {
			put_u32(o, u32(len(x0)))
			for x1 in x0 {
				put_u32(o, take_value(x1.nd))
			}
		}
		return e
	},
	link_opacity = proc(e: Sankey_Chart, opacity: f32) -> Sankey_Chart {
		o := op(e.el, 262)
		put_f32(o, opacity)
		return e
	},
	min_link_width = proc(e: Sankey_Chart, width: f32) -> Sankey_Chart {
		o := op(e.el, 263)
		put_f32(o, width)
		return e
	},
	node_align = proc(e: Sankey_Chart, align: Sankey_Align) -> Sankey_Chart {
		o := op(e.el, 264)
		put_u16(o, u16(align))
		return e
	},
	node_color = proc(e: Sankey_Chart, color: string) -> Sankey_Chart {
		o := op(e.el, 265)
		put_field(o, color, .Color)
		return e
	},
	node_corner_radius = proc(e: Sankey_Chart, radius: f32) -> Sankey_Chart {
		o := op(e.el, 266)
		put_f32(o, radius)
		return e
	},
	node_label = proc(e: Sankey_Chart, label: string) -> Sankey_Chart {
		o := op(e.el, 267)
		put_field(o, label, .Text)
		return e
	},
	node_padding = proc(e: Sankey_Chart, node_padding: f32) -> Sankey_Chart {
		o := op(e.el, 268)
		put_f32(o, node_padding)
		return e
	},
	node_width = proc(e: Sankey_Chart, node_width: f32) -> Sankey_Chart {
		o := op(e.el, 269)
		put_f32(o, node_width)
		return e
	},
	tooltip_name = proc(e: Sankey_Chart, name: string) -> Sankey_Chart {
		o := op(e.el, 270)
		put_field(o, name, .Text)
		return e
	},
	tooltip_value = proc(e: Sankey_Chart, value: string) -> Sankey_Chart {
		o := op(e.el, 271)
		put_format(o, value, 1, true)
		return e
	},
	value_label = proc(e: Sankey_Chart, label: string) -> Sankey_Chart {
		o := op(e.el, 272)
		put_format(o, label, 1, true)
		return e
	},
	value_scale = proc(e: Sankey_Chart, value_scale: Sankey_Value_Scale) -> Sankey_Chart {
		o := op(e.el, 273)
		put_u16(o, u16(value_scale))
		return e
	},
}

// A styled line of a sankey node label.
//
// Sankey_Label is gpui_kit::component::chart::SankeyLabel.
Sankey_Label :: struct {
	using nd: Value,
	using vt: ^Sankey_Label_VT,
}

Sankey_Label_VT :: struct {
	// Set the text color. Defaults to the theme foreground.
	color: proc(e: Sankey_Label, color: Color) -> Sankey_Label,
	// Set the font size. Defaults to 10.
	font_size: proc(e: Sankey_Label, font_size: f32) -> Sankey_Label,
}

// Create a label line with the default color and font size.
sankey_label :: proc(text: string, loc := #caller_location) -> Sankey_Label {
	e := Sankey_Label{new_value(619, loc), &sankey_label_vt}
	o := node_args()
	put_str(o, text)
	return e
}

@(private)
sankey_label_vt := Sankey_Label_VT {
	color = proc(e: Sankey_Label, color: Color) -> Sankey_Label {
		o := op(vel(e.nd), 256)
		put_color(o, color)
		return e
	},
	font_size = proc(e: Sankey_Label, font_size: f32) -> Sankey_Label {
		o := op(vel(e.nd), 257)
		put_f32(o, font_size)
		return e
	},
}

