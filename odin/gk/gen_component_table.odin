// The footer section of a `Table`, wrapping footer rows.
//
// Table_Footer is gpui_kit::component::table::TableFooter.
Table_Footer :: struct {
	using el: Element,
	using vt: ^Table_Footer_VT,
}

Table_Footer_VT :: struct {
	using t_theme_styled: ^Theme_Styled_Trait(Table_Footer),
	using t_logical_styled_ext: ^Logical_Styled_Ext_Trait(Table_Footer),
	using t_styled_ext: ^Styled_Ext_Trait(Table_Footer),
	using t_styled: ^Styled_Trait(Table_Footer),
	using t_sizable: ^Sizable_Trait(Table_Footer),
	using t_child_element: ^Child_Element_Trait(Table_Footer),
	child: proc(e: Table_Footer, child: Table_Child) -> Table_Footer,
	children: proc(e: Table_Footer, children: []Table_Child) -> Table_Footer,
}

table_footer :: proc(flags: ..Style_Flag, loc := #caller_location) -> Table_Footer {
	use_component_table()
	e := Table_Footer{new_node(778, loc), &table_footer_vt}
	tokens(e.el, flags)
	return e
}

@(private)
table_footer_vt := Table_Footer_VT {
	t_theme_styled = cast(^Theme_Styled_Trait(Table_Footer))&theme_styled_any,
	t_logical_styled_ext = cast(^Logical_Styled_Ext_Trait(Table_Footer))&logical_styled_ext_any,
	t_styled_ext = cast(^Styled_Ext_Trait(Table_Footer))&styled_ext_any,
	t_styled = cast(^Styled_Trait(Table_Footer))&styled_any,
	t_sizable = cast(^Sizable_Trait(Table_Footer))&sizable_any,
	t_child_element = cast(^Child_Element_Trait(Table_Footer))&child_element_any,
	child = proc(e: Table_Footer, child: Table_Child) -> Table_Footer {
		o := op(e.el, 256)
		{
			oe: Element
			switch x in child {
			case Table:
				oe = x.el
			case Table_Body:
				oe = x.el
			case Table_Caption:
				oe = x.el
			case Table_Cell:
				oe = x.el
			case Table_Footer:
				oe = x.el
			case Table_Head:
				oe = x.el
			case Table_Header:
				oe = x.el
			case Table_Row:
				oe = x.el
			}
			put_u32(o, take(oe))
		}
		return e
	},
	children = proc(e: Table_Footer, children: []Table_Child) -> Table_Footer {
		o := op(e.el, 257)
		put_u32(o, u32(len(children)))
		for x0 in children {
			{
				oe: Element
				switch x in x0 {
				case Table:
					oe = x.el
				case Table_Body:
					oe = x.el
				case Table_Caption:
					oe = x.el
				case Table_Cell:
					oe = x.el
				case Table_Footer:
					oe = x.el
				case Table_Head:
					oe = x.el
				case Table_Header:
					oe = x.el
				case Table_Row:
					oe = x.el
				}
				put_u32(o, take(oe))
			}
		}
		return e
	},
}

