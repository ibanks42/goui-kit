	style = transmute(proc(e: Table_Head, flags: ..Style_Flag) -> Table_Head)rt_style,
	col_span = proc(e: Table_Head, span: int) -> Table_Head {
		o := op(e.el, 256)
		put_usize(o, span)
		return e
	},
	text_center = proc(e: Table_Head) -> Table_Head {
		op(e.el, 257)
		return e
	},
	text_right = proc(e: Table_Head) -> Table_Head {
		op(e.el, 258)
		return e
	},
}

// The header section of a `Table`, wrapping header rows.
//
// Table_Header is gpui_kit::component::table::TableHeader.
Table_Header :: struct {
	using el: Element,
	using vt: ^Table_Header_VT,
}

Table_Header_VT :: struct {
	using t_theme_styled: ^Theme_Styled_Trait(Table_Header),
	using t_logical_styled_ext: ^Logical_Styled_Ext_Trait(Table_Header),
	using t_styled_ext: ^Styled_Ext_Trait(Table_Header),
	using t_styled: ^Styled_Trait(Table_Header),
	using t_child_element: ^Child_Element_Trait(Table_Header),
	using t_sizable: ^Sizable_Trait(Table_Header),
	child: proc(e: Table_Header, child: Table_Child) -> Table_Header,
	children: proc(e: Table_Header, children: []Table_Child) -> Table_Header,
}

table_header :: proc(flags: ..Style_Flag, loc := #caller_location) -> Table_Header {
	use_component_table()
	e := Table_Header{new_node(780, loc), &table_header_vt}
	tokens(e.el, flags)
	return e
}

@(private)
table_header_vt := Table_Header_VT {
	t_theme_styled = cast(^Theme_Styled_Trait(Table_Header))&theme_styled_any,
	t_logical_styled_ext = cast(^Logical_Styled_Ext_Trait(Table_Header))&logical_styled_ext_any,
	t_styled_ext = cast(^Styled_Ext_Trait(Table_Header))&styled_ext_any,
	t_styled = cast(^Styled_Trait(Table_Header))&styled_any,
	t_child_element = cast(^Child_Element_Trait(Table_Header))&child_element_any,
	t_sizable = cast(^Sizable_Trait(Table_Header))&sizable_any,
	child = proc(e: Table_Header, child: Table_Child) -> Table_Header {
		o := op(e.el, 256)
		{
			oe: Element
			switch x in child {
			case Table:
				oe = x.el
			case Table_Body:
				oe = x.el
			case Table_Caption:
				oe = x.el
			case Table_Cell:
				oe = x.el
			case Table_Footer:
				oe = x.el
			case Table_Head:
				oe = x.el
			case Table_Header:
				oe = x.el
			case Table_Row:
				oe = x.el
			}
			put_u32(o, take(oe))
		}
		return e
	},
	children = proc(e: Table_Header, children: []Table_Child) -> Table_Header {
		o := op(e.el, 257)
		put_u32(o, u32(len(children)))
		for x0 in children {
			{
				oe: Element
				switch x in x0 {
				case Table:
					oe = x.el
				case Table_Body:
					oe = x.el
				case Table_Caption:
					oe = x.el
				case Table_Cell:
					oe = x.el
				case Table_Footer:
					oe = x.el
				case Table_Head:
					oe = x.el
				case Table_Header:
					oe = x.el
				case Table_Row:
					oe = x.el
				}
				put_u32(o, take(oe))
			}
		}
		return e
	},
}

// A row in a `Table`.
//
// Table_Row is gpui_kit::component::table::TableRow.
Table_Row :: struct {
	using el: Element,
	using vt: ^Table_Row_VT,
}

Table_Row_VT :: struct {
	using t_theme_styled: ^Theme_Styled_Trait(Table_Row),
	using t_logical_styled_ext: ^Logical_Styled_Ext_Trait(Table_Row),
	using t_styled_ext: ^Styled_Ext_Trait(Table_Row),
	using t_styled: ^Styled_Trait(Table_Row),
	using t_sizable: ^Sizable_Trait(Table_Row),
	using t_child_element: ^Child_Element_Trait(Table_Row),
	child: proc(e: Table_Row, child: Table_Child) -> Table_Row,
	children: proc(e: Table_Row, children: []Table_Child) -> Table_Row,
	hover: proc(e: Table_Row, f: Style_Refinement) -> Table_Row,
	// Set a stable identity for the row. Without one a row is identified by its position, so element
	// state inside it (an open popover, a tooltip) stays at that position when the rows reorder.
	id: proc(e: Table_Row, id: Id) -> Table_Row,
}

table_row :: proc(flags: ..Style_Flag, loc := #caller_location) -> Table_Row {
	use_component_table()
	e := Table_Row{new_node(781, loc), &table_row_vt}
	tokens(e.el, flags)
	return e
}

@(private)
table_row_vt := Table_Row_VT {
	t_theme_styled = cast(^Theme_Styled_Trait(Table_Row))&theme_styled_any,
	t_logical_styled_ext = cast(^Logical_Styled_Ext_Trait(Table_Row))&logical_styled_ext_any,
	t_styled_ext = cast(^Styled_Ext_Trait(Table_Row))&styled_ext_any,
	t_styled = cast(^Styled_Trait(Table_Row))&styled_any,
	t_sizable = cast(^Sizable_Trait(Table_Row))&sizable_any,
	t_child_element = cast(^Child_Element_Trait(Table_Row))&child_element_any,
	child = proc(e: Table_Row, child: Table_Child) -> Table_Row {
		o := op(e.el, 256)
		{
			oe: Element
			switch x in child {
			case Table:
				oe = x.el
			case Table_Body:
				oe = x.el
			case Table_Caption:
				oe = x.el
			case Table_Cell:
				oe = x.el
			case Table_Footer:
				oe = x.el
			case Table_Head:
				oe = x.el
			case Table_Header:
				oe = x.el
			case Table_Row:
				oe = x.el
			}
			put_u32(o, take(oe))
		}
		return e
	},
	children = proc(e: Table_Row, children: []Table_Child) -> Table_Row {
		o := op(e.el, 257)
		put_u32(o, u32(len(children)))
		for x0 in children {
			{
				oe: Element
				switch x in x0 {
				case Table:
					oe = x.el
				case Table_Body:
					oe = x.el
				case Table_Caption:
					oe = x.el
				case Table_Cell:
					oe = x.el
				case Table_Footer:
					oe = x.el
				case Table_Head:
					oe = x.el
				case Table_Header:
					oe = x.el
				case Table_Row:
					oe = x.el
				}
				put_u32(o, take(oe))
			}
		}
		return e
	},
	hover = proc(e: Table_Row, f: Style_Refinement) -> Table_Row {
		o := op(e.el, 258)
		put_u32(o, take_value(f.nd))
		return e
	},
	id = proc(e: Table_Row, id: Id) -> Table_Row {
		o := op(e.el, 259)
		put_id(o, id)
		return e
	},
}

