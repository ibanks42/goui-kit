	child = proc(e: Button_Group, child: Button) -> Button_Group {
		o := op(e.el, 256)
		put_u32(o, take(child.el))
		return e
	},
	children = proc(e: Button_Group, children: []Button) -> Button_Group {
		o := op(e.el, 257)
