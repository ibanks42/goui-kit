toggle_group_vt := Toggle_Group_VT {
	t_theme_styled = cast(^Theme_Styled_Trait(Toggle_Group))&theme_styled_any,
	t_logical_styled_ext = cast(^Logical_Styled_Ext_Trait(Toggle_Group))&logical_styled_ext_any,
	t_styled_ext = cast(^Styled_Ext_Trait(Toggle_Group))&styled_ext_any,
	t_sizable = cast(^Sizable_Trait(Toggle_Group))&sizable_any,
	t_toggle_variants = cast(^Toggle_Variants_Trait(Toggle_Group))&toggle_variants_any,
	t_disableable = cast(^Disableable_Trait(Toggle_Group))&disableable_any,
	t_styled = cast(^Styled_Trait(Toggle_Group))&styled_any,
	child = proc(e: Toggle_Group, toggle: Toggle) -> Toggle_Group {
		o := op(e.el, 256)
		put_u32(o, take(toggle.el))
		return e
	},
	children = proc(e: Toggle_Group, children: []Toggle) -> Toggle_Group {
		o := op(e.el, 257)
		put_u32(o, u32(len(children)))
		for x0 in children {
			put_u32(o, take(x0.el))
		}
		return e
	},
	on_click = proc(e: Toggle_Group, on_click: Handler) -> Toggle_Group {
		o := op(e.el, 258)
