	using el: Element,
	using vt: ^Dialog_Action_VT,
}

Dialog_Action_VT :: struct {
	using t_element_ext: ^Element_Ext_Trait(Dialog_Action),
	using t_parent_element: ^Parent_Element_Trait(Dialog_Action),
}

dialog_action :: proc(loc := #caller_location) -> Dialog_Action {
	use_component_dialog()
	e := Dialog_Action{new_node(636, loc), &dialog_action_vt}
	return e
}

@(private)
dialog_action_vt := Dialog_Action_VT {
	t_element_ext = cast(^Element_Ext_Trait(Dialog_Action))&element_ext_any,
	t_parent_element = cast(^Parent_Element_Trait(Dialog_Action))&parent_element_any,
}

// Dialog button props.
//
// Every field is unset until a builder sets it, and an unset field falls back to its documented
// default when the dialog renders. Handing a value to `->button_props` or `->button_props`
// therefore overrides only the fields that value sets: whatever the dialog already carries — the
// Cancel button `AlertDialog::confirm` asked for, a callback an earlier `on_ok` installed —
// survives.
//
// Dialog_Button_Props is gpui_kit::component::dialog::DialogButtonProps.
Dialog_Button_Props :: struct {
	using nd: Value,
	using vt: ^Dialog_Button_Props_VT,
}

Dialog_Button_Props_VT :: struct {
	// Sets the text of the Cancel button. Default is `Cancel`.
	cancel_text: proc(e: Dialog_Button_Props, cancel_text: string) -> Dialog_Button_Props,
	// Sets the variant of the Cancel button. Default is `ButtonVariant::default()`.
	cancel_variant: proc(e: Dialog_Button_Props, cancel_variant: Button_Variant) -> Dialog_Button_Props,
	// Sets the text of the OK button. Default is `OK`.
	ok_text: proc(e: Dialog_Button_Props, ok_text: string) -> Dialog_Button_Props,
	// Sets the variant of the OK button. Default is `ButtonVariant::Primary`.
	ok_variant: proc(e: Dialog_Button_Props, ok_variant: Button_Variant) -> Dialog_Button_Props,
	// Sets the callback for when the dialog is has been canceled.
	//
	// The callback should return `true` to close the dialog, if return `false` the dialog will not be
	// closed.
	on_cancel: proc(e: Dialog_Button_Props, on_cancel: Handler) -> Dialog_Button_Props,
	// Sets the callback for when the dialog is has been confirmed.
	//
	// The callback should return `true` to close the dialog, if return `false` the dialog will not be
	// closed.
	on_ok: proc(e: Dialog_Button_Props, on_ok: Handler) -> Dialog_Button_Props,
	// Sets whether to show the Cancel button. Default is `false`.
	show_cancel: proc(e: Dialog_Button_Props, show_cancel: bool) -> Dialog_Button_Props,
}

dialog_button_props_default :: proc(loc := #caller_location) -> Dialog_Button_Props {
	e := Dialog_Button_Props{new_value(637, loc), &dialog_button_props_vt}
	return e
}

@(private)
dialog_button_props_vt := Dialog_Button_Props_VT {
	cancel_text = proc(e: Dialog_Button_Props, cancel_text: string) -> Dialog_Button_Props {
		o := op(vel(e.nd), 256)
		put_str(o, cancel_text)
		return e
	},
	cancel_variant = proc(e: Dialog_Button_Props, cancel_variant: Button_Variant) -> Dialog_Button_Props {
		o := op(vel(e.nd), 257)
		put_Button_Variant(o, cancel_variant)
		return e
	},
	ok_text = proc(e: Dialog_Button_Props, ok_text: string) -> Dialog_Button_Props {
		o := op(vel(e.nd), 258)
		put_str(o, ok_text)
		return e
	},
	ok_variant = proc(e: Dialog_Button_Props, ok_variant: Button_Variant) -> Dialog_Button_Props {
		o := op(vel(e.nd), 259)
		put_Button_Variant(o, ok_variant)
		return e
	},
	on_cancel = proc(e: Dialog_Button_Props, on_cancel: Handler) -> Dialog_Button_Props {
		o := op(vel(e.nd), 260)
		put_u32(o, register(on_cancel, 8))
		return e
	},
	on_ok = proc(e: Dialog_Button_Props, on_ok: Handler) -> Dialog_Button_Props {
		o := op(vel(e.nd), 261)
		put_u32(o, register(on_ok, 8))
		return e
	},
	show_cancel = proc(e: Dialog_Button_Props, show_cancel: bool) -> Dialog_Button_Props {
		o := op(vel(e.nd), 262)
		put_u8(o, u8(show_cancel))
		return e
	},
}

