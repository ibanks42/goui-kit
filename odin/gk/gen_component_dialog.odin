	row_start = transmute(proc(e: Dialog, start: i16) -> Dialog)styled_row_start,
	scrollbar_width = transmute(proc(e: Dialog, width: Length) -> Dialog)styled_scrollbar_width,
	shadow = transmute(proc(e: Dialog, shadows: []Box_Shadow) -> Dialog)styled_shadow,
	size = transmute(proc(e: Dialog, length: Length) -> Dialog)styled_size,
	text_align = transmute(proc(e: Dialog, align: Text_Align) -> Dialog)styled_text_align,
	text_bg = transmute(proc(e: Dialog, bg: Color) -> Dialog)styled_text_bg,
	text_color = transmute(proc(e: Dialog, color: Color) -> Dialog)styled_text_color,
	text_decoration_color = transmute(proc(e: Dialog, color: Color) -> Dialog)styled_text_decoration_color,
	text_overflow = transmute(proc(e: Dialog, overflow: Text_Overflow) -> Dialog)styled_text_overflow,
	text_size = transmute(proc(e: Dialog, size: Length) -> Dialog)styled_text_size,
	top = transmute(proc(e: Dialog, length: Length) -> Dialog)styled_top,
	style = transmute(proc(e: Dialog, flags: ..Style_Flag) -> Dialog)rt_style,
	button_props = proc(e: Dialog, button_props: Dialog_Button_Props) -> Dialog {
		o := op(e.el, 256)
		put_u32(o, take_value(button_props.nd))
		return e
	},
	centered = proc(e: Dialog) -> Dialog {
		op(e.el, 257)
		return e
	},
	close_button = proc(e: Dialog, close_button: bool) -> Dialog {
		o := op(e.el, 258)
		put_u8(o, u8(close_button))
		return e
	},
	content = proc(e: Dialog, builder: Dialog_Content) -> Dialog {
		o := op(e.el, 259)
		put_u32(o, take(builder.el))
		return e
	},
	entrance = proc(e: Dialog, entrance: Dialog_Entrance) -> Dialog {
		o := op(e.el, 260)
		put_u16(o, u16(entrance))
		return e
	},
	footer = proc(e: Dialog, footer: Element) -> Dialog {
		o := op(e.el, 261)
		put_u32(o, take(footer))
		return e
	},
	keyboard = proc(e: Dialog, keyboard: bool) -> Dialog {
		o := op(e.el, 262)
		put_u8(o, u8(keyboard))
		return e
	},
	margin_top = proc(e: Dialog, margin_top: f32) -> Dialog {
		o := op(e.el, 263)
		put_f32(o, margin_top)
		return e
	},
	max_w = proc(e: Dialog, max_width: f32) -> Dialog {
		o := op(e.el, 264)
		put_f32(o, max_width)
		return e
	},
	on_cancel = proc(e: Dialog, on_cancel: Handler) -> Dialog {
		o := op(e.el, 265)
		put_u32(o, register(on_cancel, 8))
		return e
	},
	on_close = proc(e: Dialog, on_close: Handler) -> Dialog {
		o := op(e.el, 266)
		put_u32(o, register(on_close, 1))
		return e
	},
	on_ok = proc(e: Dialog, on_ok: Handler) -> Dialog {
		o := op(e.el, 267)
		put_u32(o, register(on_ok, 8))
		return e
	},
	overlay = proc(e: Dialog, overlay: bool) -> Dialog {
		o := op(e.el, 268)
		put_u8(o, u8(overlay))
		return e
	},
	overlay_closable = proc(e: Dialog, overlay_closable: bool) -> Dialog {
		o := op(e.el, 269)
		put_u8(o, u8(overlay_closable))
		return e
	},
	title = proc(e: Dialog, title: Element) -> Dialog {
		o := op(e.el, 270)
		put_u32(o, take(title))
		return e
	},
	trigger = proc(e: Dialog, trigger: Element) -> Dialog {
		o := op(e.el, 271)
		put_u32(o, take(trigger))
		return e
	},
	w = proc(e: Dialog, width: f32) -> Dialog {
		o := op(e.el, 272)
		put_f32(o, width)
		return e
	},
	width = proc(e: Dialog, width: f32) -> Dialog {
		o := op(e.el, 273)
		put_f32(o, width)
		return e
	},
}

// Dialog_Action is gpui_kit::component::dialog::DialogAction.
