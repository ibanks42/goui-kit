	rounded_b = transmute(proc(e: Dialog, length: Length) -> Dialog)styled_rounded_b,
	rounded_bl = transmute(proc(e: Dialog, length: Length) -> Dialog)styled_rounded_bl,
	rounded_br = transmute(proc(e: Dialog, length: Length) -> Dialog)styled_rounded_br,
