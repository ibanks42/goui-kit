// A titled section of `Command_Item`s.
//
// The heading is hidden while every item in the group is filtered out.
//
// Command_Group is gpui_kit::component::command::CommandGroup.
Command_Group :: struct {
	using nd: Value,
	using vt: ^Command_Group_VT,
}

Command_Group_VT :: struct {
	// Add an item to the group.
	item: proc(e: Command_Group, item: Command_Item) -> Command_Group,
	// Add multiple items to the group.
	items: proc(e: Command_Group, items: []Command_Item) -> Command_Group,
	// Set the label displayed above the group's items.
	label: proc(e: Command_Group, label: string) -> Command_Group,
}

// Create a new group without a label.
command_group :: proc(loc := #caller_location) -> Command_Group {
	e := Command_Group{new_value(627, loc), &command_group_vt}
	return e
}

@(private)
command_group_vt := Command_Group_VT {
	item = proc(e: Command_Group, item: Command_Item) -> Command_Group {
		o := op(vel(e.nd), 256)
		put_u32(o, take_value(item.nd))
		return e
	},
	items = proc(e: Command_Group, items: []Command_Item) -> Command_Group {
		o := op(vel(e.nd), 257)
		put_u32(o, u32(len(items)))
		for x0 in items {
			put_u32(o, take_value(x0.nd))
		}
		return e
	},
	label = proc(e: Command_Group, label: string) -> Command_Group {
		o := op(vel(e.nd), 258)
		put_str(o, label)
		return e
	},
}

// A single command in a `Command` palette.
//
// Command_Item is gpui_kit::component::command::CommandItem.
Command_Item :: struct {
	using nd: Value,
	using vt: ^Command_Item_VT,
}

Command_Item_VT :: struct {
	using t_disableable: ^Disableable_Trait(Command_Item),
	// Set the Action dispatched when this item is clicked or confirmed.
	//
	// The Action's active keybinding is also shown by the default row.
	action: proc(e: Command_Item, action: Action) -> Command_Item,
	// Mark this item as the chosen one, drawing a check at the right end of the row.
	//
	// A resolved Action binding takes that slot, so an item with one shows no check.
	checked: proc(e: Command_Item, checked: bool) -> Command_Item,
	// Replace the row content (icon and label) with a lazily built child.
	//
	// The builder may run more than once for measurement and rendering, so it must be
	// side-effect-free. Custom children own their complete visual presentation, including any
	// keybinding hint.
	child: proc(e: Command_Item, builder: Element) -> Command_Item,
	// Set the leading icon.
	icon: proc(e: Command_Item, icon: Icon_Name) -> Command_Item,
	// Add extra terms the search matches against, besides the label.
	keywords: proc(e: Command_Item, keywords: []string) -> Command_Item,
	// Set the label to display and search.
	label: proc(e: Command_Item, label: string) -> Command_Item,
}

// Create an empty command item.
command_item :: proc(loc := #caller_location) -> Command_Item {
	e := Command_Item{new_value(629, loc), &command_item_vt}
	return e
}

command_item_default :: proc(loc := #caller_location) -> Command_Item {
	e := Command_Item{new_value(628, loc), &command_item_vt}
	return e
}

