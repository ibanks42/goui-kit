# Offscreen session script for the final tutorial app (gates/docs-go.sh, gates/go-apps.sh tutorial).
# Drives the 520x560 shopping-list app through 8 screenshots covering startup, adding, toggling,
# deleting, modal editing, menu open/close, and dark theme switching.
size 520 560
frame
sleep 600
frame
advance 500
shot 01-start.png

# Add a new item ("Eggs") via Ctrl+N and Enter.
key ctrl-n
type Eggs
key enter
sleep 600
frame
advance 500
shot 02-added.png

# Check off the first row and click the delete button on the second row.
click 36 120
advance 300
click 482 153
advance 300
shot 03-bought-deleted.png

# Open the item detail dialog, adjust the quantity, and save changes.
click 250 120
advance 400
shot 04-dialog.png
click 184 157
advance 200
shot 05-amount.png
click 365 201
advance 400
shot 06-saved.png

# Open the menu from the header, dismiss it with Escape, then toggle dark mode via Ctrl+T.
click 448 32
advance 300
shot 07-menu.png
key escape
advance 200
key ctrl-t
advance 400
shot 08-dark.png
