# Offscreen session script for the expenses app (gates/go-apps.sh expenses).
# Compares expenses-go against ref-expenses across 11 shots covering validation errors,
# numeric parsing, select dropdowns, button and Enter submission, and row deletion.
size 860 560
frame
frame
advance 1000
shot 01-start.png

# Click Add with empty inputs to verify required-field validation errors.
click 791 134
advance 300
shot 02-errors.png

# Fill the description field with "Coffee".
click 146 92
type Coffee
advance 300
shot 03-what-typed.png

# Type non-numeric text ("abc") to show amount validation error, then replace with "3.20".
click 430 92
type abc
advance 300
shot 04-amount-bad.png
key ctrl-a
type 3.20
advance 300
shot 05-amount-ok.png

# Open the category select menu and pick an entry.
click 714 92
advance 300
shot 06-select-open.png
click 626 164
advance 300
shot 07-category.png

# Submit the valid expense via the Add button.
click 791 134
advance 500
shot 08-added.png

# Verify a zero amount is rejected on Enter, then replace with "9.90" and submit via Enter.
click 146 92
type Lunch
click 430 92
type 0
key enter
advance 300
shot 09-zero.png
key ctrl-a
type 9.90
key enter
advance 500
shot 10-added-by-enter.png

# Click delete on a saved expense row.
click 526 183
advance 300
shot 11-deleted.png
