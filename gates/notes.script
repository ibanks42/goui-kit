# Offscreen session script for the notes pixel gate (gates/pixels.sh notes, gates/go-apps.sh notes).
# Exercises the 800x600 notes app across 25 screenshots compared byte-for-byte against ref-notes:
# selection, title editing, shortcuts, menus, theme toggles, dialogs, dock dragging, and empty state.
size 800 600
frame
frame
shot 01-start.png

# Click the second note in the sidebar.
click 80 151
frame
shot 02-select.png

# Focus the title input, select all, and rename the note to "Weekend trip".
click 700 143
key ctrl-a
type Weekend trip
frame
shot 03-renamed.png

# Create a note with Ctrl+N.
key ctrl-n
frame
shot 04-ctrl-n.png

# Open the app menu and create another note via the menu item.
click 30 24
frame
shot 05-menu.png
click 60 61
frame
shot 06-menu-new.png

# Switch to dark theme with Ctrl+T, then back to light theme with the toolbar button.
key ctrl-t
frame
shot 07-dark.png
click 742 24
frame
shot 08-light.png

# Select the first note.
click 80 103
frame
shot 09-select-first.png

