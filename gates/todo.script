# Offscreen session script for the first run of the todo app (gates/todo.sh, gates/go-apps.sh todo).
# Captures 14 screenshots at 900x600 and saves state to TODO_FILE, which is reloaded by
# gates/todo-reload.script and asserted by gates/todo-check.py.
size 900 600
frame
frame
shot 01-start.png

# Tick "Buy milk" in Inbox.
click 248 113
frame
shot 02-ticked.png

# Open the new-task dialog (Ctrl+N), fill "Water the plants" due 2026-11-12 with High priority, and submit.
key ctrl-n
frame
type Water the plants
click 450 165
type 2026-11-12
click 456 205
frame
shot 03-dialog.png
click 555 249
frame
shot 04-added.png

# Filter to Active tasks, search for "plumb" (Ctrl+F), then clear search and return to All.
click 292 73
frame
shot 05-active.png
key ctrl-f
type plumb
frame
shot 06-search.png
key ctrl-a
key backspace
click 244 73
frame

# Select "Call the plumber", open delete confirmation with Delete, and confirm with Enter.
click 600 146
frame
key delete
frame
shot 07-delete-dialog.png
key enter
frame
shot 08-deleted.png

# Double-click a row to start inline editing, then cancel with Escape.
dblclick 300 113
frame
shot 09-edit.png
key escape
frame

# Switch to Work to confirm its tasks are untouched.
click 100 127
frame
shot 10-work.png

# Add a fourth project named "Garden" through the sidebar project input.
click 110 576
type Garden
key enter
frame
shot 11-new-project.png

# Toggle dark mode via Ctrl+T (saved to TODO_FILE for the reload run).
key ctrl-t
frame
shot 12-dark.png

# Open the app menu and dismiss it with Escape.
click 30 24
frame
shot 13-menu.png
key escape
frame

# Wait 4500 ms for the background sync goroutine to post its task, then switch back to Inbox.
sleep 4500
frame
click 100 99
frame
shot 14-synced.png
