# Offscreen session script for the files pixel gate (gates/pixels.sh files).
# Drives platform menus, scripted open/save/prompt answers, external URL handling, and picker
# cancellation across 11 screenshots compared byte-for-byte against ref-files.
size 720 480
frame
advance 300
frame
shot 01-start.png

# Open the File menu and choose Open to trigger a platform file-picker request.
click 24 18
frame
shot 02-file-menu.png
click 40 46
frame
shot 03-open-asked.png

# Answer the picker with gates/files.sample.txt (four dirs up from gates/out/pixels/files/<cand>/).
answer paths ../../../../files.sample.txt
shot 04-answered.png

# Capture the content transition mid-animation (+100 ms) and after it settles (+300 ms).
advance 100
frame
shot 05-opened-entering.png
advance 300
frame
shot 06-opened.png

# Open File -> Save As and supply a destination filename in the run directory.
click 17 16
frame
click 40 77
frame
answer new-path saved.txt
advance 400
frame
shot 07-saved.png

# Open File -> Close/Quit prompt and pick button 1 to keep the window open.
click 17 16
frame
click 40 113
frame
answer prompt 1
advance 400
frame
shot 08-still-here.png

# Open the Help menu and click the external website link item.
click 60 16
frame
shot 09-help-menu.png
click 80 49
frame
advance 400
frame
shot 10-website.png

# Trigger Open via Ctrl+O and cancel the platform file picker.
key ctrl-o
frame
answer cancel paths
advance 400
frame
shot 11-open-cancelled.png
