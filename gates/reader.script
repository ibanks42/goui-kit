# Offscreen session script for the reader app (gates/reader.sh, gates/go-apps.sh reader).
# Runs over a 3000-article feed at 1000x660 across 15 screenshots covering load, tooltips,
# article fade transitions, starring, tabs, keyboard nav, scrolling, search, settings, and reload.
size 1000 660
frame
sleep 300
frame
advance 500
shot 01-loaded.png

# Move over the toolbar button and advance 1500 ms to trigger its hover tooltip.
move 24 24
advance 1500
shot 02-tooltip.png

# Click an article row and capture both mid-fade (+60 ms) and settled open (+300 ms) states.
click 150 225
advance 60
shot 03-fading.png
advance 300
shot 04-open.png

# Open a second article and toggle its star button.
click 150 361
advance 300
click 132 24
advance 300
shot 05-starred.png

# Click back to the first open tab, then advance to the next article with Alt+Down.
click 388 65
advance 300
shot 06-first-tab.png
key alt-down
advance 300
shot 07-next.png

# Scroll far down the 3000-item virtual list.
scroll 150 600 -60000
frame
frame
shot 08-scrolled.png

# Filter the feed by typing "bread" in the search input, then clear the query.
click 150 73
type bread
advance 100
shot 09-search.png
key ctrl-a
key backspace
advance 100

# Open the settings modal via Ctrl+, and drag the font-size slider plus toggle a checkbox.
key ctrl-,
advance 300
shot 10-settings.png
drag 396 147 500 147
advance 300
click 311 281
advance 300

# Open the theme select dropdown, pick Dark, then close settings with Escape.
click 550 191
advance 300
shot 11-theme-select.png
click 550 263
advance 300
shot 12-dark.png
key escape
advance 300
shot 13-dark-closed.png

# Close the active tab with Ctrl+W, then reload the feed with Ctrl+R.
key ctrl-w
advance 300
shot 14-tab-closed.png
key ctrl-r
sleep 300
frame
advance 500
shot 15-reloaded.png
